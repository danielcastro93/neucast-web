---
// Buscador del sitio: una capa a pantalla completa, sobre el sitio
// difuminado, que busca mientras se escribe.
//
// Va una sola vez, en Base.astro. Se abre desde cualquier elemento con
// data-bs-abrir (la lupa del encabezado) y también con "/" o Ctrl/Cmd+K en
// escritorio. Cierra con animación, con Escape y con su botón.
//
// El índice (/buscar.json) se pide la primera vez que se abre, no al cargar la
// página: quien no busca no lo descarga. Busca en piezas, categorías y
// proyectos, sin importar acentos ni mayúsculas, y entiende singular y plural
// ("sillas" encuentra "silla").
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { categories } from "../data/site.js";
import { piezas } from "../data/catalogo.js";

// Sugerencias para empezar: el tipo de mueble con más piezas de cada
// categoría, en el orden del menú. Salen del catálogo, así que cambian solas
// cuando cambia el catálogo.
const sugeridas = categories
  .map((c) => {
    const cuenta = new Map();
    piezas.filter((p) => p.cat === c.slug).forEach((p) => cuenta.set(p.tipo, (cuenta.get(p.tipo) || 0) + 1));
    return [...cuenta.entries()].sort((a, b) => b[1] - a[1])[0]?.[0];
  })
  .filter(Boolean)
  .slice(0, 6);
---
<div class="bs" id="buscador" role="dialog" aria-modal="true" aria-label="Buscar en el sitio" data-src="/buscar.json" hidden>
  <div class="container bs-barra">
    <span class="bs-logo" aria-hidden="true"><Logo height={26} /></span>
    <button class="bs-x" type="button" data-bs-cerrar aria-label="Cerrar la búsqueda">
      <Icon name="cerrar" size={18} />
    </button>
  </div>

  <div class="bs-cuerpo" data-bs-cuerpo>
    <div class="container bs-marco">
      <label class="bs-campo-caja">
        <span class="bs-lupa" aria-hidden="true"><Icon name="buscar" size={24} /></span>
        <input
          class="bs-campo"
          type="search"
          placeholder="¿Qué buscas?"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
          aria-label="Buscar una pieza, un material o un color"
          aria-controls="bsResultados"
          data-bs-campo
        />
        <button class="bs-borrar" type="button" data-bs-borrar aria-label="Borrar la búsqueda" hidden>
          <Icon name="cerrar" size={14} />
        </button>
      </label>
      <p class="bs-ayuda">Busca por pieza, tipo de mueble, material o color.</p>

      <div id="bsResultados" class="bs-resultados" data-bs-resultados aria-live="polite" hidden></div>

      <!-- con el campo vacío, y también debajo de "sin resultados" -->
      <div class="bs-inicio" data-bs-inicio>
        <section class="bs-seccion">
          <p class="rotulo bs-rotulo">Prueba con</p>
          <ul class="bs-chips">
            {sugeridas.map((t) => (
              <li><button class="bs-chip" type="button" data-bs-sugerir={t}><Icon name="buscar" size={13} />{t}</button></li>
            ))}
          </ul>
        </section>
        <section class="bs-seccion">
          <p class="rotulo bs-rotulo">Explora por categoría</p>
          <ul class="bs-cats">
            {categories.map((c) => (
              <li>
                <a class="bs-cat" href={`/muebles/${c.slug}/`}>
                  <span class="bs-cat-foto"><img src={c.photo} alt="" loading="lazy" /></span>
                  <span class="bs-cat-nombre">{c.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </div>
</div>

<style>
  .bs[hidden]{display:none !important;}
  /* Pantalla completa, pero el sitio sigue ahí detrás, difuminado */
  .bs{
    position:fixed;inset:0;z-index:63;
    display:flex;flex-direction:column;
    background:rgba(246,245,242,.86);
    -webkit-backdrop-filter:blur(28px) saturate(1.2);backdrop-filter:blur(28px) saturate(1.2);
    animation:bsEntra .32s var(--ease);
  }
  .bs.bs-cerrando{animation:bsSale .24s var(--ease) forwards;}
  .bs-marco{animation:bsSube .42s var(--ease);}
  @keyframes bsEntra{from{opacity:0}to{opacity:1}}
  @keyframes bsSale{to{opacity:0}}
  @keyframes bsSube{from{transform:translateY(14px);opacity:0}to{transform:none;opacity:1}}

  .bs-barra{
    width:100%;flex:none;display:flex;align-items:center;justify-content:space-between;
    height:var(--header-h);
  }
  .bs-logo{display:flex;}
  .bs-x{
    position:relative;flex:none;width:44px;height:44px;margin-right:-4px;
    display:flex;align-items:center;justify-content:center;border-radius:50%;
    background:var(--white);color:var(--ink);box-shadow:0 1px 0 var(--line);
    transition:transform .2s var(--ease),background .2s;
  }
  @media (hover:hover){.bs-x:hover{transform:rotate(90deg);}}

  .bs-cuerpo{flex:1;overflow-y:auto;overscroll-behavior:contain;padding-bottom:64px;}
  .bs-marco{padding-top:clamp(20px,6vh,72px);}

  /* ---------- el campo ---------- */
  .bs-campo-caja{
    display:flex;align-items:center;gap:14px;
    border-bottom:1.5px solid var(--ink);padding-bottom:10px;cursor:text;
  }
  .bs-lupa{display:flex;color:var(--ink);flex:none;}
  /* 16 px como mínimo: con menos, iOS acerca la página al enfocar el campo */
  .bs-campo{
    flex:1;min-width:0;height:clamp(48px,6vw,68px);border:0;background:none;outline:none;padding:0;
    font:inherit;font-size:clamp(26px,3.6vw,44px);font-weight:500;letter-spacing:-.02em;color:var(--ink);
  }
  .bs-campo:focus-visible{outline:none;}
  .bs-campo::placeholder{color:var(--ink-40);}
  .bs-campo::-webkit-search-cancel-button{-webkit-appearance:none;}
  .bs-borrar{
    position:relative;flex:none;width:32px;height:32px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    background:var(--cemento-claro);color:var(--ink);
  }
  .bs-borrar[hidden]{display:none;}
  .bs-borrar::after{content:"";position:absolute;inset:-6px;}
  .bs-ayuda{margin-top:12px;font-size:var(--fs-xs);color:var(--ink-60);}

  /* ---------- inicio ---------- */
  .bs-inicio{margin-top:clamp(36px,6vh,56px);display:flex;flex-direction:column;gap:clamp(36px,5vh,48px);}
  .bs-inicio[hidden]{display:none;}
  .bs-rotulo{color:var(--ink-60);margin-bottom:16px;}
  .bs-chips{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px;}
  .bs-chip{
    display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 18px 0 16px;
    border-radius:999px;background:var(--white);font-size:var(--fs-sm);color:var(--ink);
    box-shadow:0 1px 0 var(--line);transition:background .2s,color .2s;
  }
  .bs-chip :global(svg){color:var(--ink-60);}
  /* en teléfono, una sola fila que se desliza con el dedo */
  @media (max-width:759px){
    .bs-chips{
      flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;
      margin-inline:calc(var(--gutter, 20px) * -1);padding-inline:var(--gutter, 20px);
      scroll-padding-inline:var(--gutter, 20px);
    }
    .bs-chips::-webkit-scrollbar{display:none;}
    .bs-chips li{flex:none;}
    .bs-chip{white-space:nowrap;}
  }
  @media (hover:hover){.bs-chip:hover{background:var(--ink);color:var(--white);}.bs-chip:hover :global(svg){color:inherit;}}

  .bs-cats{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:18px 12px;}
  @media (min-width:760px){.bs-cats{grid-template-columns:repeat(4,1fr);gap:28px 18px;}}
  .bs-cat{display:flex;flex-direction:column;gap:10px;color:var(--ink);}
  .bs-cat-foto{display:block;aspect-ratio:4/3;border-radius:var(--radius-sm);overflow:hidden;background:var(--cemento-suave);}
  .bs-cat-foto img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease);}
  @media (hover:hover){.bs-cat:hover .bs-cat-foto img{transform:scale(1.04);}}
  .bs-cat-nombre{font-size:var(--fs-sm);font-weight:600;line-height:1.25;}

  /* ---------- resultados ---------- */
  .bs-resultados{margin-top:clamp(28px,5vh,44px);}
  .bs-resultados :global(.bs-grupo + .bs-grupo){margin-top:44px;}
  .bs-resultados :global(.bs-cabeza){display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:16px;}
  .bs-resultados :global(.bs-cabeza .bs-rotulo){margin-bottom:0;}
  .bs-resultados :global(.bs-lista){list-style:none;margin:0;padding:0;}

  /* piezas: rejilla de fichas con foto, como el catálogo */
  .bs-resultados :global(.bs-lista--piezas){display:grid;grid-template-columns:repeat(2,1fr);gap:22px 12px;}
  @media (min-width:760px){.bs-resultados :global(.bs-lista--piezas){grid-template-columns:repeat(4,1fr);gap:32px 18px;}}
  @media (min-width:1200px){.bs-resultados :global(.bs-lista--piezas){grid-template-columns:repeat(5,1fr);}}
  .bs-resultados :global(.bs-pieza){display:flex;flex-direction:column;gap:10px;color:var(--ink);outline:none;border-radius:var(--radius-sm);}
  .bs-resultados :global(.bs-pieza .bs-foto){
    display:block;aspect-ratio:1;border-radius:var(--radius-sm);overflow:hidden;background:var(--cemento-suave);
    transition:box-shadow .2s;
  }
  .bs-resultados :global(.bs-pieza .bs-foto img){width:100%;height:100%;object-fit:contain;padding:10%;transition:transform .6s var(--ease);}
  @media (hover:hover){.bs-resultados :global(.bs-pieza:hover .bs-foto img){transform:scale(1.05);}}
  .bs-resultados :global(.bs-pieza:focus-visible .bs-foto),
  .bs-resultados :global(.bs-pieza.bs-activo .bs-foto){box-shadow:0 0 0 2px var(--ink);}

  /* categorías y proyectos: renglones compactos con foto */
  .bs-resultados :global(.bs-lista--filas){display:grid;gap:6px;}
  @media (min-width:760px){.bs-resultados :global(.bs-lista--filas){grid-template-columns:repeat(2,1fr);column-gap:18px;}}
  .bs-resultados :global(.bs-fila){
    display:grid;grid-template-columns:64px 1fr;gap:14px;align-items:center;
    padding:8px;margin-inline:-8px;border-radius:var(--radius-sm);color:var(--ink);outline:none;transition:background .15s;
  }
  .bs-resultados :global(.bs-fila:focus-visible),
  .bs-resultados :global(.bs-fila.bs-activo){background:var(--white);}
  @media (hover:hover){.bs-resultados :global(.bs-fila:hover){background:var(--white);}}
  .bs-resultados :global(.bs-fila .bs-foto){width:64px;height:48px;border-radius:var(--radius-sm);overflow:hidden;background:var(--cemento-suave);}
  .bs-resultados :global(.bs-fila .bs-foto img){width:100%;height:100%;object-fit:cover;}

  .bs-resultados :global(.bs-txt){min-width:0;display:flex;flex-direction:column;gap:3px;}
  .bs-resultados :global(.bs-tipo){font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-60);}
  .bs-resultados :global(.bs-nombre){font-weight:600;line-height:1.25;}
  .bs-resultados :global(.bs-meta){font-size:var(--fs-xs);color:var(--ink-60);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .bs-resultados :global(.bs-nombre mark){background:none;color:inherit;text-decoration:underline;text-decoration-color:var(--olive);text-decoration-thickness:2px;text-underline-offset:3px;}
  .bs-resultados :global(.bs-cuenta){margin-top:24px;font-size:var(--fs-xs);color:var(--ink-60);}
  .bs-resultados :global(.bs-espera){color:var(--ink-60);font-size:var(--fs-sm);}

  /* sin resultados: aire de sobra antes de las sugerencias */
  .bs-resultados :global(.bs-nada){max-width:560px;padding:8px 0 4px;}
  .bs-resultados :global(.bs-nada-ttl){font-size:clamp(20px,2.2vw,26px);font-weight:600;letter-spacing:-.01em;line-height:1.25;color:var(--ink);overflow-wrap:anywhere;}
  .bs-resultados :global(.bs-nada-txt){margin-top:10px;font-size:var(--fs-sm);color:var(--ink-60);}

  @media (prefers-reduced-motion:reduce){
    .bs,.bs.bs-cerrando,.bs-marco{animation:none;}
  }
</style>

<script>
  import { bloquear, soltar } from "../scripts/bloqueo-scroll.js";

  const capa = document.getElementById("buscador");
  const campo = capa.querySelector("[data-bs-campo]");
  const borrar = capa.querySelector("[data-bs-borrar]");
  const cuerpo = capa.querySelector("[data-bs-cuerpo]");
  const inicio = capa.querySelector("[data-bs-inicio]");
  const salida = capa.querySelector("[data-bs-resultados]");
  const quieto = matchMedia("(prefers-reduced-motion: reduce)");

  // En la vista previa el sitio cuelga de una subcarpeta: el prefijo sale de
  // la propia dirección del índice, que el script de la vista previa ajusta.
  const src = capa.dataset.src;
  const base = src.replace(/\/buscar\.json$/, "");

  let indice = null;
  let cargando = null;
  const cargar = () =>
    (cargando ??= fetch(src)
      .then((r) => r.json())
      .then((d) => {
        indice = preparar(d);
        return indice;
      })
      .catch(() => {
        cargando = null;
        return null;
      }));

  // --- normalización: sin acentos, sin mayúsculas ---
  const norm = (s) =>
    (s || "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

  function preparar(d) {
    const prep = (x, tipo) => ({
      ...x,
      tipo,
      _n: norm(x.n),
      _t: norm(x.t),
      _c: norm(x.c),
      _m: norm(x.m),
      _k: norm(x.k),
    });
    return {
      piezas: (d.piezas || []).map((x) => prep(x, "pieza")),
      categorias: (d.categorias || []).map((x) => prep(x, "categoria")),
      proyectos: (d.proyectos || []).map((x) => prep(x, "proyecto")),
    };
  }

  // Singular, plural y género: "sillas" encuentra "silla", "mesas" encuentra
  // "mesa", y "negra", "roja" o "blanca" encuentran los colores "Negro",
  // "Rojo" y "Blanco". Sin lo último, "silla negra" no daba nada.
  const variantes = (t) => {
    const v = new Set([t]);
    if (t.length > 4 && t.endsWith("es")) v.add(t.slice(0, -2));
    if (t.length > 3 && t.endsWith("s")) v.add(t.slice(0, -1));
    for (const x of [...v]) {
      if (x.length > 3 && /[ao]$/.test(x)) v.add(x.slice(0, -1));
    }
    return [...v];
  };

  // Cada palabra tiene que aparecer en algún campo; pesa más si aparece en el
  // nombre, y más aún si el nombre empieza con ella.
  const PESOS = [["_n", 10], ["_t", 5], ["_c", 4], ["_m", 3], ["_k", 3]];
  function puntuar(item, palabras) {
    let total = 0;
    for (const p of palabras) {
      let mejor = 0;
      variantes(p).forEach((v, n) => {
        for (const [campo, peso] of PESOS) {
          const texto = item[campo];
          if (!texto) continue;
          // La palabra tal cual se busca en cualquier parte. Sus variantes
          // recortadas, solo al inicio de una palabra: si no, "mesa" recortada
          // a "mes" encontraba sillas de malla "SmartMesh".
          let i = texto.indexOf(v);
          while (n > 0 && i > 0 && texto[i - 1] !== " ") i = texto.indexOf(v, i + 1);
          if (i === -1) continue;
          const inicioPalabra = i === 0 || texto[i - 1] === " ";
          const valor = peso + (inicioPalabra ? 2 : 0) + (campo === "_n" && i === 0 ? 4 : 0);
          if (valor > mejor) mejor = valor;
        }
      });
      if (!mejor) return 0;
      total += mejor;
    }
    return total;
  }

  const buscarEn = (lista, palabras) =>
    lista
      .map((x) => [x, puntuar(x, palabras)])
      .filter(([, p]) => p > 0)
      .sort((a, b) => b[1] - a[1] || a[0].n.localeCompare(b[0].n, "es"))
      .map(([x]) => x);

  // --- pintado, con nodos y textContent: los textos vendrán del administrador ---
  const el = (tag, clase, texto) => {
    const e = document.createElement(tag);
    if (clase) e.className = clase;
    if (texto != null) e.textContent = texto;
    return e;
  };

  // resalta en el nombre la primera palabra buscada que aparezca
  function nombreResaltado(x, palabras) {
    const span = el("span", "bs-nombre");
    for (const p of palabras) {
      for (const v of variantes(p)) {
        const i = x._n.indexOf(v);
        if (i === -1) continue;
        span.append(x.n.slice(0, i));
        span.append(el("mark", "", x.n.slice(i, i + v.length)));
        span.append(x.n.slice(i + v.length));
        return span;
      }
    }
    span.textContent = x.n;
    return span;
  }

  function item(x, palabras) {
    const a = el("a", "bs-item " + (x.tipo === "pieza" ? "bs-pieza" : "bs-fila"));
    a.href = base + x.u;
    const foto = el("span", "bs-foto");
    if (x.i) {
      const img = el("img");
      img.src = base + x.i;
      img.alt = "";
      img.loading = "lazy";
      foto.append(img);
    }
    const txt = el("span", "bs-txt");
    if (x.tipo === "pieza") txt.append(el("span", "bs-tipo", x.t));
    if (x.tipo === "proyecto") txt.append(el("span", "bs-tipo", "Proyecto"));
    if (x.tipo === "categoria") txt.append(el("span", "bs-tipo", "Categoría"));
    txt.append(nombreResaltado(x, palabras));
    const meta = x.tipo === "pieza" ? x.m : x.tipo === "proyecto" ? x.t : "";
    if (meta) txt.append(el("span", "bs-meta", meta));
    a.append(foto, txt);
    return a;
  }

  const MAX_PIEZAS = 40;
  function grupo(titulo, lista, palabras, clase) {
    const g = el("section", "bs-grupo");
    const cab = el("div", "bs-cabeza");
    cab.append(el("p", "rotulo bs-rotulo", titulo));
    g.append(cab);
    const ul = el("ul", "bs-lista " + clase);
    lista.forEach((x) => {
      const li = el("li");
      li.append(item(x, palabras));
      ul.append(li);
    });
    g.append(ul);
    return g;
  }

  // Desde dos letras: con una sola casi todo coincide y la lista no ayuda.
  const MINIMO = 2;
  let ultima = "";
  function pintar() {
    const q = campo.value.trim();
    borrar.hidden = !campo.value;
    const palabras = norm(q).split(/\s+/).filter(Boolean);
    if (q.length < MINIMO) {
      inicio.hidden = false;
      salida.hidden = true;
      salida.replaceChildren();
      ultima = "";
      return;
    }
    inicio.hidden = true;
    salida.hidden = false;
    if (!indice) {
      salida.replaceChildren(el("p", "bs-espera", "Buscando…"));
      return;
    }
    // una búsqueda nueva empieza arriba
    if (q !== ultima) cuerpo.scrollTop = 0;
    ultima = q;

    const cats = buscarEn(indice.categorias, palabras);
    const pzs = buscarEn(indice.piezas, palabras);
    const prys = buscarEn(indice.proyectos, palabras);

    const hijos = [];
    if (pzs.length) {
      const g = grupo(pzs.length === 1 ? "1 pieza" : `${pzs.length} piezas`, pzs.slice(0, MAX_PIEZAS), palabras, "bs-lista--piezas");
      if (pzs.length > MAX_PIEZAS) g.append(el("p", "bs-cuenta", `Se muestran ${MAX_PIEZAS} de ${pzs.length}. Escribe algo más para afinar.`));
      hijos.push(g);
    }
    if (cats.length) hijos.push(grupo("Categorías", cats.slice(0, 4), palabras, "bs-lista--filas"));
    if (prys.length) hijos.push(grupo("Proyectos", prys.slice(0, 4), palabras, "bs-lista--filas"));

    if (!hijos.length) {
      const nada = el("div", "bs-nada");
      const ttl = el("p", "bs-nada-ttl");
      ttl.append("Sin resultados para ", `“${q}”`);
      nada.append(
        ttl,
        el("p", "bs-nada-txt", "Revisa cómo está escrito o prueba con algo más general, como el tipo de mueble, el material o el color.")
      );
      hijos.push(nada);
      inicio.hidden = false;
    }
    salida.replaceChildren(...hijos);
  }

  campo.addEventListener("input", pintar);
  borrar.addEventListener("click", (e) => {
    e.preventDefault();
    campo.value = "";
    pintar();
    campo.focus();
  });
  // las sugerencias escriben la búsqueda por ti
  capa.addEventListener("click", (e) => {
    const b = e.target.closest("[data-bs-sugerir]");
    if (!b) return;
    campo.value = b.dataset.bsSugerir;
    pintar();
    campo.focus();
  });

  // --- flechas del teclado para recorrer resultados ---
  campo.addEventListener("keydown", (e) => {
    const items = [...salida.querySelectorAll(".bs-item")];
    if (!items.length) return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      items[0].focus();
    }
    if (e.key === "Enter") {
      e.preventDefault();
      items[0].click();
    }
  });
  salida.addEventListener("keydown", (e) => {
    const items = [...salida.querySelectorAll(".bs-item")];
    const i = items.indexOf(document.activeElement);
    if (i === -1) return;
    if (e.key === "ArrowDown" && items[i + 1]) { e.preventDefault(); items[i + 1].focus(); }
    if (e.key === "ArrowUp") { e.preventDefault(); (items[i - 1] || campo).focus(); }
  });

  // --- abrir y cerrar ---
  let abierta = false;
  function abrir() {
    if (abierta) return;
    abierta = true;
    capa.classList.remove("bs-cerrando");
    capa.hidden = false;
    bloquear();
    campo.focus();
    cargar().then(() => pintar());
    pintar();
  }
  function cerrar() {
    if (!abierta) return;
    abierta = false;
    soltar();
    let listo = false;
    const guardar = () => {
      if (listo) return;
      listo = true;
      capa.hidden = true;
      capa.classList.remove("bs-cerrando");
    };
    if (quieto.matches) return guardar();
    capa.classList.add("bs-cerrando");
    const fin = (e) => {
      if (e.target !== capa) return; // la del contenido también burbujea
      capa.removeEventListener("animationend", fin);
      guardar();
    };
    capa.addEventListener("animationend", fin);
    setTimeout(guardar, 360);
  }

  document.addEventListener("click", (e) => {
    if (e.target.closest("[data-bs-abrir]")) {
      e.preventDefault();
      abrir();
    }
  });
  capa.querySelector("[data-bs-cerrar]").addEventListener("click", cerrar);
  addEventListener("keydown", (e) => {
    if (e.key === "Escape" && abierta) return cerrar();
    // atajos de escritorio: "/" y Ctrl/Cmd+K, salvo si ya se está escribiendo
    const escribiendo = /input|textarea|select/i.test(document.activeElement?.tagName || "");
    if (!abierta && ((e.key === "/" && !escribiendo) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k"))) {
      e.preventDefault();
      abrir();
    }
  });
</script>
