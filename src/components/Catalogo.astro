---
// Listado de catálogo. Lo usan /muebles/ y cada /muebles/{categoria}/: cambian
// el título, el texto y el conjunto de piezas; todo lo demás es idéntico.
import Icon from "./Icon.astro";
import PiezaCard from "./PiezaCard.astro";
import { categories, todosLosMuebles } from "../data/site.js";
import { bloquesPara, filtros, gruposColor, materiales } from "../data/catalogo.js";

const {
  titulo,
  intro,
  piezas,
  catActiva = null,
} = Astro.props;

// Cinco filas de cuatro en escritorio: alcanza para los dos bloques
// editoriales sin que el usuario tenga que pedir más para verlos.
const POR_TANDA = 20;

// Los tres tipos de grupo se pintaban con tres bloques de markup casi iguales.
// Aquí quedan en una sola lista: `muestra` marca los que llevan punto de color
// y `cols` cuántas columnas usa su rejilla de opciones.
const grupos = [
  {
    campo: "color",
    nombre: "Color",
    cols: 3,
    muestra: true,
    opciones: gruposColor,
  },
  { campo: "material", nombre: "Material", cols: 2, opciones: materiales },
  ...filtros.map((g) => ({ ...g, cols: 2 })),
];
// qué bloques van y dónde lo decide el catálogo, no cada página: las reglas
// están escritas junto a los datos, en src/data/catalogo.js
const bloquesVisibles = bloquesPara(catActiva, piezas.length);
---
  <!-- ============ CABECERA: texto a la izquierda, categorías a la derecha ============ -->
  <section class="mb-head">
    <div class="container mb-head-grid">
      <div class="mb-head-txt">
        <h1 class="display t-h1 mb-title">{titulo}</h1>
        <p class="mb-intro">{intro}</p>
      </div>

      <div class="mb-cats-wrap">
        <div class="mb-cats rail rail-mask" role="list" aria-label="Categorías">
          <a class:list={["mb-cat", { activa: catActiva === null }]} href="/muebles/" role="listitem">
            <span class="mb-cat-media zoom-frame">
              <img src={todosLosMuebles.photo} alt={todosLosMuebles.alt} loading="lazy" />
            </span>
            <span class="mb-cat-nombre">Todos los muebles</span>
          </a>
          {categories.map((c) => (
            <a class:list={["mb-cat", { activa: catActiva === c.slug }]} href={`/muebles/${c.slug}/`} role="listitem">
              <span class="mb-cat-media zoom-frame">
                <img src={c.photo} alt={c.alt} loading="lazy" />
              </span>
              <span class="mb-cat-nombre">{c.name}</span>
            </a>
          ))}
        </div>
        <button class="mb-cats-flecha mb-cats-flecha--prev" type="button" aria-label="Categorías anteriores">
          <Icon name="chevronLeft" size={16} />
        </button>
        <button class="mb-cats-flecha mb-cats-flecha--next" type="button" aria-label="Más categorías">
          <Icon name="chevron" size={16} />
        </button>
      </div>
    </div>
  </section>

  <!-- ============ BARRA DE FILTROS ============ -->
  <div class="mb-barra">
    <div class="container mb-barra-inner">
      <button class="mb-todos" type="button" id="abrirFiltros" aria-haspopup="dialog">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 4.5h12M2 8h12M2 11.5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="5.5" cy="4.5" r="1.8" fill="currentColor"/>
          <circle cx="10.5" cy="11.5" r="1.8" fill="currentColor"/>
        </svg>
        Todos los filtros
        <span class="mb-todos-n" id="contadorActivos" hidden></span>
      </button>

      <div class="mb-rapidos rail rail-mask" role="group" aria-label="Filtros rápidos">
        <button class="mb-chip" type="button" data-panel-abre="color">Color</button>
        <button class="mb-chip" type="button" data-panel-abre="material">Material</button>
        <button class="mb-chip" type="button" data-panel-abre="uso">Tipo de uso</button>
        <button class="mb-chip" type="button" data-panel-abre="entrega">Disponibilidad</button>
      </div>

      <p class="mb-cuenta" role="status"><span id="cuenta">{piezas.length}</span> piezas</p>
    </div>
  </div>

  <!-- ============ CUADRÍCULA ============ -->
  <section class="mb-cuerpo">
    <div class="container">
      <div class="mb-grid" id="grid" data-tanda={POR_TANDA}>
        {piezas.map((pieza, i) => (
          <>
            <PiezaCard pieza={pieza} />
            {bloquesVisibles.filter((b) => b.tras === i + 1).map((b) => (
              <a class="mb-bloque" href={b.enlace} data-tras={b.tras}>
                <img src={b.img} alt={b.alt} loading="lazy" />
                <span class="mb-bloque-velo" aria-hidden="true"></span>
                <span class="mb-bloque-txt">
                  <span class="serif-eyebrow mb-bloque-ante">{b.antetitulo}</span>
                  <span class="display t-h3 mb-bloque-titulo">{b.titulo}</span>
                  <span class="mb-bloque-cta">{b.cta}<Icon name="arrow" size={14} /></span>
                </span>
              </a>
            ))}
          </>
        ))}
      </div>

      {/* Dos mensajes distintos: no es lo mismo que los filtros dejen fuera
          todo que que todavía no haya nada cargado. El segundo se va a ver
          mientras se llena el catálogo desde el CMS. */}
      <p class="mb-vacio" id="vacio" hidden>
        <span data-vacio-filtros>
          Ninguna pieza coincide con esos filtros.
          <button type="button" class="mb-vacio-btn" id="limpiarVacio">Quitar los filtros</button>
        </span>
        <span data-vacio-total hidden>Todavía no hay piezas en esta sección.</span>
      </p>

      <div class="mb-mas" id="zonaMas">
        <p class="mb-mas-txt">Mostrando <span id="mostradas">0</span> de <span id="totales">0</span> piezas</p>
        <button class="pill pill--primary" type="button" id="cargarMas">Cargar más productos</button>
      </div>
    </div>
  </section>

  <!-- ============ PANEL DE FILTROS ============ -->
  <div class="mb-scrim" id="scrimFiltros" hidden></div>
  <aside class="mb-panel" id="panelFiltros" role="dialog" aria-modal="true" aria-label="Filtros" hidden>
    <header class="mb-panel-head">
      <p class="mb-panel-titulo">
        <svg width="17" height="17" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 4.5h12M2 11.5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="5.5" cy="4.5" r="2" fill="var(--white)" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="10.5" cy="11.5" r="2" fill="var(--white)" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        Filtros
      </p>
      <button class="mb-cerrar" type="button" id="cerrarFiltros" aria-label="Cerrar filtros">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    <div class="mb-panel-cuerpo">
      {grupos.map((g) => (
        <details class="mb-grupo" id={`grupo-${g.campo}`} open={g.campo === "color"}>
          <summary class="mb-grupo-cab">
            {g.nombre}
            <span class="mb-signo" aria-hidden="true"></span>
          </summary>
          <div class="mb-grupo-caja">
            <div class="mb-ops" style={`--cols:${g.cols}`}>
              {g.opciones.map((o) => (
                <label class:list={["mb-op", { "mb-op--color": g.muestra }]}>
                  <input type="checkbox" data-campo={g.campo} value={o.id} />
                  {g.muestra && <span class="mb-op-punto" style={`--c:${o.hex}`}></span>}
                  <span class="mb-op-txt">{o.nombre}</span>
                  <span class="mb-op-n" aria-hidden="true"></span>
                </label>
              ))}
            </div>
          </div>
        </details>
      ))}
    </div>

    <footer class="mb-panel-pie">
      <button class="pill pill--ghost" type="button" id="restablecer">Restablecer</button>
      <button class="pill pill--primary" type="button" id="aplicar">
        <span>Mostrando <span id="cuentaPanel">{piezas.length}</span> piezas</span>
      </button>
    </footer>
  </aside>

  <style>
    /* `hidden` lo pisa cualquier regla de clase con display, así que hay que
       reafirmarlo en los elementos que se ocultan desde el script */
    [hidden]{display:none !important;}

    /* ---------- Cabecera ---------- */
    .mb-head{margin-top:calc(var(--header-h) + clamp(32px,5vw,64px));}
    .mb-head-grid{display:grid;gap:clamp(28px,4vw,48px);align-items:center;}
    @media (min-width:900px){
      .mb-head-grid{grid-template-columns:minmax(0,5fr) minmax(0,7fr);}
    }
    .mb-title{margin-bottom:14px;}
    .mb-intro{color:var(--ink-60);max-width:44ch;}
    /* carrusel de categorías: las flechas solo aparecen con el cursor encima */
    .mb-cats-wrap{position:relative;min-width:0;}
    .mb-cats{--rail-pad:0;gap:clamp(10px,1.4vw,16px);}
    .mb-cat{flex:none;width:clamp(148px,19vw,208px);}
    .mb-cat-media{display:block;aspect-ratio:1/1;border-radius:var(--radius);overflow:hidden;}
    .mb-cat-media img{width:100%;height:100%;object-fit:cover;}
    .mb-cat-nombre{
      display:block;margin-top:10px;
      font-size:var(--fs-sm);font-weight:600;color:var(--ink);
    }
    @media (hover:hover){.mb-cat:hover .mb-cat-nombre{color:var(--olive-deep);}}
    .mb-cat.activa .mb-cat-nombre{color:var(--olive-deep);}
    .mb-cat.activa .mb-cat-media{box-shadow:0 0 0 2px var(--olive);}
    .mb-cats-flecha{
      position:absolute;top:calc(50% - 22px);translate:0 -50%;z-index:2;
      width:38px;height:38px;border-radius:50%;
      display:none;align-items:center;justify-content:center;
      color:var(--ink);background:rgba(255,255,255,.9);
      -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
      border:1px solid var(--line);
      opacity:0;transition:opacity .25s var(--ease),background .2s;
    }
    .mb-cats-flecha--prev{left:-6px;}
    .mb-cats-flecha--next{right:-6px;}
    .mb-cats-flecha[disabled]{opacity:0 !important;pointer-events:none;}
    /* misma regla que las flechas de la card: cursor y pantalla grande */
    @media (hover:hover) and (pointer:fine) and (min-width:900px){
      .mb-cats-flecha{display:flex;}
      .mb-cats-wrap:hover .mb-cats-flecha,
      .mb-cats-flecha:focus-visible{opacity:1;}
    }

    /* ---------- Barra de filtros ---------- */
    .mb-barra{
      margin-top:clamp(32px,5vw,56px);
      position:sticky;top:var(--header-h);z-index:6;
      background:rgba(255,255,255,.88);
      -webkit-backdrop-filter:blur(16px) saturate(1.6);backdrop-filter:blur(16px) saturate(1.6);
      border-bottom:1px solid var(--line);
    }
    /* Más baja que el header (64 px): pegada debajo de él, a la misma altura
       parecían dos barras compitiendo en vez de una principal y una de apoyo. */
    .mb-barra-inner{
      display:flex;align-items:center;gap:10px;
      padding-block:9px;
    }
    .mb-todos{
      flex:none;display:inline-flex;align-items:center;gap:9px;
      height:34px;padding:0 15px;border-radius:999px;
      background:var(--ink);color:var(--white);
      font-size:var(--fs-2xs);font-weight:600;letter-spacing:var(--track-label);
      transition:background .25s var(--ease);
    }
    @media (hover:hover){.mb-todos:hover{background:#000;}}
    .mb-todos-n{
      display:inline-flex;align-items:center;justify-content:center;
      min-width:17px;height:17px;padding:0 5px;border-radius:999px;
      background:var(--olive);font-size:var(--fs-2xs);
    }
    .mb-rapidos{--rail-pad:0;gap:7px;flex:1;min-width:0;}
    .mb-chip{
      flex:none;height:34px;padding:0 14px;border-radius:999px;
      border:1px solid var(--line);background:var(--white);
      font-size:var(--fs-2xs);font-weight:600;color:var(--ink-60);
      white-space:nowrap;
      transition:color .2s,border-color .2s;
    }
    @media (hover:hover){.mb-chip:hover{color:var(--ink);border-color:var(--ink-40);}}
    .mb-chip.activo{color:var(--white);background:var(--ink);border-color:var(--ink);}
    .mb-cuenta{flex:none;font-size:var(--fs-xs);color:var(--ink-60);}

    /* En móvil los chips rápidos no caben sin convertirse en otro carrusel
       horizontal, y ya hay dos en la página. Quien quiere filtrar abre el
       panel completo, que es donde están todos. Queda el botón a la izquierda
       y la cuenta a la derecha. El dedo además pide más alto que el ojo. */
    @media (max-width:699px){
      .mb-rapidos{display:none;}
      .mb-cuenta{margin-left:auto;}
    }
    /* La barra se dibuja compacta para no competir con el encabezado, pero en
       táctil los controles escuchan en 44 px, que es lo que pide un dedo. Va
       por puntero y no por ancho: una tablet de 768 es táctil igual. */
    @media (pointer:coarse),(max-width:899px){
      .mb-todos,.mb-chip{height:44px;}
    }

    /* ---------- Cuadrícula ---------- */
    .mb-cuerpo{margin-top:clamp(26px,4vw,40px);}
    .mb-grid{
      display:grid;gap:clamp(18px,2.4vw,32px);
      grid-template-columns:repeat(2,1fr);
    }
    /* En dos columnas las cards quedan altas y angostas: con el mismo hueco
       arriba que a los lados, una fila se lee pegada a la siguiente. */
    @media (max-width:759px){
      .mb-grid{column-gap:16px;row-gap:38px;}
    }
    @media (min-width:760px){.mb-grid{grid-template-columns:repeat(3,1fr);}}
    @media (min-width:1100px){.mb-grid{grid-template-columns:repeat(4,1fr);}}

    /* el bloque editorial ocupa dos columnas: por eso tiene que llevar a algún lado */
    .mb-bloque{
      position:relative;overflow:hidden;border-radius:var(--radius);
      grid-column:span 2;aspect-ratio:2/1;
      display:block;color:#fff;
    }
    .mb-bloque img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s var(--ease);}
    @media (hover:hover){.mb-bloque:hover img{transform:scale(1.04);}}
    .mb-bloque-velo{
      position:absolute;inset:0;
      background:linear-gradient(to top,rgba(10,9,8,.78),rgba(10,9,8,.28) 62%,rgba(10,9,8,.12));
    }
    .mb-bloque-txt{
      position:absolute;inset:auto 0 0 0;
      padding:clamp(18px,2.4vw,28px);
      display:flex;flex-direction:column;gap:4px;
      text-shadow:0 1px 18px rgba(0,0,0,.35);
    }
    .mb-bloque-ante{font-size:var(--fs-sm);}
    .mb-bloque-cta{
      display:inline-flex;align-items:center;gap:8px;margin-top:8px;
      font-size:var(--fs-xs);font-weight:600;letter-spacing:var(--track-label);
    }
    @media (hover:hover){.mb-bloque:hover .mb-bloque-cta :global(svg){transform:translateX(3px);}}
    .mb-bloque-cta :global(svg){transition:transform .25s var(--ease);}

    .mb-vacio{
      margin-top:clamp(40px,6vw,72px);text-align:center;color:var(--ink-60);
    }
    .mb-vacio-btn{
      display:block;margin:12px auto 0;
      font-weight:600;color:var(--ink);border-bottom:1px solid var(--line);
    }
    @media (hover:hover){.mb-vacio-btn:hover{color:var(--olive-deep);border-color:var(--olive);}}

    .mb-mas{
      margin-top:clamp(36px,5vw,64px);
      display:flex;flex-direction:column;align-items:center;gap:14px;
    }
    .mb-mas-txt{font-size:var(--fs-sm);color:var(--ink-40);}

    /* ---------- Panel de filtros ---------- */
    .mb-scrim{
      position:fixed;inset:0;z-index:60;
      background:rgba(20,19,17,.4);
      -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
      animation:velo .3s var(--ease);
    }
    @keyframes velo{from{opacity:0}to{opacity:1}}
    .mb-panel{
      /* margen propio: --gutter llega a 56 px en pantallas anchas y dentro de
         un panel de 420 se come el contenido */
      --pad:20px;
      position:fixed;top:0;right:0;bottom:0;z-index:61;
      width:min(420px,100%);
      background:var(--white);
      display:flex;flex-direction:column;
      animation:entraPanel .34s var(--ease);
    }
    @keyframes entraPanel{from{transform:translateX(100%)}to{transform:none}}

    .mb-panel-head{
      flex:none;
      display:flex;align-items:center;justify-content:space-between;
      padding:13px var(--pad);border-bottom:1px solid var(--line);
    }
    .mb-panel-titulo{
      display:flex;align-items:center;gap:9px;
      font-size:var(--fs-body-lg);font-weight:700;letter-spacing:-.01em;
    }
    .mb-cerrar{
      position:relative;
      width:32px;height:32px;margin-right:-6px;border-radius:50%;
      display:flex;align-items:center;justify-content:center;
      color:var(--ink);transition:background .2s;
    }
    /* El círculo se queda en 32 px porque es el que se pinta al pasar el ratón;
       la zona de toque crece por detrás hasta los 44. */
    .mb-cerrar::after{content:"";position:absolute;inset:-6px;}
    @media (hover:hover){.mb-cerrar:hover{background:var(--paper);}}

    /* el cuerpo no lleva margen: así la línea entre grupos cruza el panel
       completo y el grupo abierto puede teñirse de lado a lado */
    .mb-panel-cuerpo{flex:1;overflow-y:auto;}

    .mb-grupo{border-bottom:1px solid var(--line);}
    .mb-grupo[open]{background:var(--paper-soft);}
    .mb-grupo-cab{
      display:flex;align-items:center;justify-content:space-between;
      padding:14px var(--pad);cursor:pointer;list-style:none;
      font-size:var(--fs-xs);font-weight:700;color:var(--ink);
      letter-spacing:.01em;
    }
    .mb-grupo-cab::-webkit-details-marker{display:none;}
    .mb-signo{position:relative;flex:none;width:13px;height:13px;}
    .mb-signo::before,.mb-signo::after{
      content:"";position:absolute;inset:50% 0 auto 0;
      height:1.5px;background:var(--ink-40);border-radius:2px;
      transition:transform .3s var(--ease);
    }
    .mb-signo::after{transform:rotate(90deg);}
    .mb-grupo[open] .mb-signo::after{transform:rotate(0);}
    /* el alto lo anima el script; aquí solo se recorta lo que sobra */
    .mb-grupo-caja{overflow:hidden;}
    .mb-ops{
      display:grid;grid-template-columns:repeat(var(--cols),minmax(0,1fr));
      gap:8px;padding:2px var(--pad) 16px;
    }

    /* cada opción es una tarjeta: el recuadro es la superficie de clic, no una
       casilla de 16 px al lado de un texto */
    .mb-op{
      position:relative;display:flex;align-items:center;gap:8px;
      min-height:44px;padding:0 11px;
      border:1px solid var(--line);border-radius:var(--radius-sm);
      background:var(--white);cursor:pointer;
      font-size:var(--fs-xs);color:var(--ink);
      transition:border-color .2s,box-shadow .2s,opacity .2s;
    }
    .mb-op input{position:absolute;opacity:0;width:1px;height:1px;}
    @media (hover:hover){.mb-op:hover{border-color:var(--ink-40);}}
    .mb-op:has(input:checked){
      border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink);
    }
    .mb-op:has(input:focus-visible){outline:2px solid var(--olive);outline-offset:2px;}
    .mb-op:has(input:disabled){opacity:.38;cursor:default;}
    .mb-op-txt{flex:1;min-width:0;}
    .mb-op-n{flex:none;font-size:var(--fs-2xs);color:var(--ink-40);}

    /* El color no se muestra con un punto sino con una muestra que llena la
       tarjeta, como las del muestrario de telas con el que se elige de verdad.
       El nombre y la cuenta van debajo, fuera del color. */
    .mb-op--color{
      display:grid;grid-template-columns:1fr auto;align-items:center;
      gap:0;padding:0;min-height:0;overflow:hidden;
    }
    .mb-op-punto{
      grid-column:1 / -1;width:auto;height:56px;
      background:var(--c);box-shadow:inset 0 0 0 1px rgba(0,0,0,.10);
    }
    .mb-op--color .mb-op-txt{padding:8px 2px 9px 10px;}
    .mb-op--color .mb-op-n{padding:8px 10px 9px 0;}

    .mb-panel-pie{
      flex:none;display:flex;gap:9px;
      padding:13px var(--pad);border-top:1px solid var(--line);
      background:var(--white);
    }
    .mb-panel-pie .pill{flex:1;height:46px;}

    @media (prefers-reduced-motion:reduce){
      .mb-scrim,.mb-panel{animation:none;}
      .mb-bloque img,.mb-signo::before,.mb-signo::after{transition:none;}
    }
  </style>

  <script>
    import { bloquear, soltar } from "../scripts/bloqueo-scroll.js";
    // Viaja en un atributo y no con define:vars, porque ese modo no admite
    // importar y el bloqueo del scroll es compartido con las otras capas.
    const POR_TANDA = Number(document.getElementById("grid").dataset.tanda) || 20;
    // ---------- Carrusel de categorías ----------
    const cats = document.querySelector(".mb-cats");
    if (cats) {
      const cPrev = document.querySelector(".mb-cats-flecha--prev");
      const cNext = document.querySelector(".mb-cats-flecha--next");
      const pintarCats = () => {
        const fin = cats.scrollWidth - cats.clientWidth - 4;
        cPrev.disabled = cats.scrollLeft <= 4;
        cNext.disabled = cats.scrollLeft >= fin;
      };
      const paso = () => cats.clientWidth * 0.8;
      cPrev.addEventListener("click", () => cats.scrollBy({ left: -paso(), behavior: "smooth" }));
      cNext.addEventListener("click", () => cats.scrollBy({ left: paso(), behavior: "smooth" }));
      cats.addEventListener("scroll", pintarCats, { passive: true });
      addEventListener("resize", pintarCats);
      pintarCats();
    }

    // ---------- Acordeón de los grupos de filtro ----------
    // <details> no anima su alto solo: se abre de golpe. Se toma el control del
    // clic para animar la caja entre 0 y su alto real. A diferencia de las
    // preguntas frecuentes, aquí pueden quedar varios grupos abiertos: filtrar
    // es comparar campos entre sí.
    const CURVA = { duration: 340, easing: "cubic-bezier(.22,.61,.36,1)" };
    const quieto = matchMedia("(prefers-reduced-motion: reduce)");

    const abrirGrupo = (g) => {
      const caja = g.querySelector(".mb-grupo-caja");
      g.open = true;
      if (quieto.matches) return;
      caja.getAnimations().forEach((a) => a.cancel());
      caja.animate([{ height: "0px", opacity: 0 }, { height: caja.scrollHeight + "px", opacity: 1 }], CURVA);
    };

    const cerrarGrupo = (g) => {
      const caja = g.querySelector(".mb-grupo-caja");
      if (quieto.matches) { g.open = false; return; }
      caja.getAnimations().forEach((a) => a.cancel());
      const anim = caja.animate(
        [{ height: caja.scrollHeight + "px", opacity: 1 }, { height: "0px", opacity: 0 }],
        CURVA
      );
      // el details sigue abierto mientras dura: si no, el contenido
      // desaparecería antes de encogerse
      anim.onfinish = () => { g.open = false; };
    };

    document.querySelectorAll(".mb-grupo").forEach((g) => {
      g.querySelector("summary").addEventListener("click", (e) => {
        e.preventDefault();
        g.open ? cerrarGrupo(g) : abrirGrupo(g);
      });
    });

    // ---------- Filtros ----------
    const panel = document.getElementById("panelFiltros");
    const scrim = document.getElementById("scrimFiltros");
    const grid = document.getElementById("grid");
    const tarjetas = [...grid.querySelectorAll(".pz")];
    const bloquesEd = [...grid.querySelectorAll(".mb-bloque")];
    const casillas = [...panel.querySelectorAll("input[type=checkbox]")];

    const elCuenta = document.getElementById("cuenta");
    const elCuentaPanel = document.getElementById("cuentaPanel");
    const elMostradas = document.getElementById("mostradas");
    const elTotales = document.getElementById("totales");
    const elActivos = document.getElementById("contadorActivos");
    const zonaMas = document.getElementById("zonaMas");
    const btnMas = document.getElementById("cargarMas");
    const vacio = document.getElementById("vacio");

    let tanda = POR_TANDA;

    const seleccion = () => {
      const s = {};
      casillas.filter((c) => c.checked).forEach((c) => {
        (s[c.dataset.campo] ||= []).push(c.value);
      });
      return s;
    };

    // una pieza pasa si cumple TODOS los campos filtrados, y dentro de cada
    // campo basta con cumplir UNA de las opciones marcadas
    const pasa = (tarjeta, sel) =>
      Object.entries(sel).every(([campo, valores]) => {
        const dato = (tarjeta.dataset[campo] || "").split(" ").filter(Boolean);
        return valores.some((v) => dato.includes(v));
      });

    // Cuántas piezas quedarían si se marcara esta opción, respetando lo que ya
    // está marcado en los OTROS campos. Es lo que evita que alguien elija una
    // combinación que no devuelve nada.
    const contar = (campo, valor, sel) => {
      const otros = { ...sel };
      delete otros[campo];
      return tarjetas.filter(
        (t) => pasa(t, otros) && (t.dataset[campo] || "").split(" ").includes(valor)
      ).length;
    };

    const aplicar = () => {
      const sel = seleccion();
      const nActivos = Object.values(sel).reduce((n, v) => n + v.length, 0);
      const hayFiltro = nActivos > 0;

      const visibles = tarjetas.filter((t) => pasa(t, sel));
      tarjetas.forEach((t) => { t.hidden = !visibles.includes(t); });

      visibles.forEach((t, i) => { t.hidden = i >= tanda; });

      const total = visibles.length;
      const mostradas = Math.min(tanda, total);

      // Con filtros puestos los bloques estorban. Y sin ellos, un bloque
      // colocado tras la pieza 20 no puede aparecer cuando solo hay 12 a la
      // vista: se subiría de fila y caería del lado equivocado.
      bloquesEd.forEach((b) => {
        b.hidden = hayFiltro || Number(b.dataset.tras) > mostradas;
      });
      elCuenta.textContent = total;
      elCuentaPanel.textContent = total;
      elMostradas.textContent = mostradas;
      elTotales.textContent = total;

      elActivos.hidden = !hayFiltro;
      elActivos.textContent = nActivos;

      vacio.hidden = total > 0;
      // si no hay ni una pieza, el problema no son los filtros
      vacio.querySelector("[data-vacio-filtros]").hidden = tarjetas.length === 0;
      vacio.querySelector("[data-vacio-total]").hidden = tarjetas.length > 0;
      zonaMas.hidden = total === 0;
      btnMas.hidden = mostradas >= total;

      // cada opción dice cuántas piezas le quedan, y se apaga si no queda ninguna
      casillas.forEach((c) => {
        const n = contar(c.dataset.campo, c.value, sel);
        c.closest(".mb-op").querySelector(".mb-op-n").textContent = n;
        c.disabled = n === 0 && !c.checked;
      });

      // los chips rápidos se marcan si su grupo tiene algo seleccionado
      document.querySelectorAll(".mb-chip").forEach((chip) => {
        const campo = chip.dataset.panelAbre;
        chip.classList.toggle("activo", (sel[campo] || []).length > 0);
      });
    };

    casillas.forEach((c) =>
      c.addEventListener("change", () => { tanda = POR_TANDA; aplicar(); })
    );

    btnMas.addEventListener("click", () => { tanda += POR_TANDA; aplicar(); });

    const abrir = (campo) => {
      panel.classList.remove("panel-cerrando");
      scrim.classList.remove("velo-cerrando");
      panel.hidden = false;
      scrim.hidden = false;
      bloquear();
      if (campo) {
        // Llegar por un chip es pedir ese campo, no el estado en que quedó el
        // panel la última vez: se abre ese y se cierran los demás. Sin animar,
        // porque el panel está entrando y dos movimientos a la vez marean.
        const g = document.getElementById(`grupo-${campo}`);
        document.querySelectorAll(".mb-grupo").forEach((otro) => {
          otro.open = otro === g;
        });
        if (g) g.scrollIntoView({ block: "nearest" });
      }
      panel.querySelector("#cerrarFiltros").focus();
    };
    // Se oculta al terminar la animación de salida, no al dispararla.
    const cerrar = () => {
      if (panel.hidden) return;
      soltar();
      let listo = false;
      const guardar = () => {
        if (listo) return;
        listo = true;
        panel.hidden = true;
        scrim.hidden = true;
        panel.classList.remove("panel-cerrando");
        scrim.classList.remove("velo-cerrando");
      };
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return guardar();
      panel.classList.add("panel-cerrando");
      scrim.classList.add("velo-cerrando");
      panel.addEventListener("animationend", guardar, { once: true });
      setTimeout(guardar, 400);
    };

    document.getElementById("abrirFiltros").addEventListener("click", () => abrir());
    document.querySelectorAll(".mb-chip").forEach((chip) =>
      chip.addEventListener("click", () => abrir(chip.dataset.panelAbre))
    );
    document.getElementById("cerrarFiltros").addEventListener("click", cerrar);
    document.getElementById("aplicar").addEventListener("click", cerrar);
    scrim.addEventListener("click", cerrar);
    addEventListener("keydown", (e) => { if (e.key === "Escape" && !panel.hidden) cerrar(); });

    const limpiar = () => {
      casillas.forEach((c) => { c.checked = false; });
      tanda = POR_TANDA;
      aplicar();
    };
    document.getElementById("restablecer").addEventListener("click", limpiar);
    document.getElementById("limpiarVacio").addEventListener("click", limpiar);

    aplicar();
  </script>

