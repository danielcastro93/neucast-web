---
// Card de pieza del catálogo.
//
// El carrusel de fotos NO lleva flechas debajo de la imagen: en táctil se pasa
// con el dedo y en escritorio las flechas aparecen sobre la foto, a los lados,
// solo al acercar el cursor. Así la cuadrícula se mantiene limpia.
import { gruposColor, materiales } from "../data/catalogo.js";

// `ancho` convierte la card en pieza de carrusel (el home). Sin él, la card
// es una celda de cuadrícula y la mide el contenedor.
//
// `nivel` es el nivel del encabezado del nombre. En un riel la card cuelga de
// la cabecera de sección, que es un h2, así que ahí va h3. En la cuadrícula del
// catálogo no hay nada entre el h1 y la card, así que va h2: si no, el
// documento salta del 1 al 3 y el esquema de la página queda roto.
const { pieza, ancho = null, nivel = ancho ? 3 : 2 } = Astro.props;
const Titulo = `h${nivel}`;

const ruta = `/muebles/${pieza.cat}/${pieza.slug}/`;

const material = materiales.find((m) => m.id === pieza.material);
const colores = pieza.colores
  .map((id) => gruposColor.find((c) => c.id === id))
  .filter(Boolean);

// atributos planos para que el filtrado del listado lea del DOM sin recalcular
const datos = {
  "data-cat": pieza.cat,
  "data-material": pieza.material,
  "data-color": pieza.colores.join(" "),
  "data-uso": pieza.uso || "",
  "data-respaldo": pieza.respaldo || "",
  "data-plazas": pieza.plazas || "",
  "data-brazos": pieza.brazos || "",
  "data-base": pieza.base || "",
  "data-extras": (pieza.extras || []).join(" "),
  "data-entrega": pieza.entrega,
  "data-nuevo": pieza.nuevo ? "1" : "0",
};
---
<article class:list={["pz", { "pz--rail": ancho }]} style={ancho ? `--pz-w:${ancho}` : undefined} {...datos}>
  <div class="pz-marco">
    {pieza.nuevo && <span class="pz-nuevo">Nuevo</span>}

    <a class="pz-fotos" href={ruta} tabindex="-1" aria-hidden="true">
      {pieza.img.map((src, i) => (
        <img
          src={src}
          alt={i === 0 ? pieza.alt : ""}
          aria-hidden={i > 0 ? "true" : undefined}
          loading="lazy"
          draggable="false"
        />
      ))}
    </a>

    {pieza.img.length > 1 && (
      <>
        <button class="pz-flecha pz-flecha--prev" type="button" aria-label="Foto anterior">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 3 5.5 8 10 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="pz-flecha pz-flecha--next" type="button" aria-label="Foto siguiente">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l4.5 5L6 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <span class="pz-puntos" aria-hidden="true">
          {pieza.img.map((_, i) => <span class:list={["pz-punto", { on: i === 0 }]}></span>)}
        </span>
      </>
    )}
  </div>

  <Titulo class="pz-nombre">
    <a href={ruta}>
      <span class="pz-tipo">{pieza.tipo}</span>
      {pieza.nombre}
    </a>
  </Titulo>

  <p class="pz-material">{material ? material.nombre : ""}</p>

  {colores.length > 0 && (
    <span class="pz-colores" aria-label={`Colores: ${colores.map((c) => c.nombre).join(", ")}`}>
      {colores.map((c) => (
        <span class="pz-color" style={`--c:${c.hex}`} title={c.nombre}></span>
      ))}
    </span>
  )}
</article>

<style>
  .pz{display:flex;flex-direction:column;min-width:0;}
  .pz[hidden]{display:none;}
  .pz--rail{width:var(--pz-w);}

  /* Dentro de un carrusel horizontal, el carrusel de fotos competiría con el
     del riel: el dedo no puede mandar a los dos. En táctil se queda la foto
     principal y el gesto mueve el riel; con cursor fino sí hay flechas.

     Esconder el desbordamiento no basta: la tira sigue siendo desplazable por
     dentro y cualquier cosa que mueva el scroll la deja corrida. En táctil las
     demás fotos no se pintan, así que no hay nada que desplazar. */
  .pz--rail .pz-fotos{overflow-x:hidden;}
  @media (hover:hover) and (pointer:fine){
    .pz--rail .pz-fotos{overflow-x:auto;}
  }
  @media not all and (pointer:fine){
    /* Sin touch-action: declarar pan-y aquí le decía al navegador que en esta
       foto solo valen los gestos verticales, así que el swipe horizontal que
       tenía que mover el riel entero moría sobre la imagen. Como las demás
       fotos no se pintan, aquí dentro no hay nada que desplazar y el gesto
       llega solo al riel. */
    .pz--rail .pz-fotos{scroll-snap-type:none;}
    .pz--rail .pz-fotos img:not(:first-child){display:none;}
    .pz--rail .pz-puntos{display:none;}
  }

  .pz-marco{
    position:relative;overflow:hidden;
    border-radius:var(--radius);background:var(--paper-soft);
    aspect-ratio:1/1;
  }

  /* etiqueta Nuevo, como la de la referencia */
  .pz-nuevo{
    position:absolute;top:12px;left:12px;z-index:3;
    padding:5px 11px;border-radius:999px;
    background:var(--sand);color:var(--ink);
    font-size:var(--fs-2xs);font-weight:700;letter-spacing:.02em;
  }
  /* en la cuadrícula de dos columnas la etiqueta se comía la esquina del mueble */
  @media (max-width:759px){
    .pz-nuevo{top:8px;left:8px;padding:3px 8px;font-size:11px;}
  }

  /* Carrusel y enlace a la vez: mucha gente da clic en la foto esperando que
     sea el botón. Al ser el propio contenedor con scroll, arrastrar sigue
     pasando fotos y las flechas quedan fuera del enlace. Se oculta a los
     lectores de pantalla porque el nombre, aquí abajo, ya lleva al mismo
     lugar y no vale la pena anunciarlo dos veces. */
  .pz-fotos{
    display:flex;height:100%;cursor:pointer;
    overflow-x:auto;scroll-snap-type:x mandatory;
    scrollbar-width:none;-webkit-overflow-scrolling:touch;
  }
  .pz-fotos::-webkit-scrollbar{display:none;}
  .pz-fotos img{
    flex:none;width:100%;height:100%;
    object-fit:contain;scroll-snap-align:center;-webkit-user-drag:none;
    padding:clamp(14px,2vw,26px);
    transition:transform 1.1s var(--ease);
  }
  /* la segunda foto es de ambiente: esa sí llena el marco */
  .pz-fotos img:not(:first-child){object-fit:cover;padding:0;}

  /* flechas: sobre la foto, a los lados, solo con cursor fino y al acercarse */
  .pz-flecha{
    position:absolute;top:50%;translate:0 -50%;z-index:2;
    width:34px;height:34px;border-radius:50%;
    display:none;align-items:center;justify-content:center;
    color:var(--ink);
    background:rgba(255,255,255,.86);
    -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
    border:1px solid var(--line);
    opacity:0;transition:opacity .25s var(--ease),background .2s;
  }
  .pz-flecha--prev{left:10px;}
  .pz-flecha--next{right:10px;}
  @media (hover:hover){.pz-flecha:hover{background:#fff;}}
  .pz-flecha[disabled]{opacity:0 !important;pointer-events:none;}
  /* Las flechas piden cursor y además pantalla grande: en teléfono y tablet
     se pasa con el dedo y ahí solo estorban encima de la foto. */
  @media (hover:hover) and (pointer:fine) and (min-width:900px){
    .pz-flecha{display:flex;}
    .pz-marco:hover .pz-flecha,
    .pz-flecha:focus-visible{opacity:1;}
  }
  @media (hover:hover) and (pointer:fine){
    .pz-marco:hover .pz-fotos img:first-child{transform:scale(1.03);}
  }

  /* puntos: la única señal en táctil de que hay más fotos */
  .pz-puntos{
    position:absolute;bottom:12px;left:50%;translate:-50% 0;z-index:2;
    display:flex;gap:5px;
  }
  .pz-punto{
    width:5px;height:5px;border-radius:50%;
    background:var(--ink-40);opacity:.45;transition:opacity .2s,background .2s;
  }
  .pz-punto.on{background:var(--ink);opacity:1;}
  @media (hover:hover) and (pointer:fine){
    .pz-puntos{opacity:0;transition:opacity .25s var(--ease);}
    .pz-marco:hover .pz-puntos{opacity:1;}
  }

  .pz-nombre{margin:14px 0 0;font-size:var(--fs-body);font-weight:600;}
  .pz-nombre a{display:block;color:var(--ink);transition:color .2s;}
  @media (hover:hover){.pz-nombre a:hover{color:var(--olive-deep);}}
  .pz-tipo{
    display:block;margin-bottom:2px;
    font-size:var(--fs-2xs);font-weight:500;color:var(--ink-40);
    letter-spacing:var(--track-label);text-transform:uppercase;
  }

  .pz-material{margin-top:4px;font-size:var(--fs-sm);color:var(--ink-60);}

  .pz-colores{display:flex;gap:5px;margin-top:9px;}
  .pz-color{
    width:11px;height:11px;border-radius:50%;
    background:var(--c);
    box-shadow:inset 0 0 0 1px rgba(0,0,0,.14);
  }

  @media (prefers-reduced-motion:reduce){
    .pz-fotos img,.pz-flecha,.pz-puntos{transition:none;}
  }
</style>

<script>
  // Vive aquí y no en el listado: la card también se usa en el home, y Astro
  // emite este script una sola vez por más veces que se pinte el componente.
  document.querySelectorAll(".pz-marco").forEach((marco) => {
    const tira = marco.querySelector(".pz-fotos");
    if (!tira) return;

    // La tira es enlace, así que una arrastrada terminaría navegando. Si el
    // dedo recorrió o el carrusel se movió, el clic no cuenta.
    let x0 = 0;
    let scroll0 = 0;
    let arrastro = false;
    tira.addEventListener("pointerdown", (e) => {
      x0 = e.clientX;
      scroll0 = tira.scrollLeft;
      arrastro = false;
    });
    tira.addEventListener("pointermove", (e) => {
      if (e.buttons && Math.abs(e.clientX - x0) > 8) arrastro = true;
    });
    tira.addEventListener("click", (e) => {
      if (arrastro || Math.abs(tira.scrollLeft - scroll0) > 4) e.preventDefault();
    });

    const prev = marco.querySelector(".pz-flecha--prev");
    const next = marco.querySelector(".pz-flecha--next");
    const puntos = [...marco.querySelectorAll(".pz-punto")];
    if (!prev || !next) return;

    const pintar = () => {
      const i = Math.round(tira.scrollLeft / tira.clientWidth);
      puntos.forEach((p, n) => p.classList.toggle("on", n === i));
      prev.disabled = i <= 0;
      next.disabled = i >= puntos.length - 1;
    };
    const ir = (paso) =>
      tira.scrollBy({ left: paso * tira.clientWidth, behavior: "smooth" });

    prev.addEventListener("click", (e) => { e.preventDefault(); ir(-1); });
    next.addEventListener("click", (e) => { e.preventDefault(); ir(1); });
    tira.addEventListener("scroll", pintar, { passive: true });
    pintar();
  });
</script>
