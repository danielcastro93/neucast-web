---
// Video ambiental: sin sonido, en bucle y con control de pausa visible.
// Solo reproduce mientras está en pantalla, para no gastar batería ni datos.
// Si el usuario pidió reducir movimiento, no arranca: se queda en el póster.
const {
  src,
  poster,
  alt = "",
  ratio = "4/5",
  class: className = "",
} = Astro.props;
---
<figure class:list={["vf", className]} style={`--vf-ratio:${ratio}`}>
  <video
    class="vf-video"
    src={src}
    poster={poster}
    muted
    loop
    playsinline
    preload="metadata"
    aria-label={alt}
  ></video>

  <button class="vf-btn" type="button" aria-label="Pausar video" data-state="playing">
    <svg class="vf-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
      <rect x="2.5" y="1.5" width="3" height="11" rx="1" fill="currentColor" />
      <rect x="8.5" y="1.5" width="3" height="11" rx="1" fill="currentColor" />
    </svg>
    <svg class="vf-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M3 1.8v10.4a.6.6 0 0 0 .92.5l8.2-5.2a.6.6 0 0 0 0-1L3.92 1.3A.6.6 0 0 0 3 1.8Z" fill="currentColor" />
    </svg>
  </button>
</figure>

<style>
  .vf{
    position:relative;margin:0;
    border-radius:var(--radius);overflow:hidden;background:var(--ink);
  }
  .vf-video{
    display:block;width:100%;height:100%;
    aspect-ratio:var(--vf-ratio);object-fit:cover;
  }
  .vf-btn{
    position:absolute;right:14px;bottom:14px;
    width:40px;height:40px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    color:#fff;
    background:rgba(20,19,17,.42);
    -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
    border:1px solid rgba(255,255,255,.25);
    transition:background .25s var(--ease),transform .25s var(--ease);
  }
  .vf-btn:hover{background:rgba(20,19,17,.62);}
  .vf-btn:active{transform:scale(.94);}
  /* el icono visible depende del estado */
  .vf-btn[data-state="playing"] .vf-play,
  .vf-btn[data-state="paused"] .vf-pause{display:none;}
</style>

<script>
  document.querySelectorAll(".vf").forEach((fig) => {
    const video = fig.querySelector("video");
    const btn = fig.querySelector(".vf-btn");
    const quieto = matchMedia("(prefers-reduced-motion: reduce)");

    // el usuario manda: si pausa a mano, el observador deja de reanudar
    let manual = false;

    const marcar = (estado) => {
      btn.dataset.state = estado;
      btn.setAttribute("aria-label", estado === "playing" ? "Pausar video" : "Reproducir video");
    };

    if (quieto.matches) {
      manual = true;
      marcar("paused");
    }

    btn.addEventListener("click", () => {
      if (video.paused) {
        manual = false;
        video.play();
        marcar("playing");
      } else {
        manual = true;
        video.pause();
        marcar("paused");
      }
    });

    // reproduce solo mientras se ve
    new IntersectionObserver(
      (entries) => entries.forEach((en) => {
        if (manual) return;
        if (en.isIntersecting) { video.play().then(() => marcar("playing")).catch(() => {}); }
        else { video.pause(); }
      }),
      { threshold: 0.25 }
    ).observe(fig);
  });
</script>
