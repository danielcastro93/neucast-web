---
// Panel de "Mi proyecto" y todo su cableado: la lista, las cantidades, el
// envío y los botones de agregar que haya en la página (tarjetas y ficha).
//
// Va una sola vez, en Base.astro, así que existe en todas las páginas. Se abre
// desde cualquier elemento con data-abre="miProyecto" (el del encabezado).
//
// Un botón de agregar solo necesita esto:
//   <button data-mp-agregar data-slug data-nombre data-tipo data-ruta>
// y estar dentro de algo con data-mp-scope que tenga la foto marcada con
// data-mp-foto. La dirección se toma de un enlace con data-mp-enlace dentro
// del mismo scope, o de la página actual si no lo hay (la ficha).
import PanelLateral from "./PanelLateral.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site.js";
---
<PanelLateral id="miProyecto" titulo="Mi proyecto">
  <div class="mp" data-mp data-dominio={site.domain} data-whatsapp={site.whatsapp}>
    <!-- resumen arriba, con "Vaciar" a la mano pero sin gritar -->
    <div class="mp-resumen" data-mp-resumen hidden>
      <p class="mp-cuenta" data-mp-total></p>
      <div class="mp-vaciar-zona" data-mp-vaciar-zona>
        <button class="mp-vaciar" type="button" data-mp-vaciar>
          <Icon name="basura" size={14} /> Vaciar
        </button>
        <div class="mp-confirma" data-mp-confirma hidden>
          <span>¿Vaciar la lista?</span>
          <button type="button" class="mp-confirma-no" data-mp-vaciar-no>Cancelar</button>
          <button type="button" class="mp-confirma-si" data-mp-vaciar-si>Sí, vaciar</button>
        </div>
      </div>
    </div>

    <ul class="mp-lista" data-mp-lista></ul>

    <div class="mp-vacio" data-mp-vacio>
      <span class="mp-vacio-ico" aria-hidden="true"><Icon name="proyecto" size={22} /></span>
      <p class="mp-vacio-ttl">Tu proyecto está vacío</p>
      <p class="mp-vacio-txt">
        Mientras recorres el catálogo, agrega las piezas que te interesen y ponles
        cantidad. Al final nos mandas la lista completa y te cotizamos todo junto.
      </p>
      <a class="pill pill--primary" href="/muebles/">Explorar el catálogo <Icon name="arrow" size={14} /></a>
    </div>
  </div>

  <!-- anclado al fondo del panel: la lista se desplaza por detrás -->
  <div class="mp-pie" slot="pie" data-mp-pie hidden>
    <!-- nace con el enlace general; el script le pone la lista al pintarse -->
    <a class="pill pill--wa" data-mp-wa href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
      <Icon name="whatsapp" size={16} /> Enviar por WhatsApp
    </a>
    <a class="mp-correo" href="/contacto/?proyecto">Enviar por correo</a>
  </div>
</PanelLateral>

<style>
  .mp{display:flex;flex-direction:column;}

  /* ---------- resumen ---------- */
  .mp-resumen{
    display:flex;align-items:center;justify-content:space-between;gap:12px;
    min-height:36px;margin:-4px 0 6px;
  }
  .mp-resumen[hidden]{display:none;}
  .mp-cuenta{font-size:var(--fs-xs);color:var(--ink-60);white-space:nowrap;}
  .mp-vaciar-zona{display:flex;align-items:center;}
  /* al confirmar, la pregunta ocupa todo el renglón */
  .mp-resumen.mp-confirmando .mp-cuenta{display:none;}
  .mp-resumen.mp-confirmando .mp-vaciar-zona,
  .mp-resumen.mp-confirmando .mp-confirma{flex:1;}
  .mp-confirma span{flex:1;}
  .mp-vaciar{
    display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 12px;
    /* sin relleno, contorno fino, como los controles de la bolsa de Apple */
    border-radius:999px;background:none;box-shadow:inset 0 0 0 1px var(--line);
    font-size:var(--fs-xs);font-weight:600;color:var(--ink);
    position:relative;transition:background .2s;
  }
  .mp-vaciar::after{content:"";position:absolute;inset:-6px -2px;}
  @media (hover:hover){.mp-vaciar:hover{background:var(--paper-soft);}}
  .mp-vaciar[hidden]{display:none;}
  /* confirmación en el mismo lugar: un toque en falso no borra la lista */
  .mp-confirma{
    display:flex;align-items:center;gap:6px;font-size:var(--fs-xs);color:var(--ink-60);
    animation:mpAparece .22s var(--ease);
  }
  .mp-confirma[hidden]{display:none;}
  .mp-confirma span{margin-right:2px;white-space:nowrap;}
  .mp-confirma button{
    position:relative;height:32px;padding:0 12px;border-radius:999px;
    font-size:var(--fs-xs);font-weight:600;white-space:nowrap;
  }
  .mp-confirma button::after{content:"";position:absolute;inset:-6px -2px;}
  .mp-confirma-no{color:var(--ink);}
  @media (hover:hover){.mp-confirma-no:hover{background:var(--paper-soft);}}
  .mp-confirma-si{background:var(--ink);color:var(--white);}
  @keyframes mpAparece{from{opacity:0;transform:translateX(6px)}to{opacity:1;transform:none}}

  /* ---------- renglones ---------- */
  .mp-lista{list-style:none;margin:0;padding:0;}
  .mp-lista :global(.mp-item){
    display:grid;grid-template-columns:56px minmax(0,1fr) auto;gap:14px;align-items:center;
    padding:14px 0;border-bottom:1px solid var(--line);
  }
  .mp-lista :global(.mp-item:last-child){border-bottom:0;}
  .mp-lista :global(.mp-foto){
    display:block;width:56px;height:56px;border-radius:var(--radius-sm);
    background:var(--cemento-suave);overflow:hidden;
  }
  .mp-lista :global(.mp-foto img){width:100%;height:100%;object-fit:contain;padding:5px;}
  .mp-lista :global(.mp-txt){min-width:0;display:flex;flex-direction:column;gap:3px;}
  .mp-lista :global(.mp-tipo){
    font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-60);
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }
  .mp-lista :global(.mp-nombre){
    font-size:var(--fs-sm);font-weight:600;color:var(--ink);line-height:1.25;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  }
  @media (hover:hover){.mp-lista :global(.mp-nombre:hover){text-decoration:underline;text-underline-offset:2px;}}

  /* cantidad a la derecha, como en las apps de pedidos: en 1, el menos se
     vuelve bote y quita la pieza. Las cantidades grandes se escriben. */
  .mp-lista :global(.mp-cant){
    display:inline-flex;align-items:center;height:36px;padding:0 2px;
    border-radius:999px;background:none;box-shadow:inset 0 0 0 1px var(--line);
  }
  .mp-lista :global(.mp-cant button){
    position:relative;width:32px;height:32px;display:flex;align-items:center;justify-content:center;
    color:var(--ink);border-radius:50%;transition:background .15s;
  }
  .mp-lista :global(.mp-cant button::after){content:"";position:absolute;inset:-6px -2px;}
  @media (hover:hover){.mp-lista :global(.mp-cant button:hover){background:var(--paper-soft);}}
  .mp-lista :global(.mp-cant input){
    width:34px;height:32px;border:0;background:none;text-align:center;padding:0;
    font:inherit;font-size:16px;font-weight:600;color:var(--ink);
    -moz-appearance:textfield;appearance:textfield;
  }
  .mp-lista :global(.mp-cant input::-webkit-outer-spin-button),
  .mp-lista :global(.mp-cant input::-webkit-inner-spin-button){-webkit-appearance:none;margin:0;}

  /* ---------- vacío ---------- */
  .mp-vacio{display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding-top:12px;}
  .mp-vacio[hidden]{display:none;}
  .mp-vacio-ico{
    width:52px;height:52px;border-radius:50%;background:var(--cemento-suave);
    display:flex;align-items:center;justify-content:center;color:var(--ink);margin-bottom:6px;
  }
  .mp-vacio-ttl{font-weight:700;font-size:var(--fs-body-lg);}
  .mp-vacio-txt{color:var(--ink-60);font-size:var(--fs-sm);margin-bottom:8px;}

  /* ---------- pie anclado ---------- */
  .mp-pie{
    flex:none;
    padding:14px 20px calc(10px + env(safe-area-inset-bottom));
    background:var(--white);border-top:1px solid var(--line);
    box-shadow:0 -10px 24px rgba(0,0,0,.04);
    display:flex;flex-direction:column;align-items:stretch;gap:4px;
  }
  .mp-pie[hidden]{display:none;}
  .mp-pie .pill{width:100%;justify-content:center;height:50px;}
  .mp-correo{
    align-self:center;display:inline-flex;align-items:center;min-height:44px;padding:0 14px;
    font-size:var(--fs-xs);font-weight:600;color:var(--ink);
    text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--ink-40);
  }
  @media (hover:hover){.mp-correo:hover{text-decoration-color:var(--ink);}}

  @media (prefers-reduced-motion:reduce){.mp-confirma{animation:none;}}
</style>

<script>
  import { leer, agregar, quitar, cantidad, vaciar, mensaje, tiene, EVENTO } from "../scripts/proyecto.js";

  const raiz = document.querySelector("[data-mp]");
  const lista = raiz.querySelector("[data-mp-lista]");
  const vacio = raiz.querySelector("[data-mp-vacio]");
  const pie = document.querySelector("[data-mp-pie]");
  const resumen = raiz.querySelector("[data-mp-resumen]");
  const total = raiz.querySelector("[data-mp-total]");
  const botonVaciar = raiz.querySelector("[data-mp-vaciar]");
  const confirma = raiz.querySelector("[data-mp-confirma]");
  const wa = pie.querySelector("[data-mp-wa]");
  const dominio = raiz.dataset.dominio;
  const telefono = raiz.dataset.whatsapp;

  const icono = (nombre) => {
    const d = {
      menos: '<path d="M3.25 8h9.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>',
      mas: '<path d="M8 3.25v9.5M3.25 8h9.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>',
      basura: '<path d="M2.75 4.25h10.5M6.25 4.25V3c0-.41.34-.75.75-.75h2c.41 0 .75.34.75.75v1.25M4.1 4.25l.62 8.7c.06.85.77 1.5 1.62 1.5h3.32c.85 0 1.56-.65 1.62-1.5l.62-8.7M6.75 6.9v4.85M9.25 6.9v4.85" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"/>',
    }[nombre];
    return `<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">${d}</svg>`;
  };

  // Se arma con nodos y textContent, nunca con HTML de los datos: los nombres
  // vendrán del administrador y no deben poder inyectar marcado.
  const pintarPieza = (p) => {
    const li = document.createElement("li");
    li.className = "mp-item";
    li.dataset.slug = p.slug;

    const foto = document.createElement("a");
    foto.className = "mp-foto";
    foto.href = p.url;
    foto.tabIndex = -1;
    foto.setAttribute("aria-hidden", "true");
    if (p.img) {
      const img = document.createElement("img");
      img.src = p.img;
      img.alt = "";
      img.loading = "lazy";
      foto.append(img);
    }

    const txt = document.createElement("div");
    txt.className = "mp-txt";
    const tipo = document.createElement("span");
    tipo.className = "mp-tipo";
    tipo.textContent = p.tipo;
    const nombre = document.createElement("a");
    nombre.className = "mp-nombre";
    nombre.href = p.url;
    nombre.textContent = p.nombre;

    txt.append(tipo, nombre);

    const n = p.cantidad || 1;
    const cant = document.createElement("div");
    cant.className = "mp-cant";
    // en 1 el botón de la izquierda quita la pieza en vez de restar
    const menos = document.createElement("button");
    menos.type = "button";
    menos.innerHTML = icono(n > 1 ? "menos" : "basura");
    menos.setAttribute("aria-label", n > 1 ? `Una ${p.nombre} menos` : `Quitar ${p.tipo} ${p.nombre} de tu proyecto`);
    menos.dataset.accion = n > 1 ? "menos" : "quitar";
    const campo = document.createElement("input");
    campo.type = "number";
    campo.inputMode = "numeric";
    campo.min = "1";
    campo.max = "999";
    campo.value = String(n);
    campo.setAttribute("aria-label", `Cantidad de ${p.tipo} ${p.nombre}`);
    const mas = document.createElement("button");
    mas.type = "button";
    mas.innerHTML = icono("mas");
    mas.setAttribute("aria-label", `Una ${p.nombre} más`);
    mas.dataset.accion = "mas";
    cant.append(menos, campo, mas);

    li.append(foto, txt, cant);
    return li;
  };

  const pintar = () => {
    const piezas = leer();
    const n = piezas.length;

    // contador del encabezado
    document.querySelectorAll("[data-mp-cuenta]").forEach((c) => {
      c.textContent = String(n);
      c.hidden = n === 0;
      const boton = c.closest("button");
      if (boton) boton.setAttribute("aria-label", n ? `Mi proyecto, ${n} ${n === 1 ? "pieza" : "piezas"}` : "Mi proyecto");
    });

    // botones de agregar de la página
    document.querySelectorAll("[data-mp-agregar]").forEach(pintarBoton);
    document.querySelectorAll("[data-mp-set]").forEach(pintarSet);

    // el panel
    lista.replaceChildren(...piezas.map(pintarPieza));
    vacio.hidden = n > 0;
    pie.hidden = n === 0;
    resumen.hidden = n === 0;
    if (!n) pedirConfirmacion(false);
    if (n) {
      const suma = piezas.reduce((s, p) => s + (p.cantidad || 1), 0);
      total.textContent = `${n} ${n === 1 ? "modelo" : "modelos"} · ${suma} ${suma === 1 ? "pieza" : "piezas"}`;
      wa.href = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje(piezas, dominio))}`;
    }
  };

  // --- cambios desde el panel ---
  lista.addEventListener("click", (e) => {
    const b = e.target.closest("button[data-accion]");
    if (!b) return;
    const li = b.closest(".mp-item");
    const slug = li.dataset.slug;
    const actual = Number(li.querySelector("input").value) || 1;
    if (b.dataset.accion === "quitar") quitar(slug);
    if (b.dataset.accion === "mas") cantidad(slug, actual + 1);
    if (b.dataset.accion === "menos") cantidad(slug, actual - 1);
  });
  // lo escrito se guarda al salir del campo o al dar Enter, no a cada tecla:
  // pintar a cada tecla reemplazaría el campo mientras se escribe
  lista.addEventListener("change", (e) => {
    const campo = e.target.closest("input");
    if (campo) cantidad(campo.closest(".mp-item").dataset.slug, campo.value);
  });
  // vaciar pide confirmación ahí mismo
  function pedirConfirmacion(si) {
    botonVaciar.hidden = si;
    resumen.classList.toggle("mp-confirmando", si);
    confirma.hidden = !si;
    if (si) confirma.querySelector("[data-mp-vaciar-no]").focus();
  }
  botonVaciar.addEventListener("click", () => pedirConfirmacion(true));
  confirma.querySelector("[data-mp-vaciar-no]").addEventListener("click", () => {
    pedirConfirmacion(false);
    botonVaciar.focus();
  });
  confirma.querySelector("[data-mp-vaciar-si]").addEventListener("click", vaciar);

  // --- botones de agregar (tarjetas y ficha) ---
  function datosDe(boton) {
    const scope = boton.closest("[data-mp-scope]") || document;
    const foto = scope.querySelector("[data-mp-foto]") || scope.querySelector("img");
    const enlace = scope.querySelector("[data-mp-enlace]");
    return {
      slug: boton.dataset.slug,
      nombre: boton.dataset.nombre,
      tipo: boton.dataset.tipo,
      ruta: boton.dataset.ruta,
      // dirección y foto tal como las sirve esta página: así funcionan igual en
      // la vista previa, que cuelga de una subcarpeta
      url: enlace ? new URL(enlace.href).pathname : location.pathname,
      img: foto ? new URL(foto.currentSrc || foto.src).pathname : "",
    };
  }

  function pintarBoton(boton) {
    const dentro = tiene(boton.dataset.slug);
    boton.setAttribute("aria-pressed", String(dentro));
    boton.classList.toggle("mp-dentro", dentro);
    const texto = boton.querySelector("[data-mp-texto]");
    const nombre = `${boton.dataset.tipo} ${boton.dataset.nombre}`;
    if (texto) {
      // la ficha: agregado, el botón lleva a la lista en vez de quitar la pieza
      texto.textContent = dentro ? "En tu proyecto" : "Agregar al proyecto";
      boton.setAttribute("aria-label", dentro ? "Ver mi proyecto" : `Agregar ${nombre} a mi proyecto`);
    } else {
      // la tarjeta: el mismo botón agrega y quita
      boton.setAttribute("aria-label", dentro ? `Quitar ${nombre} de mi proyecto` : `Agregar ${nombre} a mi proyecto`);
    }
  }

  // --- sets (home office): un botón agrega varias piezas de una vez ---
  // Cada pieza del set es un enlace con data-mp-set-item dentro del mismo
  // data-mp-set-scope; su foto y su dirección se leen de la página, igual
  // que en las tarjetas, para que funcionen también en la vista previa.
  const piezasDelSet = (boton) =>
    [...(boton.closest("[data-mp-set-scope]")?.querySelectorAll("[data-mp-set-item]") || [])];

  function pintarSet(boton) {
    const items = piezasDelSet(boton);
    const dentro = items.length > 0 && items.every((a) => tiene(a.dataset.slug));
    boton.classList.toggle("mp-dentro", dentro);
    boton.setAttribute("aria-pressed", String(dentro));
    const texto = boton.querySelector("[data-mp-set-texto]");
    if (texto) texto.textContent = dentro ? "Set en tu proyecto" : "Agregar el set a mi proyecto";
  }

  document.addEventListener("click", (e) => {
    const boton = e.target.closest("[data-mp-set]");
    if (!boton) return;
    const items = piezasDelSet(boton);
    const faltan = items.filter((a) => !tiene(a.dataset.slug));
    faltan.forEach((a) => {
      const img = a.querySelector("img");
      agregar({
        slug: a.dataset.slug,
        nombre: a.dataset.nombre,
        tipo: a.dataset.tipo,
        ruta: a.dataset.ruta,
        url: new URL(a.href).pathname,
        img: img ? new URL(img.currentSrc || img.src).pathname : "",
      });
    });
    // se abre la lista: así se ve qué entró y se ajustan las cantidades
    abrirPanel();
  });

  const abrirPanel = () => document.querySelector('[data-abre="miProyecto"]')?.click();

  // delegado: sirve también para las tarjetas que el catálogo pinta después
  document.addEventListener("click", (e) => {
    const boton = e.target.closest("[data-mp-agregar]");
    if (!boton) return;
    e.preventDefault();
    const slug = boton.dataset.slug;
    if (tiene(slug)) {
      if (boton.hasAttribute("data-mp-ficha")) abrirPanel();
      else quitar(slug);
      return;
    }
    agregar(datosDe(boton));
    // el contador del encabezado da un pequeño salto: confirma sin estorbar
    document.querySelectorAll("[data-mp-cuenta]").forEach((c) => {
      c.classList.remove("mp-salto");
      void c.offsetWidth;
      c.classList.add("mp-salto");
    });
  });

  addEventListener(EVENTO, pintar);
  pintar();
</script>
