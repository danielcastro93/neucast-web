---
import Base from "../../layouts/Base.astro";
import Catalogo from "../../components/Catalogo.astro";
import { site, categories } from "../../data/site.js";
import { piezas } from "../../data/catalogo.js";

// Cada categoría tiene su propia URL indexable con su title, su description y
// su H1. Esos textos viajan con la categoría en src/data/site.js, no aquí: son
// administrables y es donde viven las palabras por las que posiciona cada una.

export async function getStaticPaths() {
  const { categories } = await import("../../data/site.js");
  return categories.map((c) => ({ params: { categoria: c.slug }, props: { cat: c } }));
}

const { cat } = Astro.props;
const t = cat; // h1, title, desc e intro viajan con la categoría
const deLaCategoria = piezas.filter((p) => p.cat === cat.slug);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: t.h1,
    url: `${site.domain}/muebles/${cat.slug}`,
    description: t.desc,
    inLanguage: "es-MX",
    isPartOf: { "@id": `${site.domain}/#organizacion` },
  }
];
---
<Base title={t.title} description={t.desc} image={cat.photo} schema={schema}>
  <Catalogo
    titulo={t.h1}
    intro={t.intro}
    piezas={deLaCategoria}
    catActiva={cat.slug}
  />
</Base>
