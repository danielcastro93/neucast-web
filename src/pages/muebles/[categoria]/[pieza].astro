---
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import PanelLateral from "../../../components/PanelLateral.astro";
import VisorGaleria from "../../../components/VisorGaleria.astro";
import CursorAmpliar from "../../../components/CursorAmpliar.astro";
import PiezaCard from "../../../components/PiezaCard.astro";
import VideoFrame from "../../../components/VideoFrame.astro";
import SectionHead from "../../../components/SectionHead.astro";
import { site, waLink, categories } from "../../../data/site.js";
import { piezas, gruposColor, materiales, filtros } from "../../../data/catalogo.js";
import { fichaDe, etiquetasMedida, etiquetasConstruccion } from "../../../data/fichas.js";

export async function getStaticPaths() {
  const { piezas } = await import("../../../data/catalogo.js");
  return piezas.map((pieza) => ({
    params: { categoria: pieza.cat, pieza: pieza.slug },
    props: { pieza },
  }));
}

const { pieza } = Astro.props;
const ficha = fichaDe(pieza.slug);
const categoria = categories.find((c) => c.slug === pieza.cat);

// El nombre legible de cada opción vive en el catálogo, que es el mismo que
// alimenta los filtros: así la ficha y el filtro nunca dicen cosas distintas.
const nombreOpcion = (campo, id) => {
  const grupo = filtros.find((g) => g.campo === campo);
  const op = grupo && grupo.opciones.find((o) => o.id === id);
  return op ? op.nombre : null;
};
const material = materiales.find((m) => m.id === pieza.material);
const colores = pieza.colores.map((id) => gruposColor.find((c) => c.id === id)).filter(Boolean);
const entrega = nombreOpcion("entrega", pieza.entrega);

// Lo que se ve sin abrir nada: cuatro datos que de verdad deciden.
const clave = [
  { etiqueta: "Categoría", valor: categoria.name, enlace: `/muebles/${pieza.cat}/` },
  { etiqueta: "Disponibilidad", valor: entrega },
  { etiqueta: "Material", valor: material ? material.nombre : null },
  { etiqueta: "Base", valor: nombreOpcion("base", pieza.base) },
  { etiqueta: "Respaldo", valor: nombreOpcion("respaldo", pieza.respaldo) },
  { etiqueta: "Plazas", valor: pieza.plazas ? `${pieza.plazas}${pieza.plazas === "4" ? " o más" : ""}` : null },
  { etiqueta: "Descansabrazos", valor: nombreOpcion("brazos", pieza.brazos) },
].filter((d) => d.valor);

const caracteristicas = (pieza.extras || [])
  .map((id) => nombreOpcion("extras", id))
  .filter(Boolean);

const medidas = Object.entries(etiquetasMedida)
  .filter(([k]) => ficha.medidas[k])
  .map(([k, etiqueta]) => ({ etiqueta, valor: ficha.medidas[k] }));

const construccion = Object.entries(etiquetasConstruccion)
  .filter(([k]) => ficha.construccion[k])
  .map(([k, etiqueta]) => ({ etiqueta, valor: ficha.construccion[k] }));

// El croquis toma las tres medidas de caja que existan; una mesa redonda no
// tiene anchura, así que ahí entra el diámetro.
const croquis = {
  ancho: ficha.medidas.largo || ficha.medidas.ancho,
  fondo: ficha.medidas.fondo,
  alto: ficha.medidas.alto,
  diametro: ficha.medidas.diametro,
};
// una mesa redonda dibujada como caja se ve descuidada: lleva su propio croquis
const esRedonda = Boolean(croquis.diametro && !croquis.ancho);

// El párrafo descriptivo se parte en dos: la primera frase se lee en negro y
// el resto en gris, como la entrada de la página de proyectos. Antes la primera
// frase salía además arriba, junto a los botones, y se repetía en la misma
// página; ahora vive solo aquí.
const resumenFrases = ficha.resumen.split(". ");
const relatoFuerte = resumenFrases[0].replace(/\.$/, "") + ".";
const relatoResto = resumenFrases.slice(1).join(". ").trim();

// Los tres recuadros que acompañan a la foto. Son los mismos en todas las
// piezas y se llenan con lo que la ficha ya tiene, así que una pieza a medias
// enseña los que pueda y no deja huecos. No hay texto escrito a mano por pieza.
const apoyos = [
  {
    titulo: "Entrega e instalación",
    texto: entrega
      ? `${entrega} desde la confirmación. Montamos en sitio, nivelamos y nos llevamos el empaque. Envío a todo México.`
      : null,
  },
  {
    titulo: "Materiales",
    texto: construccion.length
      ? construccion.slice(0, 2).map((c) => c.valor).join(". ") + "."
      : null,
  },
  {
    titulo: "Cuidados",
    texto: ficha.cuidados.length ? ficha.cuidados.slice(0, 2).join(". ") + "." : null,
  },
].filter((a) => a.texto);

// Primero las de su categoría y después el resto, hasta llenar el carrusel.
// Con una categoría de tres piezas un listado de cuatro se ve a medias.
// El visor comparte componente con la página de proyecto. La primera foto es
// el recorte del mueble, así que se muestra completa y no cortada a la caja.
const medios = pieza.img.map((src, i) => ({
  img: src,
  alt: i === 0 ? pieza.alt : `${pieza.nombre}, foto ${i + 1}`,
  recorte: i === 0,
}));

const relacionadas = [
  ...piezas.filter((p) => p.cat === pieza.cat && p.slug !== pieza.slug),
  ...piezas.filter((p) => p.cat !== pieza.cat),
].slice(0, 8);
const ambiente = pieza.img[1] || categoria.photo;

// El título llevaba solo el nombre de la pieza y se quedaba en veinte
// caracteres sin una sola palabra por la que alguien busque. La categoría es
// la que carga la consulta real.
const title = `${pieza.tipo} ${pieza.nombre} | ${categoria.name} | Neucast`;

// La descripción salía del resumen, que varía mucho de largo, y en varias
// piezas pasaba de 200 caracteres: Google la corta cerca de 160. El primer
// destacado es corto por construcción y dice algo concreto.
const description = [
  `${pieza.tipo} ${pieza.nombre}.`,
  ficha.destacados[0] ? `${ficha.destacados[0]}.` : "",
  `${entrega}.`,
  "Envío e instalación en todo México.",
]
  .filter(Boolean)
  .join(" ");
const url = `${site.domain}/muebles/${pieza.cat}/${pieza.slug}`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: `${pieza.tipo} ${pieza.nombre}`,
    sku: pieza.slug,
    description: ficha.resumen,
    image: pieza.img.map((i) => new URL(i, site.domain).href),
    category: categoria.name,
    material: material ? material.nombre : undefined,
    color: colores.map((c) => c.nombre).join(", "),
    brand: { "@type": "Brand", name: "Neucast" },
    url,
    additionalProperty: [
      ...clave.map((d) => ({ "@type": "PropertyValue", name: d.etiqueta, value: d.valor })),
      ...medidas.map((d) => ({ "@type": "PropertyValue", name: d.etiqueta, value: d.valor })),
    ],
  }
];

const waPieza = waLink(`Hola, me interesa ${pieza.tipo} ${pieza.nombre} que vi en neucast.com.mx`);

// Cuántos puntos llega a enseñar el carrusel de fotos antes de convertirse en
// una ventana que se corre. Es el mismo número que el carrusel de zonas de los
// proyectos, para que los dos se lean igual. Tiene que coincidir con el valor
// que lee el script de abajo.
const VENTANA_PUNTOS = 5;
---
<Base title={title} description={description} image={pieza.img[0]} schema={schema}>
  <article class="pd">
    <!-- ============ GALERÍA + FICHA ============ -->
    <div class="container pd-top">
      <div class="pd-galeria">
        <div class="pd-fotos" id="pdFotos">
          {pieza.img.map((src, i) => (
            <button
              class:list={["pd-foto", { "pd-foto--recorte": i === 0 }]}
              type="button"
              data-visor={i}
              data-ampliar
              aria-label={`Ampliar foto ${i + 1} de ${pieza.img.length}`}
            >
              <img src={src} alt={i === 0 ? pieza.alt : `${pieza.nombre} en uso`} loading={i === 0 ? "eager" : "lazy"} draggable="false" />
            </button>
          ))}

          <div class="pd-foto pd-foto--video">
            <VideoFrame
              src="/video/editorial-neucast.mp4"
              poster="/video/editorial-neucast-poster.jpg"
              alt={`Recorrido por un espacio con piezas como ${pieza.nombre}`}
              ratio="1/1"
            />
          </div>
        </div>

        <div class="pd-galeria-pie">
          <span class="pd-puntos" aria-hidden="true" style={`--pd-ventana:${VENTANA_PUNTOS}`}>
            {pieza.img.map((_, i) => <span class:list={["pd-punto", { on: i === 0 }]}></span>)}
            <span class="pd-punto"></span>
          </span>

          <button class="pd-ver" type="button" data-visor="0">
            Ver toda la galería
            <span class="pd-ver-n">{pieza.img.length}</span>
          </button>
        </div>

        <CursorAmpliar />
      </div>

      <div class="pd-info">
        <div class="pd-info-sticky">
          <p class="overline pd-tipo">{pieza.tipo}</p>
          <h1 class="display t-h1 pd-nombre">{pieza.nombre}</h1>

          {colores.length > 0 && (
            <div class="pd-acabados">
              <p class="pd-acabados-ttl">
                Acabados disponibles
                <span>{colores.length}</span>
              </p>
              <ul class="pd-muestras">
                {colores.map((c) => (
                  <li class="pd-muestra">
                    <span class="pd-muestra-color" style={`--c:${c.hex}`}></span>
                    <span class="pd-muestra-txt">{c.nombre}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <dl class="pd-clave">
            {clave.map((d) => (
              <div class="pd-clave-fila">
                <dt>{d.etiqueta}</dt>
                <dd>{d.enlace ? <a href={d.enlace}>{d.valor}</a> : d.valor}</dd>
              </div>
            ))}
          </dl>

          <div class="pd-ctas" data-hides-fab>
            <a class="pill pill--wa" href={waPieza} target="_blank" rel="noopener">
              Cotizar por WhatsApp
            </a>
            <a class="pill pill--ghost" href="/contacto/">
              Pedir cotización por correo
            </a>
          </div>

          <ul class="pd-aperturas">
            <li><button type="button" data-abre="panelDetalles">Detalles del producto <Icon name="chevron" size={15} /></button></li>
            <li><button type="button" data-abre="panelMedidas">Dimensiones <Icon name="chevron" size={15} /></button></li>
            <li><button type="button" data-abre="panelMateriales">Materiales y cuidados <Icon name="chevron" size={15} /></button></li>
            <li><button type="button" data-abre="panelDescargas">Descargas <Icon name="chevron" size={15} /></button></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ============ EN CONTEXTO: texto, foto y los tres apoyos ============ -->
    {/* Antes aquí había una lista numerada 01 02 03 y una foto con el texto
        encima. Se leía como relleno: tres frases sueltas sin jerarquía y un pie
        que peleaba con la imagen. Ahora el bloque se lee de corrido, texto,
        foto limpia y tres apoyos que la rematan. */}
    <section class="pd-contexto">
      <div class="container">
        <p class="pd-relato display">
          <span class="pd-relato-a">{relatoFuerte}</span>
          {relatoResto && <span class="pd-relato-b">{relatoResto}</span>}
        </p>

        <figure class="pd-contexto-marco">
          <img src={ambiente} alt={`${pieza.nombre} instalada en un espacio corporativo`} loading="lazy" />
        </figure>
      </div>

      {apoyos.length > 0 && (
        /* En teléfono se pasan con el dedo, como el resto de los carruseles del
           sitio; de 760 para arriba caben los tres de un golpe y el riel se
           convierte en cuadrícula. */
        <div class="pd-apoyos rail rail-mask">
          {apoyos.map((a) => (
            <article class="pd-apoyo">
              {/* rótulo, no encabezado: el esquema de la página lo encabeza
                  el nombre de la pieza y estos son apoyos de un bloque */}
              <p class="pd-apoyo-ttl">{a.titulo}</p>
              <p class="pd-apoyo-txt">{a.texto}</p>
            </article>
          ))}
        </div>
      )}
    </section>

    <!-- ============ RELACIONADAS ============ -->
    {relacionadas.length > 0 && (
      <section class="pd-rel">
        <div class="container">
          <SectionHead title="Piezas que combinan" rail="relRail" />
        </div>
        <!-- sin rail-both: en teléfono el degradado va solo a la derecha -->
        <div class="rail rail-mask" id="relRail">
          {relacionadas.map((p) => <PiezaCard pieza={p} ancho="min(64vw,300px)" />)}
        </div>
      </section>
    )}

  </article>

  <VisorGaleria items={medios} titulo={`${pieza.tipo} <strong>${pieza.nombre}</strong>`} />

  <!-- ============ PANELES ============ -->
  <PanelLateral id="panelDetalles" titulo="Detalles del producto">
    <p class="pl-parrafo">{ficha.resumen}</p>

    <h3 class="pl-sub">Ficha</h3>
    <dl class="pl-datos">
      <div><dt>Categoría</dt><dd>{categoria.name}</dd></div>
      <div><dt>Tipo</dt><dd>{pieza.tipo}</dd></div>
      {clave.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
      {caracteristicas.length > 0 && (
        <div><dt>Características</dt><dd>{caracteristicas.join(", ")}</dd></div>
      )}
      <div><dt>Clave</dt><dd>{pieza.slug.toUpperCase().replace(/-/g, " ")}</dd></div>
    </dl>

    {ficha.mecanismo && (
      <>
        <h3 class="pl-sub">Mecanismo</h3>
        <p class="pl-parrafo">{ficha.mecanismo.nombre}</p>
        <ul class="pl-lista">
          {ficha.mecanismo.ajustes.map((a) => <li>{a}</li>)}
        </ul>
      </>
    )}

    {ficha.destacados.length > 0 && (
      <>
        <h3 class="pl-sub">Funciones principales</h3>
        <ul class="pl-lista">
          {ficha.destacados.map((d) => <li>{d}</li>)}
        </ul>
      </>
    )}
  </PanelLateral>

  <PanelLateral id="panelMedidas" titulo="Dimensiones">
    <figure class="pl-croquis">
      <svg viewBox="0 0 320 210" role="img" aria-label={`Croquis con las medidas generales de ${pieza.nombre}`}>
        {esRedonda ? (
          <g fill="none" stroke="var(--ink)" stroke-width="1.4">
            <ellipse cx="160" cy="70" rx="80" ry="26"/>
            <path d="M80 70 L80 150M240 70 L240 150"/>
            <path d="M80 150 A80 26 0 0 0 240 150"/>
            <g stroke="var(--ink-40)" stroke-width="1">
              <path d="M80 36 L240 36M80 31 L80 41M240 31 L240 41"/>
              <path d="M56 70 L56 150M51 70 L61 70M51 150 L61 150"/>
            </g>
          </g>
        ) : (
          <g fill="none" stroke="var(--ink)" stroke-width="1.4">
            <path d="M60 70 L210 70 L210 170 L60 170 Z"/>
            <path d="M60 70 L105 38 L255 38 L210 70"/>
            <path d="M210 170 L255 138 L255 38"/>
            <g stroke="var(--ink-40)" stroke-width="1">
              {croquis.ancho && <path d="M60 186 L210 186M60 181 L60 191M210 181 L210 191"/>}
              {croquis.alto && <path d="M40 70 L40 170M35 70 L45 70M35 170 L45 170"/>}
              {croquis.fondo && <path d="M221 163 L262 134M217 158 L225 167M258 129 L266 138"/>}
            </g>
          </g>
        )}

        {esRedonda ? (
          <>
            <text x="160" y="27" text-anchor="middle" class="pl-cota">{croquis.diametro}</text>
            <text x="46" y="110" text-anchor="middle" transform="rotate(-90 46 110)" class="pl-cota">{croquis.alto}</text>
          </>
        ) : (
          <>
            {croquis.ancho && <text x="135" y="203" text-anchor="middle" class="pl-cota">{croquis.ancho}</text>}
            {croquis.alto && <text x="30" y="124" text-anchor="middle" transform="rotate(-90 30 124)" class="pl-cota">{croquis.alto}</text>}
            {croquis.fondo && <text x="256" y="163" class="pl-cota">{croquis.fondo}</text>}
          </>
        )}
      </svg>
      <figcaption>Medidas generales. El detalle completo va en la tabla.</figcaption>
    </figure>

    <dl class="pl-datos">
      {medidas.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
    </dl>
    <p class="pl-nota">
      Las medidas son nominales y pueden variar hasta 2 cm por acabado. Si necesitas
      una medida exacta para un espacio justo, <a href="/contacto/">pídela antes de cotizar</a>.
    </p>
  </PanelLateral>

  <PanelLateral id="panelMateriales" titulo="Materiales y cuidados">
    <h3 class="pl-sub">Construcción</h3>
    <dl class="pl-datos">
      {construccion.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
    </dl>

    {colores.length > 0 && (
      <>
        <h3 class="pl-sub">Acabados</h3>
        <ul class="pl-muestras">
          {colores.map((c) => (
            <li>
              <span class="pl-muestra-color" style={`--c:${c.hex}`}></span>
              {c.nombre}
            </li>
          ))}
        </ul>
        <p class="pl-nota">
          El muestrario completo tiene más de cien telas y pieles. Estos son los grupos
          de color disponibles para esta pieza.
        </p>
      </>
    )}

    {ficha.cuidados.length > 0 && (
      <>
        <h3 class="pl-sub">Cuidados</h3>
        <ul class="pl-lista">
          {ficha.cuidados.map((c) => <li>{c}</li>)}
        </ul>
      </>
    )}
  </PanelLateral>

  <PanelLateral id="panelDescargas" titulo="Descargas">
    <p class="pl-parrafo">
      La ficha técnica trae el plano acotado, la tabla completa de medidas y las
      especificaciones de materiales, en una hoja que se puede adjuntar a un
      expediente de compra.
    </p>
    <a class="pl-descarga" href="/fichas/ficha-tecnica-ejemplo.pdf" download>
      <span class="pl-descarga-icono" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M14 3v5h5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M12 11v6m0 0-2.4-2.4M12 17l2.4-2.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="pl-descarga-txt">
        <span class="pl-descarga-ttl">Ficha técnica de {pieza.nombre}</span>
        <span class="pl-descarga-meta">PDF · Plano acotado y especificaciones</span>
      </span>
      <span class="pl-descarga-flecha" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M8 2v9m0 0L4.5 7.5M8 11l3.5-3.5M2.5 13.5h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>
  </PanelLateral>

  <style>
    .pd{padding-top:calc(var(--header-h) + clamp(20px,3vw,32px));}

    /* ---------- galería + ficha ---------- */
    .pd-top{margin-top:clamp(16px,2vw,24px);}
    @media (min-width:900px){
      .pd-top{
        /* La columna de texto es angosta a propósito: lo que se mira son las
           fotos, y una medida corta se lee mejor que una ancha. */
        display:grid;grid-template-columns:minmax(0,1fr) clamp(300px,25vw,380px);
        column-gap:clamp(32px,4vw,72px);
      }
    }

    /* Móvil: carrusel con el dedo. Escritorio: mosaico, con la primera foto a
       todo lo ancho y el resto en pares. El último se estira si quedaría solo. */
    .pd-galeria{position:relative;}
    .pd-fotos{
      display:flex;gap:10px;
      overflow-x:auto;scroll-snap-type:x mandatory;
      scrollbar-width:none;-webkit-overflow-scrolling:touch;
      margin-inline:calc(var(--gutter) * -1);
      padding-inline:var(--gutter);
    }
    /* el desplazamiento horizontal no se encadena hacia fuera, igual que en
       los rieles: así el dedo no se queda enganchado al llegar al final */
    .pd-fotos{overscroll-behavior-x:contain;}
    .pd-fotos::-webkit-scrollbar{display:none;}
    .pd-foto{
      flex:none;width:100%;scroll-snap-align:center;
      margin:0;padding:0;border:0;
      border-radius:var(--radius);overflow:hidden;
      background:var(--paper-soft);aspect-ratio:1/1;
      cursor:zoom-in;
    }
    .pd-foto img{width:100%;height:100%;object-fit:cover;display:block;}
    .pd-foto--recorte img{object-fit:contain;padding:clamp(20px,6vw,48px);}
    .pd-foto--video{cursor:default;background:none;}

    /* En móvil el botón de la galería estorbaba encima de la foto. Comparte
       renglón con los puntos: no tapa nada y no cuesta alto. */
    .pd-galeria-pie{
      display:flex;align-items:center;justify-content:space-between;gap:16px;
      margin-top:12px;min-height:38px;
    }
    .pd-puntos{display:flex;gap:6px;}
    .pd-punto{
      width:6px;height:6px;border-radius:50%;
      background:var(--ink-40);opacity:.4;
      transition:opacity .2s,background .2s,transform .25s var(--ease);
    }
    .pd-punto.on{background:var(--ink);opacity:1;}
    /* El punto del borde se encoge en vez de desaparecer: así se ve que la
       fila sigue más allá, y conserva su ranura para que la hilera mida
       siempre lo mismo y el botón de la galería no baile. */
    .pd-punto--mini{transform:scale(.55);opacity:.25;}

    /* El botón de la galería vive sobre la primera foto, no debajo: ahí es
       donde el ojo ya está y no roba un renglón a la composición. */
    .pd-ver{
      position:absolute;z-index:2;
      display:inline-flex;align-items:center;gap:8px;
      height:38px;padding:0 8px 0 15px;border-radius:999px;
      background:rgba(255,255,255,.88);
      -webkit-backdrop-filter:blur(10px) saturate(1.4);
      backdrop-filter:blur(10px) saturate(1.4);
      border:1px solid rgba(255,255,255,.6);
      box-shadow:0 6px 18px rgba(20,19,17,.12);
      font-size:var(--fs-2xs);font-weight:600;color:var(--ink);
      transition:background .2s,box-shadow .2s;
    }
    @media (hover:hover){.pd-ver:hover{background:#fff;box-shadow:0 10px 26px rgba(20,19,17,.18);}}
    .pd-ver-n{
      display:inline-flex;align-items:center;justify-content:center;
      min-width:22px;height:22px;padding:0 6px;border-radius:999px;
      background:var(--ink);color:var(--white);font-size:11px;
    }

    @media (min-width:900px){
      /* Mosaico de seis columnas con renglón de alto fijo: así cualquier pareja
         queda pareja sin depender de la proporción de cada foto. La primera
         manda, y de ahí van en pares, una angosta con una ancha y luego dos
         iguales. Si la última quedaría sola, se estira. */
      .pd-fotos{
        display:grid;grid-template-columns:repeat(6,1fr);
        grid-auto-rows:clamp(150px,13vw,200px);gap:12px;
        overflow:visible;margin-inline:0;padding-inline:0;
      }
      .pd-foto{width:auto;height:auto;aspect-ratio:auto;grid-row:span 2;}
      .pd-foto:first-child{grid-column:span 6;grid-row:span 3;}
      .pd-foto:nth-child(4n+2){grid-column:span 2;}
      .pd-foto:nth-child(4n+3){grid-column:span 4;}
      .pd-foto:nth-child(4n+4){grid-column:span 3;}
      .pd-foto:nth-child(4n+5){grid-column:span 3;}
      .pd-foto:last-child:nth-child(4n+2),
      .pd-foto:last-child:nth-child(4n+4){grid-column:span 6;grid-row:span 2;}
      .pd-puntos{display:none;}
      .pd-ver{position:absolute;right:14px;bottom:14px;}
      /* el video llena su casilla como una foto más */
      .pd-foto--video :global(.vf){height:100%;}
      .pd-foto--video :global(.vf-video){height:100%;aspect-ratio:auto;}
    }
    @media (max-width:899px){
      .pd-ver{
        position:static;height:44px;padding:0 6px 0 13px;
        background:var(--white);border-color:var(--line);box-shadow:none;
      }
      @media (hover:hover){.pd-ver:hover{background:var(--paper-soft);box-shadow:none;}}
      .pd-ver-n{min-width:20px;height:20px;}
    }
    @media (min-width:900px){
      .pd-galeria-pie{display:contents;}
    }

    /* ---------- la ficha ---------- */
    .pd-info{margin-top:28px;}
    @media (min-width:900px){
      .pd-info{margin-top:0;}
      /* --pd-tope lo calcula el script: si la ficha es más alta que la pantalla,
         se queda negativo para que suba hasta enseñar su último renglón antes
         de fijarse. Si no, nadie alcanzaría los botones de abajo. */
      .pd-info-sticky{position:sticky;top:var(--pd-tope, calc(var(--header-h) + 24px));}
    }

    .pd-tipo{margin-bottom:8px;}
    .pd-nombre{margin-bottom:14px;}
    /* ---------- acabados ---------- */
    .pd-acabados{margin-top:26px;}
    .pd-acabados-ttl{
      display:flex;align-items:center;gap:7px;
      font-size:var(--fs-xs);font-weight:700;letter-spacing:.01em;
    }
    .pd-acabados-ttl span{
      display:inline-flex;align-items:center;justify-content:center;
      min-width:19px;height:19px;padding:0 5px;border-radius:999px;
      background:var(--paper);color:var(--ink-60);
      font-size:var(--fs-2xs);font-weight:600;
    }
    .pd-muestras{display:flex;flex-wrap:wrap;gap:8px;margin-top:11px;list-style:none;padding:0;margin-left:0;}
    .pd-muestra{
      display:flex;align-items:center;gap:8px;
      padding:5px 11px 5px 6px;border-radius:999px;
      border:1px solid var(--line);
      font-size:var(--fs-2xs);color:var(--ink-60);
    }
    .pd-muestra-color{
      width:18px;height:18px;border-radius:50%;
      background:var(--c);box-shadow:inset 0 0 0 1px rgba(0,0,0,.14);
    }

    /* ---------- datos clave ---------- */
    .pd-clave{margin-top:26px;border-top:1px solid var(--line);}
    .pd-clave-fila{
      display:flex;align-items:baseline;justify-content:space-between;gap:16px;
      padding:11px 0;border-bottom:1px solid var(--line);
    }
    .pd-clave-fila dt{font-size:var(--fs-xs);color:var(--ink-60);}
    .pd-clave-fila dd{font-size:var(--fs-sm);font-weight:600;text-align:right;}
    /* Zona de toque de 44 px en teléfono sin mover el texto de sitio: no es un
       enlace dentro de un párrafo, es un dato de la tabla y se toca solo. */
    .pd-clave-fila dd a{
      display:inline-flex;align-items:center;min-height:44px;
      color:var(--olive-deep);text-decoration:underline;
      text-underline-offset:3px;text-decoration-thickness:1px;
      transition:color .2s;
    }
    @media (pointer:fine) and (min-width:900px){.pd-clave-fila dd a{min-height:0;}}
    @media (hover:hover){.pd-clave-fila dd a:hover{color:var(--ink);}}

    /* ---------- acciones ---------- */
    .pd-ctas{display:flex;flex-direction:column;gap:9px;margin-top:22px;}
    .pd-ctas .pill{width:100%;}

    .pd-aperturas{margin-top:26px;padding:0;border-top:1px solid var(--line);list-style:none;}
    .pd-aperturas li{border-bottom:1px solid var(--line);}
    .pd-aperturas button{
      width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;
      padding:15px 0;text-align:left;
      font-size:var(--fs-sm);font-weight:600;color:var(--ink);
      transition:color .2s;
    }
    .pd-aperturas button :global(svg){
      color:var(--ink-40);transition:transform .25s var(--ease),color .2s;
    }
    @media (hover:hover){.pd-aperturas button:hover{color:var(--olive-deep);}}    
    @media (hover:hover){.pd-aperturas button:hover :global(svg){transform:translateX(3px);color:var(--olive-deep);}}

    /* ---------- en contexto ---------- */
    .pd-contexto{margin-top:var(--section-y);}

    /* Misma voz que la entrada de proyectos: la frase que define la pieza en
       negro y lo que la matiza en gris, en el mismo párrafo. */
    .pd-relato{
      margin:0 0 clamp(28px,4vw,48px);
      font-size:var(--fs-h4);letter-spacing:-.005em;text-wrap:pretty;
    }
    .pd-relato span{display:block;}
    .pd-relato-b{color:var(--ink-40);margin-top:.5em;}
    @media (min-width:760px){.pd-relato{max-width:78ch;}}

    /* La foto va limpia: el pie que llevaba encima competía con ella y lo que
       decía se cuenta mejor en los apoyos de abajo. */
    .pd-contexto-marco{margin:0;}
    .pd-contexto-marco img{
      display:block;width:100%;aspect-ratio:4/3;object-fit:cover;
      border-radius:var(--radius);background:var(--paper);
    }

    /* ---------- los tres apoyos ---------- */
    .pd-apoyos{margin-top:clamp(16px,2vw,24px);align-items:stretch;}
    .pd-apoyo{
      flex:none;width:min(76vw,340px);
      display:flex;flex-direction:column;gap:7px;
      padding:clamp(20px,2.4vw,26px);
      /* el mismo arena del bloque de apoyo del menú, no el arena fuerte
                 de las etiquetas: es un fondo, no un acento */
      border-radius:var(--radius);background:var(--paper);
    }
    .pd-apoyo-ttl{
      margin:0;font-family:var(--serif);font-size:var(--fs-body-lg);
      letter-spacing:-.01em;color:var(--ink);
    }
    .pd-apoyo-txt{margin:0;color:var(--ink-60);text-wrap:pretty;}
    /* De aquí para arriba caben los tres, así que el riel deja de serlo: sin
       desplazamiento y sin degradado. El relleno del riel se queda, porque es
       justo el que alinea la fila con el margen de la página; anularlo pegaba
       el primer recuadro a la orilla de la pantalla. */
    @media (min-width:760px){
      .pd-apoyos{
        display:grid;grid-template-columns:repeat(3,1fr);
        gap:clamp(14px,1.6vw,20px);
        overflow:visible;mask-image:none;-webkit-mask-image:none;
      }
      .pd-apoyo{width:auto;}
    }
    /* En pantalla ancha la foto se recuesta: a 4/3 se comía la página entera. */
    @media (min-width:760px){
      .pd-contexto-marco{overflow:hidden;border-radius:var(--radius);}
      .pd-contexto-marco img{aspect-ratio:16/9;border-radius:0;}
    }

    /* ---------- relacionadas ---------- */
    /* El riel se cierra en las piezas y ya: el enlace a la categoría de abajo
       mandaba fuera justo donde se está comparando. Para volver al listado
       están el menú y la ruta de migas. */
    .pd-rel{margin-top:var(--section-y);margin-bottom:var(--section-y);}

    /* ---------- contenido de los paneles ---------- */
    .pl-parrafo{font-size:var(--fs-sm);color:var(--ink-60);}
    .pl-sub{
      margin:26px 0 10px;font-size:var(--fs-xs);font-weight:700;
      letter-spacing:var(--track-label);text-transform:uppercase;color:var(--ink);
    }
    .pl-sub:first-child{margin-top:0;}
    .pl-datos{border-top:1px solid var(--line);}
    .pl-datos > div{
      display:flex;align-items:baseline;justify-content:space-between;gap:18px;
      padding:10px 0;border-bottom:1px solid var(--line);
    }
    .pl-datos dt{flex:none;font-size:var(--fs-xs);color:var(--ink-60);}
    .pl-datos dd{font-size:var(--fs-sm);text-align:right;}
    .pl-lista{display:flex;flex-direction:column;gap:8px;list-style:none;padding:0;}
    .pl-lista li{
      position:relative;padding-left:16px;
      font-size:var(--fs-sm);color:var(--ink-60);
    }
    .pl-lista li::before{
      content:"";position:absolute;left:0;top:9px;
      width:5px;height:5px;border-radius:50%;background:var(--olive);
    }
    .pl-nota{
      margin-top:14px;font-size:var(--fs-2xs);color:var(--ink-40);line-height:1.6;
    }
    .pl-nota a{color:var(--olive-deep);text-decoration:underline;text-underline-offset:2px;}
    /* El renglón mide 14 px. El relleno vertical de una caja en línea no
       empuja la línea, pero sí agranda la zona de toque hasta los 44. */
    @media (pointer:coarse),(max-width:899px){
      .pl-nota a{padding-block:15px;}
    }

    .pl-muestras{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;}
    .pl-muestras li{
      display:flex;align-items:center;gap:8px;
      padding:5px 11px 5px 6px;border-radius:999px;border:1px solid var(--line);
      font-size:var(--fs-2xs);color:var(--ink-60);
    }
    .pl-muestra-color{
      width:18px;height:18px;border-radius:50%;
      background:var(--c);box-shadow:inset 0 0 0 1px rgba(0,0,0,.14);
    }

    .pl-croquis{margin:0 0 24px;}
    .pl-croquis svg{
      width:100%;height:auto;display:block;
      background:var(--paper-soft);border-radius:var(--radius-sm);
      padding:8px;
    }
    .pl-cota{
      font-family:var(--sans);font-size:11px;fill:var(--ink-60);
    }
    .pl-croquis figcaption{
      margin-top:9px;font-size:var(--fs-2xs);color:var(--ink-40);
    }

    .pl-descarga{
      display:flex;align-items:center;gap:13px;
      margin-top:16px;padding:14px;border-radius:var(--radius-sm);
      border:1px solid var(--line);background:var(--paper-soft);
      color:var(--ink);transition:border-color .2s,background .2s;
    }
    @media (hover:hover){.pl-descarga:hover{border-color:var(--ink);background:var(--paper);}}
    .pl-descarga-icono{
      flex:none;display:flex;align-items:center;justify-content:center;
      width:44px;height:44px;border-radius:10px;
      background:var(--white);border:1px solid var(--line);
      color:var(--olive-deep);
    }
    .pl-descarga-txt{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px;}
    .pl-descarga-ttl{font-size:var(--fs-sm);font-weight:600;}
    .pl-descarga-meta{font-size:var(--fs-2xs);color:var(--ink-60);}
    .pl-descarga-flecha{
      flex:none;display:flex;align-items:center;justify-content:center;
      width:32px;height:32px;border-radius:50%;
      background:var(--ink);color:var(--white);
      transition:transform .25s var(--ease);
    }
    @media (hover:hover){.pl-descarga:hover .pl-descarga-flecha{transform:translateY(2px);}}
  </style>

  <script>
    // ---------- puntos del carrusel de móvil ----------
    // Misma regla que el carrusel de zonas de los proyectos: una pieza con
    // veinte fotos no pinta veinte puntos. Se enseñan cinco, la ventana se
    // corre para dejar el activo al centro y se frena en los extremos, de modo
    // que en la primera foto el activo va a la izquierda y en la última a la
    // derecha. El punto del borde que todavía tiene fotos más allá se encoge.
    //
    // De 900 px para arriba la galería es un mosaico y no hay puntos, así que
    // esto solo se ve en teléfono y tableta.
    const tira = document.getElementById("pdFotos");
    const hilera = document.querySelector(".pd-puntos");
    const puntos = [...document.querySelectorAll(".pd-punto")];
    if (tira && hilera && puntos.length) {
      const total = puntos.length;
      // tiene que coincidir con VENTANA_PUNTOS del bloque de arriba
      const VENTANA = Number(getComputedStyle(hilera).getPropertyValue("--pd-ventana")) || 5;
      const fotos = [...tira.querySelectorAll(".pd-foto")];

      // Cuál está puesta es la foto cuyo borde queda más cerca del borde del
      // carrusel. Dividir el scroll entre el ancho del carrusel no sirve: la
      // foto mide menos que él, porque se asoma la siguiente, así que la
      // cuenta se va desfasando y a partir de la séptima señala otra.
      const dondeVa = () => {
        const x = tira.getBoundingClientRect().left;
        let cual = 0;
        let cerca = Infinity;
        fotos.forEach((f, n) => {
          const d = Math.abs(f.getBoundingClientRect().left - x);
          if (d < cerca) {
            cerca = d;
            cual = n;
          }
        });
        return cual;
      };

      const pintar = () => {
        const i = Math.max(0, Math.min(dondeVa(), total - 1));
        puntos.forEach((p, n) => p.classList.toggle("on", n === i));

        if (total > VENTANA) {
          const inicio = Math.max(0, Math.min(i - Math.floor(VENTANA / 2), total - VENTANA));
          const fin = inicio + VENTANA - 1;
          puntos.forEach((p, n) => {
            p.hidden = n < inicio || n > fin;
            const borde = (n === inicio && inicio > 0) || (n === fin && fin < total - 1);
            p.classList.toggle("pd-punto--mini", borde && n !== i);
          });
        }
      };

      tira.addEventListener("scroll", pintar, { passive: true });
      pintar();
    }

    // ---------- la ficha fija alcanza su último renglón ----------
    // Una columna más alta que la pantalla deja sus botones fuera de alcance:
    // se quedan pegados abajo y solo aparecen al terminar la galería. Con un
    // tope negativo la columna sube hasta enseñar su final y ahí se fija.
    const ficha = document.querySelector(".pd-info-sticky");
    if (ficha) {
      const acomodar = () => {
        const alto = parseInt(
          getComputedStyle(document.documentElement).getPropertyValue("--header-h")
        ) || 64;
        const tope = alto + 24;
        const sobra = ficha.offsetHeight + tope + 24 - innerHeight;
        ficha.style.setProperty("--pd-tope", (sobra > 0 ? tope - sobra : tope) + "px");
      };
      acomodar();
      addEventListener("resize", acomodar);
      if (document.fonts) document.fonts.ready.then(acomodar);
    }

  </script>
