---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import { site } from "../../data/site.js";
import { proyectos } from "../../data/proyectos.js";

const title = "Proyectos de mobiliario corporativo instalados | Neucast";
const description =
  "Oficinas, cafeterías, recepciones y salas de consejo que amueblamos completas en México. Mira qué se pidió, cómo se resolvió y qué piezas se instalaron.";

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Proyectos",
  url: `${site.domain}/proyectos`,
  description,
  inLanguage: "es-MX",
  isPartOf: { "@id": `${site.domain}/#organizacion` },
};
---
<Base title={title} description={description} image={proyectos[0]?.portada.img} schema={schema}>
  <PageHero
    image="/img/proyectos-hero.jpg"
    alt="Sala de espera corporativa con sofá, sillones y mesa de centro instalados por Neucast"
    eyebrow="Proyectos"
    titulo={["Espacios corporativos", "que ya amueblamos"]}
    size="h1"
  />

  <article class="py">
    <div class="container">
      <p class="py-intro display">
        <span class="py-intro-a">Oficinas, cafeterías, recepciones y salas de juntas amuebladas en todo México.</span>
        <span class="py-intro-b">Aquí está lo que pidió cada cliente, cómo se resolvió y qué piezas quedaron puestas.</span>
      </p>
    </div>

    <!-- ============ CUADRÍCULA ============ -->
    <div class="container">
      {/* Sin proyectos cargados la página existe igual, con su H1 y su aviso.
          Es el estado en el que arranca la migración. */}
      {proyectos.length === 0 && (
        <p class="py-vacio">Todavía no hay proyectos publicados.</p>
      )}
      <div class="py-grid">
        {proyectos.map((p, i) => (
          <a class="py-card" href={`/proyectos/${p.slug}/`}>
            <span class="py-card-marco">
              <img src={p.portada.img} alt={p.portada.alt} loading={i === 0 ? "eager" : "lazy"} />
            </span>
            <span class="py-card-txt">
              <span class="py-card-meta">
                {p.espacio} <span aria-hidden="true">·</span> {p.ciudad}
              </span>
              <span class="display t-h4 py-card-nombre">{p.nombre}</span>
              <span class="py-card-resumen">{p.resumen}</span>
              <span class="py-card-cta">Recorrer el proyecto <Icon name="arrow" size={14} /></span>
            </span>
          </a>
        ))}
      </div>
    </div>

  </article>

  <style>
    /* sin relleno abajo: la separación con el footer la pone el footer */
    .py{padding-bottom:0;}
    /* Entradilla de la página, no pie de la foto: en cuerpo chico y gris se
       leía como el epígrafe de la imagen de arriba. */
    .py-intro{
      margin:clamp(30px,4vw,48px) 0 clamp(68px,9vw,124px);
      font-size:var(--fs-h4);letter-spacing:-.005em;text-wrap:pretty;
    }
    /* Cada frase en su renglón: partida a la mitad se leía como un tropiezo. */
    .py-intro span{display:block;}
    .py-intro-b{color:var(--ink-40);}
    @media (min-width:760px){.py-intro{max-width:88ch;}}

    .py-vacio{color:var(--ink-40);font-size:var(--fs-body-lg);}

    /* Cuadrícula editorial, no de producto: la foto manda y el texto va debajo. */
    .py-grid{display:grid;gap:clamp(32px,4vw,56px);}
    @media (min-width:760px){.py-grid{grid-template-columns:repeat(2,1fr);}}

    .py-card{display:block;color:var(--ink);}
    .py-card-marco{
      display:block;overflow:hidden;border-radius:var(--radius);
      background:var(--paper);aspect-ratio:4/3;
    }
    .py-card-marco img{
      width:100%;height:100%;object-fit:cover;display:block;
      transition:transform 1.1s var(--ease);
    }
    @media (hover:hover){
      .py-card:hover .py-card-marco img{transform:scale(1.04);}
    }

    .py-card-txt{display:flex;flex-direction:column;margin-top:18px;}
    .py-card-meta{
      font-size:11px;letter-spacing:var(--track-label);
      text-transform:uppercase;color:var(--olive-deep);
    }
    .py-card-meta span{color:var(--ink-40);}
    .py-card-nombre{margin:8px 0 10px;transition:color .2s;}
    .py-card:hover .py-card-nombre{color:var(--olive-deep);}
    /* Llena el ancho de la tarjeta y baja al siguiente renglón: con una medida
       máxima en caracteres cortaba antes de llegar al final. Dos como tope. */
    .py-card-resumen{
      color:var(--ink-60);font-size:var(--fs-sm);text-wrap:wrap;
      display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;
      overflow:hidden;
    }
    .py-card-cta{
      display:inline-flex;align-items:center;gap:7px;margin-top:14px;
      font-size:var(--fs-xs);font-weight:600;color:var(--ink);
      transition:gap .25s var(--ease);
    }
    .py-card:hover .py-card-cta{gap:11px;}

  </style>
</Base>
