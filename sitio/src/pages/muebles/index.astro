---
import { migas } from "../../data/migas.js";
import Base from "../../layouts/Base.astro";
import Catalogo from "../../components/Catalogo.astro";
import { site, todosLosMuebles } from "../../data/site.js";
import { piezas } from "../../data/catalogo.js";
import { catalogoPdf } from "../../data/pdfs.js";

const pdf = catalogoPdf("general");
const descarga = pdf
  ? {
      ruta: pdf.ruta,
      nombre: "Neucast catálogo general.pdf",
      titulo: "La colección completa, para compartir",
      texto: "Todas nuestras categorías en un solo catálogo, listo para enviar a tu equipo o revisar con calma.",
      cta: "Descargar el catálogo",
    }
  : null;

// los textos viven con "Todos los muebles" en site.js (y en el administrador)
const { title, desc: description, h1, intro } = todosLosMuebles;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title.replace(/\s*\|\s*Neucast$/, ""),
    url: `${site.domain}/muebles`,
    description,
    inLanguage: "es-MX",
    isPartOf: { "@id": `${site.domain}/#organizacion` },
  },
  migas([["Muebles", "/muebles/"]]),
];
---
<Base title={title} description={description} schema={schema}>
  <Catalogo
    titulo={h1}
    intro={intro}
    piezas={piezas}
    descarga={descarga}
  />
</Base>
