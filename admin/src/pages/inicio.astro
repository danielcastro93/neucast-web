---
// Inicio. Responde "¿qué está pasando con el sitio y qué me toca hacer?".
// Por eso lo primero es la publicación: qué hay en pruebas y el botón para
// pasarlo al sitio público. Después las cifras, en una tira compacta, y al
// final las últimas piezas tocadas, con su foto.
import Admin from "../layouts/Admin.astro";
import IconoAdmin from "../components/IconoAdmin.astro";
const base = import.meta.env.BASE_URL;

const cifras = [
  { id: "publicadas", rotulo: "Publicadas", icono: "piezas", ruta: "piezas/" },
  { id: "borradores", rotulo: "Borradores", icono: "paginas", ruta: "piezas/?estado=borrador" },
  { id: "categorias", rotulo: "Categorías", icono: "categorias", ruta: "categorias/" },
  { id: "proyectos", rotulo: "Proyectos", icono: "proyectos", ruta: "proyectos/" },
];
---
<Admin titulo="Inicio" seccion="inicio">
  <header class="saludo saludo--compacto">
    <h1 class="t-pantalla" data-saludo>Hola</h1>
    <p class="t-apoyo" data-resumen>&nbsp;</p>
    <div class="saludo-acciones">
      <a class="boton boton--suave" href={`${base}piezas/editar/`} aria-label="Nueva pieza"><IconoAdmin name="mas" size={16} /><span class="boton-texto">Nueva pieza</span></a>
    </div>
  </header>

  <!-- ============ Publicación ============ -->
  <section class="tarjeta pub" data-pub data-estado="cargando" aria-labelledby="pub-titulo">
    <div class="pub-cabeza">
      <div class="pub-icono" aria-hidden="true">
        <svg class="pub-anillo" viewBox="0 0 64 64"><circle cx="32" cy="32" r="30" /></svg>
        <span class="pub-icono-espera"><IconoAdmin name="nube" size={26} /></span>
        <span class="pub-icono-listo"><IconoAdmin name="check" size={26} /></span>
      </div>
      <div class="pub-textos">
        <h2 class="pub-titulo" id="pub-titulo" data-pub-titulo><span class="hueso" style="display:inline-block;width:260px;height:26px"></span></h2>
        <p class="pub-nota" data-pub-nota></p>
      </div>
      <div class="pub-acciones">
        <a class="boton" href="#" target="_blank" rel="noopener" data-ver-pruebas><IconoAdmin name="externo" size={16} />Ver en pruebas</a>
        <button class="boton boton--primario" type="button" data-abre-modal="modal-publicar" data-pub-boton><IconoAdmin name="cohete" size={16} />Publicar</button>
      </div>
    </div>

    <!-- el camino: lo guardado va a pruebas solo; el sitio público espera el botón -->
    <ol class="ruta" aria-label="Camino de la publicación">
      <li class="ruta-paso ruta-paso--hecho">
        <span class="ruta-nodo"><IconoAdmin name="check" size={15} /></span>
        <b>Guardado</b>
        <small data-ruta-guardado>&nbsp;</small>
      </li>
      <li class="ruta-paso ruta-paso--hecho">
        <span class="ruta-nodo"><IconoAdmin name="check" size={15} /></span>
        <b>En pruebas</b>
        <small data-ruta-pruebas>&nbsp;</small>
      </li>
      <li class="ruta-paso" data-ruta-produccion>
        <span class="ruta-nodo"><IconoAdmin name="check" size={15} /><span class="ruta-reloj"><IconoAdmin name="reloj" size={17} /></span><span class="ruta-espera"></span></span>
        <b>neucast.com.mx</b>
        <small data-ruta-prod>&nbsp;</small>
      </li>
    </ol>

    <ul class="lista-filas" data-pub-lista></ul>
  </section>

  <!-- ============ Cifras ============ -->
  <dl class="tira" data-tira>
    {cifras.map((c) => (
      <a class="tira-celda" href={`${base}${c.ruta}`} data-cifra={c.id}>
        <dt><IconoAdmin name={c.icono} size={16} />{c.rotulo}</dt>
        <dd data-valor>0</dd>
        <small data-nota>&nbsp;</small>
      </a>
    ))}
  </dl>

  <!-- ============ Últimas piezas ============ -->
  <section class="tarjeta" aria-labelledby="recientes-titulo">
    <div class="modulo-cabeza">
      <h2 class="t-seccion" id="recientes-titulo">Últimas piezas tocadas</h2>
      <a class="enlace" href={`${base}piezas/`}>Ver todas<IconoAdmin name="chevron" size={16} /></a>
    </div>
    <ul class="lista-filas" data-recientes>
      {[1, 2, 3, 4, 5].map(() => (
        <li><div class="renglon"><span class="miniatura hueso"></span><span class="renglon-texto"><span class="hueso" style="width:140px;height:14px"></span><span class="hueso" style="width:90px;height:11px;margin-top:6px"></span></span></div></li>
      ))}
    </ul>
  </section>
</Admin>

<script>
  import { listar } from "../scripts/api.js";
  import { medio } from "../scripts/medios.js";
  import { estado, filaCambio } from "../scripts/publicacion.js";
  import { sesionActual } from "../scripts/sesion.js";
  import { avisar, fechaRelativa, escapar } from "../scripts/ui.js";

  const base = import.meta.env.BASE_URL;
  const $ = (s) => document.querySelector(s);
  const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ---------- Saludo ---------- */
  const sesion = sesionActual();
  const ahora = new Date();
  const hora = ahora.getHours();
  const saludo = hora < 12 ? "Buenos días" : hora < 19 ? "Buenas tardes" : "Buenas noches";
  $("[data-saludo]").textContent = `${saludo}, ${sesion?.nombre?.split(" ")[0] || ""}`.trim();
  $("[data-ver-pruebas]").href = import.meta.env.PUBLIC_STG || "http://localhost:4321/";

  /* ---------- Cifras que cuentan hasta su valor ---------- */
  function contar(el, valor) {
    const desde = Number(el.dataset.actual || 0);
    el.dataset.actual = valor;
    if (quieto || desde === valor) return (el.textContent = valor);
    const t0 = performance.now();
    const dur = 700;
    const paso = (t) => {
      const k = Math.min(1, (t - t0) / dur);
      const suave = 1 - Math.pow(1 - k, 3);
      el.textContent = Math.round(desde + (valor - desde) * suave);
      if (k < 1) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  }
  const cifra = (id, valor, nota) => {
    const c = $(`[data-cifra="${id}"]`);
    contar(c.querySelector("[data-valor]"), valor);
    c.querySelector("[data-nota]").textContent = nota;
  };

  /* ---------- Publicación ---------- */
  async function pintarPublicacion() {
    const p = await estado();
    const n = p.pendientes.length;
    const caja = $("[data-pub]");
    caja.dataset.estado = n ? "pendiente" : "aldia";
    $("[data-pub-titulo]").textContent = n
      ? `${n} ${n === 1 ? "cambio espera" : "cambios esperan"} tu visto bueno`
      : "Todo está publicado";
    $("[data-pub-nota]").textContent = n
      ? "Revísalos en el sitio de pruebas y, cuando estén bien, publícalos en neucast.com.mx."
      : `Última publicación ${fechaRelativa(p.produccion?.fecha)}${p.produccion?.por ? `, por ${p.produccion.por}` : ""}.`;
    $("[data-pub-boton]").hidden = !n;
    $("[data-ruta-guardado]").textContent = n ? fechaRelativa(p.pendientes[0]?.fecha) : "Nada pendiente";
    $("[data-ruta-pruebas]").textContent = fechaRelativa(p.pruebas?.fecha);
    $("[data-ruta-prod]").textContent = n ? "Esperando que publiques" : fechaRelativa(p.produccion?.fecha);
    $("[data-ruta-produccion]").classList.toggle("ruta-paso--hecho", !n);
    $("[data-ruta-produccion]").classList.toggle("ruta-paso--espera", !!n);
    $("[data-pub-lista]").innerHTML = p.pendientes.slice(0, 5).map((c) => filaCambio(c, p.porSlug)).join("")
      + (n > 5 ? `<li class="renglon-mas">y ${n - 5} más</li>` : "");
    $("[data-resumen]").textContent = n
      ? `Tienes ${n} ${n === 1 ? "cambio" : "cambios"} sin publicar.`
      : "Todo lo guardado ya está en neucast.com.mx.";
  }

  /* ---------- Cifras y recientes ---------- */
  async function pintarCatalogo() {
    const [piezas, categorias, proyectos] = await Promise.all([listar("piezas"), listar("categorias"), listar("proyectos")]);
    const publicadas = piezas.filter((p) => p.estado === "publicada");
    const borradores = piezas.length - publicadas.length;
    cifra("publicadas", publicadas.length, `${publicadas.filter((p) => p.nuevo).length} marcadas como nuevas`);
    cifra("borradores", borradores, borradores ? "Por terminar" : "Nada por terminar");
    $('[data-cifra="borradores"]').classList.toggle("tira-celda--alerta", borradores > 0);
    cifra("categorias", categorias.length, `${categorias.filter((c) => piezas.some((p) => p.cat === c.slug)).length} con piezas`);
    cifra("proyectos", proyectos.length, `${proyectos.filter((p) => p.destacado).length} en el home`);

    const nombreCat = (slug) => categorias.find((c) => c.slug === slug)?.name || "";
    $("[data-recientes]").innerHTML = piezas
      .slice()
      .sort((a, b) => (b.actualizado || "").localeCompare(a.actualizado || ""))
      .slice(0, 5)
      .map((p) => `
        <li><a class="renglon" href="${base}piezas/editar/?slug=${encodeURIComponent(p.slug)}">
          <span class="miniatura">${p.img?.[0] ? `<img src="${escapar(medio(p.img[0]))}" alt="" loading="lazy" />` : ""}</span>
          <span class="renglon-texto">
            <strong>${escapar(p.nombre)}</strong>
            <small>${escapar(p.tipo)} · ${escapar(nombreCat(p.cat))}</small>
          </span>
          <span class="renglon-der">
            <span class="estado estado--${p.estado === "publicada" ? "publicada" : "borrador"}">${p.estado === "publicada" ? "Publicada" : "Borrador"}</span>
            <small>${escapar(fechaRelativa(p.actualizado))}</small>
          </span>
          <svg class="renglon-flecha" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 5 5 5-5 5"/></svg>
        </a></li>`)
      .join("");
  }

  const todo = () => Promise.all([pintarPublicacion(), pintarCatalogo()]).catch((e) => avisar(e.message || "No se pudo cargar el inicio", { tipo: "error" }));
  todo();
  addEventListener("neucast:guardado", todo);
  addEventListener("neucast:publicado", todo);
</script>
