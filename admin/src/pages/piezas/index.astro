---
// La lista de piezas: buscar, filtrar por categoría y estado, ordenar, y
// entrar a editar. Las filas las pinta el navegador con lo que responde la API.
import Admin from "../../layouts/Admin.astro";
import IconoAdmin from "../../components/IconoAdmin.astro";
import Modal from "../../components/Modal.astro";
const base = import.meta.env.BASE_URL;
---
<Admin titulo="Piezas" seccion="piezas">
  <div class="cabecera cabecera--compacta">
    <div class="cabecera-textos">
      <h1 class="t-pantalla">Piezas</h1>
      <p class="t-apoyo" data-resumen>Cargando el catálogo…</p>
    </div>
    <div class="cabecera-acciones">
      <a class="boton boton--primario" href={`${base}piezas/editar/`} aria-label="Nueva pieza"><IconoAdmin name="mas" size={16} /><span class="boton-texto">Nueva pieza</span></a>
    </div>
  </div>

  <div class="tarjeta">
    <div class="herramientas">
      <div class="control--con-icono">
        <IconoAdmin name="buscar" />
        <input class="control" type="search" placeholder="Buscar por nombre, tipo o dirección" data-buscar aria-label="Buscar piezas" />
      </div>
      <!-- en teléfono la categoría y el estado se van a una hoja -->
      <button class="boton-filtros" type="button" data-abre-filtros aria-label="Filtros">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M3.5 6h13M6 10h8M8.5 14h3"/></svg>
        <span class="boton-filtros-n" data-filtros-n hidden></span>
      </button>
      <div class="herramientas-filtros" data-filtros>
      <span class="rotulo-hoja">Categoría</span>
      <select class="control" data-categoria aria-label="Categoría">
        <option value="">Todas las categorías</option>
      </select>
      <span class="rotulo-hoja">Estado</span>
      <div class="segmentos" role="group" aria-label="Estado" data-estados>
        <button class="segmento" type="button" data-estado="" aria-pressed="true">Todas</button>
        <button class="segmento" type="button" data-estado="publicada" aria-pressed="false">Publicadas</button>
        <button class="segmento" type="button" data-estado="borrador" aria-pressed="false">Borradores</button>
      </div>
      </div>
    </div>

    <div class="tabla-envoltura">
      <table class="tabla">
        <thead>
          <tr>
            <th class="col-foto"></th>
            <th aria-sort="ascending"><button type="button" data-orden="nombre">Pieza <IconoAdmin name="ordenar" size={12} /></button></th>
            <th class="col-oculta-movil"><button type="button" data-orden="cat">Categoría <IconoAdmin name="ordenar" size={12} /></button></th>
            <th class="col-oculta-movil">Acabados</th>
            <th class="col-oculta-movil"><button type="button" data-orden="entrega">Disponibilidad <IconoAdmin name="ordenar" size={12} /></button></th>
            <th>Estado</th>
            <th class="col-oculta-movil col-ancha"><button type="button" data-orden="actualizado">Cambiada <IconoAdmin name="ordenar" size={12} /></button></th>
            <th class="col-acciones"></th>
          </tr>
        </thead>
        <tbody data-filas>
          {[1, 2, 3, 4, 5, 6].map(() => (
            <tr aria-hidden="true">
              <td class="col-foto"><div class="hueso" style="width:48px;height:48px;border-radius:10px"></div></td>
              <td><div class="hueso" style="width:140px;height:14px"></div><div class="hueso" style="width:90px;height:11px;margin-top:6px"></div></td>
              <td class="col-oculta-movil"><div class="hueso" style="width:110px;height:14px"></div></td>
              <td class="col-oculta-movil"><div class="hueso" style="width:70px;height:14px"></div></td>
              <td class="col-oculta-movil"><div class="hueso" style="width:90px;height:14px"></div></td>
              <td><div class="hueso" style="width:80px;height:26px;border-radius:999px"></div></td>
              <td class="col-oculta-movil col-ancha"><div class="hueso" style="width:60px;height:14px"></div></td>
              <td></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="vacio" data-vacio hidden>
      <IconoAdmin name="buscar" size={36} />
      <b>Ninguna pieza coincide</b>
      <p>Prueba con otra palabra o quita los filtros.</p>
      <button class="boton boton--chico" type="button" data-limpiar>Quitar los filtros</button>
    </div>
    <div class="tabla-pie paginador" data-paginador>
      <span class="paginador-conteo" data-conteo></span>
      <nav class="paginador-paginas" aria-label="Páginas" data-paginas></nav>
      <div class="paginador-por">
        <label for="por-pagina">Por página</label>
        <select class="control" id="por-pagina" data-por>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </div>
    </div>
  </div>
  <Modal id="modal-filtros" titulo="Filtros">
    <div data-filtros-hoja></div>
    <Fragment slot="pie">
      <button class="boton boton--texto izquierda" type="button" data-quitar-filtros>Quitar filtros</button>
      <button class="boton boton--primario" type="button" data-cierra-modal data-ver-filtradas>Ver piezas</button>
    </Fragment>
  </Modal>
</Admin>

<script>
  import { listar, guardar, borrar } from "../../scripts/api.js";
  import { medio } from "../../scripts/medios.js";
  import { opciones, nombreOpcion } from "../../scripts/listas.js";
  import { confirmar, avisar, fechaRelativa, escapar, abrirModal } from "../../scripts/ui.js";

  const base = import.meta.env.BASE_URL;
  const $ = (s, el = document) => el.querySelector(s);

  let piezas = [];
  let categorias = [];
  let listas = null;
  const filtro = { texto: "", cat: "", estado: "", orden: "nombre", dir: 1 };
  // Paginador: con miles de piezas no se pintan todas. La página y el tamaño
  // van en la dirección para que al volver del editor se quede donde estaba.
  // Con la API real la página la corta el servidor (docs/administrador.md).
  const POR = [25, 50, 100];
  const params = new URLSearchParams(location.search);
  let pagina = Math.max(1, parseInt(params.get("pagina"), 10) || 1);
  let porPagina = POR.includes(+params.get("por")) ? +params.get("por") : (() => {
    try { return POR.includes(+localStorage.getItem("neucast-admin:por-pagina")) ? +localStorage.getItem("neucast-admin:por-pagina") : 50; } catch { return 50; }
  })();
  const miles = (n) => n.toLocaleString("es-MX");

  const nombreCat = (slug) => categorias.find((c) => c.slug === slug)?.name || slug;
  const nombreEntrega = (id) => (listas ? nombreOpcion(listas, "entrega", id) : "") || id || "";
  const colorHex = (id) => (listas ? opciones(listas, "colores").find((g) => g.id === id)?.hex : null) || "#ccc";
  const normal = (s) => (s || "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

  function filtradas() {
    const t = normal(filtro.texto);
    return piezas
      .filter((p) => !filtro.cat || p.cat === filtro.cat)
      .filter((p) => !filtro.estado || p.estado === filtro.estado)
      .filter((p) => !t || normal(`${p.nombre} ${p.tipo} ${p.slug} ${nombreCat(p.cat)}`).includes(t))
      .sort((a, b) => {
        const k = filtro.orden;
        const va = k === "cat" ? nombreCat(a.cat) : k === "entrega" ? nombreEntrega(a.entrega) : a[k] || "";
        const vb = k === "cat" ? nombreCat(b.cat) : k === "entrega" ? nombreEntrega(b.entrega) : b[k] || "";
        return String(va).localeCompare(String(vb), "es") * filtro.dir;
      });
  }

  function fila(p) {
    const foto = p.img?.[0] ? `<img src="${escapar(medio(p.img[0]))}" alt="" loading="lazy" />` : "";
    // dos puntos de color y, si hay más, un círculo con cuántos faltan
    const grupos = p.colores || [];
    const colores = grupos.slice(0, 2).map((c) => `<span class="chip-color" title="${escapar(c)}" style="background:${colorHex(c)}"></span>`).join("")
      + (grupos.length > 2 ? `<span class="chip-mas" title="${escapar(grupos.slice(2).join(", "))}">+${grupos.length - 2}</span>` : "");
    return `
      <tr data-slug="${escapar(p.slug)}" tabindex="0">
        <td class="col-foto"><div class="miniatura">${foto}</div></td>
        <td class="celda-nombre"><b>${escapar(p.nombre)}${p.nuevo ? ' <span class="etiqueta-nuevo">Nuevo</span>' : ""}</b><span>${escapar(p.tipo)}</span></td>
        <td class="col-oculta-movil">${escapar(nombreCat(p.cat))}</td>
        <td class="col-oculta-movil"><span class="puntos-color">${colores}</span></td>
        <td class="col-oculta-movil">${escapar(nombreEntrega(p.entrega))}</td>
        <td class="celda-datos"><span class="estado estado--${escapar(p.estado || "borrador")}">${p.estado === "publicada" ? "Publicada" : "Borrador"}</span><span class="solo-movil t-mini">${escapar(nombreCat(p.cat))}</span></td>
        <td class="col-oculta-movil col-ancha t-mini">${escapar(fechaRelativa(p.actualizado))}</td>
        <td class="col-acciones">
          <div class="desplegable menu-fila" data-desplegable>
            <button class="boton boton--chico boton--icono boton--texto" type="button" aria-label="Más acciones" aria-haspopup="menu" aria-expanded="false" data-desplegable-boton>
              <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><circle cx="10" cy="5" r="1.4"/><circle cx="10" cy="10" r="1.4"/><circle cx="10" cy="15" r="1.4"/></svg>
            </button>
            <div class="desplegable-menu" role="menu">
              <a class="desplegable-item" role="menuitem" href="${base}piezas/editar/?slug=${encodeURIComponent(p.slug)}">Editar</a>
              <button class="desplegable-item" role="menuitem" type="button" data-duplicar>Duplicar</button>
              <button class="desplegable-item" role="menuitem" type="button" data-alternar>${p.estado === "publicada" ? "Pasar a borrador" : "Publicar"}</button>
              <button class="desplegable-item desplegable-item--peligro" role="menuitem" type="button" data-borrar>Borrar</button>
            </div>
          </div>
        </td>
      </tr>`;
  }

  function pintar() {
    const lista = filtradas();
    // la hoja de filtros del teléfono: cuántos hay puestos y cuántas piezas salen
    const puestos = Number(!!filtro.cat) + Number(!!filtro.estado);
    $("[data-filtros-n]").hidden = !puestos;
    $("[data-filtros-n]").textContent = puestos;
    $("[data-abre-filtros]").classList.toggle("activo", puestos > 0);
    $("[data-ver-filtradas]").textContent = `Ver ${miles(lista.length)} ${lista.length === 1 ? "pieza" : "piezas"}`;
    $("[data-quitar-filtros]").hidden = !puestos;
    const total = lista.length;
    const paginas = Math.max(1, Math.ceil(total / porPagina));
    pagina = Math.min(pagina, paginas);
    const desde = (pagina - 1) * porPagina;
    const cuerpo = $("[data-filas]");
    cuerpo.innerHTML = lista.slice(desde, desde + porPagina).map(fila).join("");
    $("[data-vacio]").hidden = total > 0;
    $("[data-paginador]").hidden = total === 0;
    const filtrando = total !== piezas.length;
    $("[data-conteo]").innerHTML = total <= porPagina
      ? `${miles(total)} ${total === 1 ? "pieza" : "piezas"}${filtrando ? ` de ${miles(piezas.length)}` : ""}`
      : `<b>${miles(desde + 1)}–${miles(Math.min(desde + porPagina, total))}</b> de ${miles(total)}${filtrando ? ` <span class="paginador-de">(de ${miles(piezas.length)})</span>` : ""}`;
    pintarPaginas(paginas);
    const u = new URL(location.href);
    pagina > 1 ? u.searchParams.set("pagina", pagina) : u.searchParams.delete("pagina");
    porPagina !== 50 ? u.searchParams.set("por", porPagina) : u.searchParams.delete("por");
    history.replaceState(null, "", u);
    document.querySelectorAll("th[data-th]").forEach((th) => th.removeAttribute("aria-sort"));
    document.querySelectorAll("th").forEach((th) => {
      const b = th.querySelector("[data-orden]");
      if (!b) return;
      if (b.dataset.orden === filtro.orden) th.setAttribute("aria-sort", filtro.dir > 0 ? "ascending" : "descending");
      else th.removeAttribute("aria-sort");
    });
    cablearFilas(cuerpo);
  }

  // ‹ 1 … 4 5 6 … 20 ›: siempre la primera, la última y dos alrededor de la actual
  function pintarPaginas(paginas) {
    const nav = $("[data-paginas]");
    if (paginas <= 1) return (nav.innerHTML = "");
    const nums = [...new Set([1, pagina - 1, pagina, pagina + 1, paginas])].filter((n) => n >= 1 && n <= paginas).sort((a, b) => a - b);
    const flecha = (n, etiqueta, d) => `<button class="paginador-boton paginador-flecha" type="button" data-pagina="${n}" aria-label="${etiqueta}" ${n < 1 || n > paginas ? "disabled" : ""}><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="${d}"/></svg></button>`;
    let html = flecha(pagina - 1, "Página anterior", "m12.5 5-5 5 5 5");
    nums.forEach((n, i) => {
      if (i && n - nums[i - 1] > 1) html += `<span class="paginador-salto" aria-hidden="true">…</span>`;
      html += `<button class="paginador-boton${n === pagina ? " activo" : ""}" type="button" data-pagina="${n}" ${n === pagina ? 'aria-current="page"' : ""} aria-label="Página ${n}">${miles(n)}</button>`;
    });
    html += flecha(pagina + 1, "Página siguiente", "m7.5 5 5 5-5 5");
    nav.innerHTML = html;
  }
  $("[data-paginas]").addEventListener("click", (e) => {
    const b = e.target.closest("[data-pagina]");
    if (!b || b.disabled) return;
    irAPagina(+b.dataset.pagina);
  });
  function irAPagina(n) {
    pagina = n;
    pintar();
    const tarjeta = $(".tarjeta");
    if (tarjeta.getBoundingClientRect().top < 0) tarjeta.scrollIntoView({ behavior: "smooth", block: "start" });
  }
  $("[data-por]").value = String(porPagina);
  $("[data-por]").addEventListener("change", (e) => {
    const primera = (pagina - 1) * porPagina; // se queda en la página que tiene la misma primera pieza
    porPagina = +e.target.value;
    try { localStorage.setItem("neucast-admin:por-pagina", porPagina); } catch {}
    pagina = Math.floor(primera / porPagina) + 1;
    pintar();
  });

  function cablearFilas(cuerpo) {
    cuerpo.querySelectorAll("tr[data-slug]").forEach((tr) => {
      const ir = () => (location.href = `${base}piezas/editar/?slug=${encodeURIComponent(tr.dataset.slug)}`);
      tr.addEventListener("click", (e) => {
        if (e.target.closest("[data-desplegable]")) return;
        ir();
      });
      tr.addEventListener("keydown", (e) => e.key === "Enter" && !e.target.closest("[data-desplegable]") && ir());

      const d = tr.querySelector("[data-desplegable]");
      const b = d.querySelector("[data-desplegable-boton]");
      const alternar = (abrir) => {
        d.classList.toggle("abierto", abrir);
        b.setAttribute("aria-expanded", String(abrir));
      };
      b.addEventListener("click", (e) => {
        e.stopPropagation();
        document.querySelectorAll(".menu-fila.abierto").forEach((o) => o !== d && o.classList.remove("abierto"));
        alternar(!d.classList.contains("abierto"));
      });
      const pieza = piezas.find((p) => p.slug === tr.dataset.slug);
      d.querySelector("[data-duplicar]").addEventListener("click", async (e) => {
        e.stopPropagation();
        alternar(false);
        const copia = { ...structuredClone(pieza), slug: `${pieza.slug}-copia`, nombre: `${pieza.nombre} (copia)`, estado: "borrador" };
        delete copia.actualizado;
        try {
          await guardar("piezas", copia);
          avisar(`Se duplicó ${pieza.nombre} como borrador`);
          await cargar();
          dispatchEvent(new CustomEvent("neucast:guardado"));
        } catch (err) {
          avisar(err.message, { tipo: "error" });
        }
      });
      d.querySelector("[data-alternar]").addEventListener("click", async (e) => {
        e.stopPropagation();
        alternar(false);
        const aPublicada = pieza.estado !== "publicada";
        try {
          await guardar("piezas", { ...pieza, _original: pieza.slug, estado: aPublicada ? "publicada" : "borrador" });
          avisar(aPublicada ? `${pieza.nombre} pasó a pruebas como publicada` : `${pieza.nombre} ahora es borrador`);
          await cargar();
          dispatchEvent(new CustomEvent("neucast:guardado"));
        } catch (err) {
          const faltan = Object.values(err.campos || {});
          avisar(faltan.length ? `${err.message}: ${faltan[0]}` : err.message, { tipo: "error" });
        }
      });
      d.querySelector("[data-borrar]").addEventListener("click", async (e) => {
        e.stopPropagation();
        alternar(false);
        const ok = await confirmar({
          titulo: `Borrar ${pieza.nombre}`,
          texto: "Desaparece su página, su ficha en PDF y su lugar en el catálogo, el buscador y los proyectos donde esté. Si solo quieres esconderla, pásala a borrador.",
          accion: "Borrar la pieza",
          peligro: true,
        });
        if (!ok) return;
        try {
          await borrar("piezas", pieza.slug);
          avisar(`Se borró ${pieza.nombre}`);
          await cargar();
          dispatchEvent(new CustomEvent("neucast:guardado"));
        } catch (err) {
          avisar(err.message, { tipo: "error" });
        }
      });
    });
  }
  document.addEventListener("click", () => document.querySelectorAll(".menu-fila.abierto").forEach((o) => o.classList.remove("abierto")));

  async function cargar() {
    [piezas, categorias, listas] = await Promise.all([listar("piezas"), listar("categorias"), listar("listas")]);
    const sel = $("[data-categoria]");
    if (sel.options.length === 1) {
      for (const c of categorias) sel.insertAdjacentHTML("beforeend", `<option value="${escapar(c.slug)}">${escapar(c.name)}</option>`);
    }
    const publicadas = piezas.filter((p) => p.estado === "publicada").length;
    $("[data-resumen]").innerHTML = `${miles(piezas.length)} piezas<span class="no-telefono"> en ${categorias.length} categorías · ${miles(publicadas)} publicadas,</span><span class="solo-telefono"> ·</span> ${miles(piezas.length - publicadas)} en borrador`;
    pintar();
  }

  /* ---------- Controles ---------- */
  $("[data-buscar]").addEventListener("input", (e) => { filtro.texto = e.target.value; pagina = 1; pintar(); });
  $("[data-categoria]").addEventListener("change", (e) => { filtro.cat = e.target.value; pagina = 1; pintar(); });
  $("[data-estados]").addEventListener("click", (e) => {
    const b = e.target.closest("[data-estado]");
    if (!b) return;
    filtro.estado = b.dataset.estado;
    document.querySelectorAll("[data-estados] .segmento").forEach((s) => s.setAttribute("aria-pressed", String(s === b)));
    pagina = 1;
    pintar();
  });
  document.querySelectorAll("[data-orden]").forEach((b) =>
    b.addEventListener("click", () => {
      if (filtro.orden === b.dataset.orden) filtro.dir *= -1;
      else { filtro.orden = b.dataset.orden; filtro.dir = 1; }
      pagina = 1;
      pintar();
    })
  );
  $("[data-limpiar]").addEventListener("click", () => {
    filtro.texto = ""; filtro.cat = ""; filtro.estado = ""; pagina = 1;
    $("[data-buscar]").value = ""; $("[data-categoria]").value = "";
    document.querySelectorAll("[data-estados] .segmento").forEach((s) => s.setAttribute("aria-pressed", String(!s.dataset.estado)));
    pintar();
  });

  // En teléfono la categoría y el estado viven en una hoja; en escritorio,
  // junto al buscador. Son los mismos controles: solo cambian de lugar.
  const TELEFONO = matchMedia("(max-width: 640px)");
  const acomodarFiltros = () => {
    const filtros = $("[data-filtros]");
    const destino = TELEFONO.matches ? $("[data-filtros-hoja]") : $(".herramientas");
    if (filtros.parentElement !== destino) destino.appendChild(filtros);
    $("[data-buscar]").placeholder = TELEFONO.matches ? "Buscar piezas" : "Buscar por nombre, tipo o dirección";
  };
  acomodarFiltros();
  TELEFONO.addEventListener("change", acomodarFiltros);
  $("[data-abre-filtros]").addEventListener("click", () => abrirModal("modal-filtros"));
  $("[data-quitar-filtros]").addEventListener("click", () => {
    filtro.cat = ""; filtro.estado = ""; pagina = 1;
    $("[data-categoria]").value = "";
    document.querySelectorAll("[data-estados] .segmento").forEach((s) => s.setAttribute("aria-pressed", String(!s.dataset.estado)));
    pintar();
  });

  // Atajo: "/" lleva al buscador.
  addEventListener("keydown", (e) => {
    if (e.key === "/" && !["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement?.tagName)) {
      e.preventDefault();
      $("[data-buscar]").focus();
    }
  });

  // ?estado=borrador llega desde la cifra de borradores del inicio
  const estadoInicial = params.get("estado");
  if (estadoInicial === "borrador" || estadoInicial === "publicada") {
    filtro.estado = estadoInicial;
    document.querySelectorAll("[data-estados] .segmento").forEach((s) => s.setAttribute("aria-pressed", String(s.dataset.estado === estadoInicial)));
  }

  cargar().catch((e) => avisar(e.message || "No se pudo cargar el catálogo", { tipo: "error" }));
</script>
