---
// Alta y edición de una pieza. Sin ?slug= es una pieza nueva.
//
// La pantalla con más campos del administrador. Sigue los tres niveles
// aprobados: obligatorios para todas, obligatorios según la categoría (el
// formulario los enseña al elegirla) y opcionales (la ficha técnica). Todo lo
// que la pieza puede llevar en el sitio se captura aquí: identidad, fotos,
// clasificación, ficha, piezas que combinan, colecciones y estado.
import Admin from "../../layouts/Admin.astro";
import IconoAdmin from "../../components/IconoAdmin.astro";
import Modal from "../../components/Modal.astro";
import "../../styles/editor.css";
const base = import.meta.env.BASE_URL;

const secciones = [
  { id: "identidad", nombre: "Identidad" },
  { id: "fotos", nombre: "Fotos" },
  { id: "clasificacion", nombre: "Clasificación" },
  { id: "ficha", nombre: "Ficha técnica" },
  { id: "relaciones", nombre: "Combina con" },
  { id: "publicacion", nombre: "Publicación" },
];
---
<Admin titulo="Pieza" seccion="piezas" migas={[{ nombre: "Piezas", ruta: "piezas/" }]} publicarAbajo={false}>
  <form class="editor" novalidate data-form>
    <div class="cabecera">
      <div class="cabecera-textos">
        <span class="cabecera-rotulo" data-cabecera-rotulo>Nueva pieza</span>
        <h1 class="t-pantalla" data-cabecera-titulo>Nueva pieza</h1>
        <p class="t-apoyo" data-cabecera-nota>Se guarda como borrador hasta que tenga todo lo obligatorio.</p>
      </div>
      <div class="cabecera-acciones">
        <a class="boton" href="#" target="_blank" rel="noopener" data-ver-pruebas hidden><IconoAdmin name="externo" size={16} />Ver en pruebas</a>
      </div>
    </div>

    <nav class="pasos-editor" aria-label="Pasos para dar de alta la pieza" data-avance>
      <ol class="pasos-lista">
        {secciones.map((sec, i) => (
          <li>
            <a href={`#${sec.id}`} data-indice={sec.id}>
              <span class="paso-n"><span class="paso-num">{i + 1}</span><svg class="paso-check" width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10.5 4 4 8-9"/></svg></span>
              <span class="paso-nombre">{sec.nombre}</span>
            </a>
          </li>
        ))}
      </ol>
      <div class="pasos-avance" title="Datos obligatorios capturados">
        <span class="pasos-avance-barra"><span data-avance-barra></span></span>
        <span class="pasos-avance-cuenta" data-avance-cuenta>0 de 11</span>
      </div>
      <p class="pasos-nota" data-avance-nota hidden></p>
    </nav>

    <div class="formulario">
      <div class="formulario-secciones">
        <!-- ============ Identidad ============ -->
        <section class="tarjeta seccion" id="identidad">
          <div class="seccion-cabeza">
            <span class="seccion-n">1</span>
            <div>
              <h2 class="t-seccion">Identidad</h2>
              <p class="t-mini">Cómo se llama, qué es y dónde vive en el sitio.</p>
            </div>
          </div>
          <div class="seccion-cuerpo">
            <div class="fila">
              <div class="campo" data-campo="nombre">
                <div class="campo-etiqueta"><label for="nombre">Nombre<span class="obligatorio">*</span></label><span class="campo-contador" data-contador="nombre"></span></div>
                <input class="control" id="nombre" name="nombre" type="text" placeholder="Ej. Órbita" autocomplete="off" />
                <p class="campo-ayuda">Solo el nombre propio, sin el tipo: "Órbita", no "Silla Órbita".</p>
                <p class="campo-error" data-error></p>
              </div>
              <div class="campo" data-campo="tipo">
                <div class="campo-etiqueta"><label for="tipo">Tipo de mueble<span class="obligatorio">*</span></label><span class="campo-contador" data-contador="tipo"></span></div>
                <input class="control" id="tipo" name="tipo" type="text" placeholder="Ej. Silla operativa" autocomplete="off" />
                <div class="sugerencias" data-sugerencias-tipo hidden></div>
                <p class="campo-ayuda">Lo que es. Se lee encima del nombre y arma el título de la página.</p>
                <p class="campo-error" data-error></p>
              </div>
            </div>
            <div class="fila">
              <div class="campo" data-campo="cat">
                <div class="campo-etiqueta"><label for="cat">Categoría<span class="obligatorio">*</span></label></div>
                <select class="control" id="cat" name="cat"><option value="" hidden>Elige una categoría</option></select>
                <p class="campo-ayuda">Una sola. Define la dirección y qué datos se piden más abajo.</p>
                <p class="campo-error" data-error></p>
              </div>
              <div class="campo" data-campo="slug">
                <div class="campo-etiqueta">
                  <label for="slug">Dirección<span class="obligatorio">*</span></label>
                  <button class="enlace-chico" type="button" data-proponer-slug hidden>Usar el nombre</button>
                </div>
                <input class="control mono" id="slug" name="slug" type="text" placeholder="Ej. silla-orbita" spellcheck="false" autocomplete="off" />
                <p class="direccion" data-prefijo-slug></p>
                <p class="campo-ayuda" data-ayuda-slug>Se escribe sola con el tipo y el nombre. Minúsculas, sin acentos, con guiones.</p>
                <p class="campo-error" data-error></p>
              </div>
            </div>
          </div>
        </section>

        <!-- ============ Fotos ============ -->
        <section class="tarjeta seccion" id="fotos">
          <div class="seccion-cabeza">
            <span class="seccion-n">2</span>
            <div>
              <h2 class="t-seccion">Fotos</h2>
              <p class="t-mini">La primera es la principal: sale en el catálogo, el buscador, la ficha en PDF y Google.</p>
            </div>
          </div>
          <div class="seccion-cuerpo">
            <div class="consejo">
              <IconoAdmin name="foto" size={18} />
              <p><b>Recortes con fondo transparente</b> (PNG o WebP) para la principal: el sitio pone el mueble sobre un gris suave y con fondo blanco se vería un cuadro. Las de ambiente pueden ser JPG. Toca una foto para describirla; arrastra para cambiar el orden.</p>
            </div>
            <div class="campo" data-campo="img">
              <div class="campo-etiqueta"><span class="etiqueta">Galería<span class="obligatorio">*</span></span><span class="campo-contador" data-fotos-cuenta></span></div>
              <div class="galeria" data-galeria></div>
              <p class="campo-error" data-error></p>
            </div>
            <div class="campo" data-campo="alt">
              <div class="campo-etiqueta"><label for="alt">Texto alternativo de la foto principal<span class="obligatorio">*</span></label><span class="campo-contador" data-contador="alt"></span></div>
              <input class="control" id="alt" name="alt" type="text" placeholder="Ej. Silla operativa Órbita negra con respaldo de malla y ruedas" />
              <p class="campo-ayuda">Qué se ve en la foto, para quien no la ve y para Google: el tipo, el nombre y el acabado.</p>
              <p class="campo-error" data-error></p>
            </div>
            <div class="separador"></div>
            <div class="campo">
              <div class="campo-etiqueta"><span class="etiqueta">Foto de ambiente</span><span class="etiqueta-nota">la grande, a todo lo ancho, debajo del párrafo</span></div>
              <div class="ambiente" data-ambiente role="radiogroup" aria-label="Foto de ambiente"></div>
              <p class="campo-ayuda" data-ambiente-nota></p>
            </div>
            <div class="campo">
              <div class="campo-etiqueta"><span class="etiqueta">Video</span><span class="etiqueta-nota">opcional · va al final de la galería</span></div>
              <div class="video-pieza" data-video></div>
              <p class="campo-ayuda">MP4 horizontal o cuadrado, corto y sin sonido: se reproduce solo. Si no hay, la galería enseña el video general de Neucast.</p>
            </div>
            <input type="file" accept="image/png,image/jpeg,image/webp" multiple hidden data-archivo />
            <input type="file" accept="video/mp4,video/webm" hidden data-archivo-video />
          </div>
        </section>

        <!-- ============ Clasificación ============ -->
        <section class="tarjeta seccion" id="clasificacion">
          <div class="seccion-cabeza">
            <span class="seccion-n">3</span>
            <div>
              <h2 class="t-seccion">Clasificación</h2>
              <p class="t-mini">Lo que hace funcionar los filtros y el buscador. Son listas cerradas: si falta una opción, se da de alta en <a class="enlace" href={`${base}listas/`} data-sale>Listas</a>.</p>
            </div>
          </div>
          <div class="seccion-cuerpo">
            <div class="fila">
              <div class="campo" data-campo="material">
                <div class="campo-etiqueta"><label for="material">Material<span class="obligatorio">*</span></label></div>
                <select class="control" id="material" name="material"><option value="" hidden>Elige el material principal</option></select>
                <p class="campo-error" data-error></p>
              </div>
              <div class="campo" data-campo="entrega">
                <div class="campo-etiqueta"><label for="entrega">Disponibilidad<span class="obligatorio">*</span></label></div>
                <select class="control" id="entrega" name="entrega"><option value="" hidden>Elige en cuánto se entrega</option></select>
                <p class="campo-error" data-error></p>
              </div>
            </div>

            <div class="campo" data-campo="acabados">
              <div class="campo-etiqueta"><span class="etiqueta">Acabados<span class="obligatorio">*</span></span><span class="etiqueta-acciones"><span class="campo-contador" data-contador-acabados></span></span></div>
              <p class="campo-ayuda campo-ayuda--arriba">Cada acabado lleva su nombre comercial (el de la tela o el color) y el grupo de color por el que se filtra: nadie busca "plumbago", busca "azul".</p>
              <div class="acabados" data-acabados></div>
              <button class="boton boton--suave boton--agregar" type="button" data-agregar-acabado><IconoAdmin name="mas" size={16} />Agregar acabado</button>
              <p class="campo-error" data-error></p>
            </div>

            <div class="separador"></div>
            <div class="vacio-chico" data-nota-categoria>
              <IconoAdmin name="categorias" size={20} />
              <span>Elige una categoría arriba y aquí aparecen los datos que le tocan: respaldo y base para sillas, plazas para sofás, y así.</span>
            </div>
            <div data-filtros-categoria></div>
          </div>
        </section>

        <!-- ============ Ficha técnica ============ -->
        <section class="tarjeta seccion" id="ficha">
          <div class="seccion-cabeza">
            <span class="seccion-n">4</span>
            <div>
              <h2 class="t-seccion">Ficha técnica</h2>
              <p class="t-mini">El párrafo es obligatorio; lo demás se enseña solo si existe. Si no hay dato confirmado, se deja vacío: nunca se inventa una cifra.</p>
            </div>
          </div>
          <div class="seccion-cuerpo">
            <div class="campo" data-campo="resumen">
              <div class="campo-etiqueta"><label for="resumen">Párrafo descriptivo<span class="obligatorio">*</span></label><span class="campo-contador" data-contador="resumen"></span></div>
              <textarea class="control" id="resumen" name="resumen" rows="4" placeholder="Ej. Respaldo de malla tensada de una pieza, pensada para la jornada completa. El soporte lumbar se ajusta en altura sin herramienta."></textarea>
              <p class="campo-ayuda">Sale en grande debajo de la galería, antes de la foto de ambiente: la primera frase en negro y el resto en gris. Escríbelo para quien amuebla un espacio de trabajo: uso y resistencia, no decoración ni plazos.</p>
              <p class="campo-error" data-error></p>
            </div>

            <div class="campo">
              <div class="campo-etiqueta"><span class="etiqueta">Destacados</span><span class="etiqueta-nota">hasta 3 frases cortas</span></div>
              <div class="grupo-lista" data-frases="destacados"></div>
              <p class="campo-ayuda">Se leen en el panel "Detalles del producto". El primero entra en la descripción que sale en Google.</p>
            </div>

            <div class="separador"></div>

            <div class="campo">
              <div class="campo-etiqueta"><span class="etiqueta">Medidas</span><span class="etiqueta-nota">con su unidad</span></div>
              <div data-medidas></div>
              <button class="enlace-chico enlace-chico--mas" type="button" data-mas-medidas hidden></button>
            </div>

            <div class="campo">
              <div class="campo-etiqueta"><span class="etiqueta">Construcción</span><span class="etiqueta-nota">de qué está hecha cada parte</span></div>
              <div class="grupo-lista grupo-lista--dos" data-partes></div>
              <button class="enlace-chico enlace-chico--mas" type="button" data-mas-construccion hidden></button>
            </div>

            <div class="separador"></div>

            <div class="campo" data-bloque-mecanismo>
              <div class="campo-etiqueta"><span class="etiqueta">Mecanismo</span><span class="etiqueta-nota">solo sillas</span></div>
              <div class="grupo-lista">
                <label class="fila-lista">
                  <span class="fila-lista-etiqueta fila-lista-etiqueta--fija">Nombre</span>
                  <input class="fila-lista-control fila-lista-control--izq" id="mecanismo" name="mecanismo" type="text" placeholder="Ej. Synchro multiposiciones" />
                </label>
                <div class="grupo-lista-sub">Ajustes que permite</div>
                <div class="frases-en-lista" data-frases="ajustes"></div>
              </div>
            </div>

            <div class="campo">
              <div class="campo-etiqueta"><span class="etiqueta">Cuidados</span></div>
              <div class="grupo-lista" data-frases="cuidados"></div>
              <p class="campo-ayuda">Cómo se limpia y se mantiene. Se lee en el panel "Materiales y cuidados".</p>
            </div>
          </div>
        </section>

        <!-- ============ Combina con ============ -->
        <section class="tarjeta seccion" id="relaciones">
          <div class="seccion-cabeza">
            <span class="seccion-n">5</span>
            <div>
              <h2 class="t-seccion">Combina con</h2>
              <p class="t-mini">Dónde más aparece la pieza y qué otras se sugieren con ella.</p>
            </div>
          </div>
          <div class="seccion-cuerpo">
            <div class="campo">
              <div class="campo-etiqueta"><span class="etiqueta">Piezas que combinan</span><span class="campo-contador" data-contador-combina></span></div>
              <p class="campo-ayuda campo-ayuda--arriba" data-combina-nota>Si no eliges ninguna, el sitio enseña primero las de la misma categoría y después el resto.</p>
              <div class="combina" data-combina></div>
              <button class="boton boton--suave boton--agregar" type="button" data-abre-combina><IconoAdmin name="mas" size={16} /><span>Elegir piezas</span></button>
            </div>
            <div class="separador"></div>
            <div class="campo">
              <div class="campo-etiqueta"><span class="etiqueta">Colecciones por espacio</span></div>
              <div class="chips" data-chips="espacios"></div>
              <p class="campo-ayuda">La pieza sigue en su categoría y además sale en la página de cada colección marcada.</p>
            </div>
          </div>
        </section>

        <!-- ============ Publicación ============ -->
        <section class="tarjeta seccion" id="publicacion">
          <div class="seccion-cabeza">
            <span class="seccion-n">6</span>
            <div>
              <h2 class="t-seccion">Publicación</h2>
              <p class="t-mini">Si ya se puede ver y cómo sale en Google.</p>
            </div>
          </div>
          <div class="seccion-cuerpo">
            <div class="opciones-estado" data-campo="estado">
              <label class="opcion">
                <input type="radio" name="estado" value="borrador" />
                <span class="opcion-marca"></span>
                <span class="opcion-texto"><b>Borrador</b><small>Se guarda aunque falten datos. No sale ni en pruebas ni en el sitio.</small></span>
              </label>
              <label class="opcion">
                <input type="radio" name="estado" value="publicada" />
                <span class="opcion-marca"></span>
                <span class="opcion-texto"><b>Publicada</b><small>Al guardar sale en pruebas; con "Publicar" pasa a neucast.com.mx. Pide todos los obligatorios.</small></span>
              </label>
            </div>

            <label class="interruptor">
              <input type="checkbox" name="nuevo" />
              <span class="interruptor-pista"></span>
              <span class="interruptor-texto">Marcar como nueva<small>Pinta la etiqueta "Nuevo" en su tarjeta del catálogo</small></span>
            </label>
            <label class="interruptor">
              <input type="checkbox" name="destacada" />
              <span class="interruptor-pista"></span>
              <span class="interruptor-texto">Destacar en el inicio<small>Entra al carrusel "Piezas destacadas" de la portada</small></span>
            </label>

            <div class="separador"></div>

            <div class="campo">
              <div class="campo-etiqueta"><span class="etiqueta">Así sale en Google</span><span class="etiqueta-nota">se arma solo</span></div>
              <div class="google">
                <span class="google-url" data-google-url>neucast.com.mx › muebles</span>
                <span class="google-titulo" data-google-titulo>Tipo Nombre | Categoría | Neucast</span>
                <span class="google-desc" data-google-desc>Tipo Nombre. Primer destacado. Disponibilidad. Envío e instalación en todo México.</span>
              </div>
              <p class="campo-ayuda" data-google-nota>El título y la descripción salen de una fórmula con el tipo, el nombre, la categoría, el primer destacado y la disponibilidad. Así todo el catálogo queda parejo.</p>
            </div>

            <div class="consejo consejo--suave">
              <IconoAdmin name="descargar" size={18} />
              <p><b>Ficha técnica en PDF.</b> Se genera sola con la plantilla de Neucast cada vez que se publica, con lo que capturaste aquí. <a class="enlace" href="#" target="_blank" rel="noopener" data-ficha-pdf hidden>Ver la actual</a></p>
            </div>
          </div>
        </section>
      </div>
    </div>

    <div class="guardar" data-guardar-barra>
      <span class="guardar-nota" data-pie-estado></span>
      <a class="boton boton--texto" href={`${base}piezas/`} data-cancelar>Cancelar</a>
      <button class="boton" type="button" data-guardar-borrador>Guardar como borrador</button>
      <button class="boton boton--primario" type="submit" data-guardar><IconoAdmin name="check" size={16} />Guardar</button>
    </div>
  </form>

  <Modal id="modal-foto" titulo="Agregar fotos" texto="Sube archivos desde tu equipo o escribe la ruta de una foto que ya esté en el sitio.">
    <button class="soltar" type="button" data-zona-archivo>
      <IconoAdmin name="subir" size={26} />
      <b>Arrastra aquí las fotos o haz clic para elegirlas</b>
      <span class="t-mini">PNG o WebP con fondo transparente para la principal; JPG para las de ambiente</span>
    </button>
    <div class="campo">
      <div class="campo-etiqueta"><label for="ruta-foto">O la ruta en el sitio</label></div>
      <input class="control mono" id="ruta-foto" type="text" placeholder="Ej. /img/products/silla-operativa-orbita.png" spellcheck="false" />
    </div>
    <Fragment slot="pie">
      <button class="boton" type="button" data-cierra-modal>Cancelar</button>
      <button class="boton boton--primario" type="button" data-agregar-ruta>Agregar la ruta</button>
    </Fragment>
  </Modal>

  <Modal id="modal-video" titulo="Video de la pieza" texto="Sube el archivo o escribe la ruta de un video que ya esté en el sitio.">
    <button class="soltar" type="button" data-zona-video>
      <IconoAdmin name="subir" size={26} />
      <b>Arrastra aquí el video o haz clic para elegirlo</b>
      <span class="t-mini">MP4, corto y sin sonido</span>
    </button>
    <div class="campo">
      <div class="campo-etiqueta"><label for="ruta-video">O la ruta en el sitio</label></div>
      <input class="control mono" id="ruta-video" type="text" placeholder="Ej. /video/silla-orbita.mp4" spellcheck="false" />
    </div>
    <Fragment slot="pie">
      <button class="boton" type="button" data-cierra-modal>Cancelar</button>
      <button class="boton boton--primario" type="button" data-video-ruta>Usar la ruta</button>
    </Fragment>
  </Modal>

  <Modal id="modal-foto-detalle" titulo="Foto" ancho>
    <div class="detalle-foto"><img data-detalle-img alt="" /></div>
    <p class="consejo consejo--alerta" data-detalle-aviso hidden>Esta foto no tiene fondo transparente: sobre el gris del sitio se verá como un cuadro. Para la principal conviene un recorte en PNG o WebP.</p>
    <div class="campo">
      <div class="campo-etiqueta"><label for="detalle-alt">Texto alternativo</label></div>
      <input class="control" id="detalle-alt" type="text" data-detalle-alt />
      <p class="campo-ayuda">Qué se ve en la foto, para quien no la ve y para Google.</p>
    </div>
    <Fragment slot="pie">
      <button class="boton boton--texto boton--texto-peligro izquierda" type="button" data-detalle-quitar><IconoAdmin name="basura" size={16} />Eliminar foto</button>
      <button class="boton" type="button" data-detalle-principal>Hacer principal</button>
      <button class="boton boton--primario" type="button" data-detalle-listo>Listo</button>
    </Fragment>
  </Modal>

  <Modal id="modal-combina" titulo="Piezas que combinan" texto="Elige hasta 8. Salen en ese orden en el carrusel de la ficha." ancho>
    <div class="control--con-icono">
      <IconoAdmin name="buscar" />
      <input class="control" type="search" placeholder="Busca por nombre, tipo o categoría" data-combina-buscar aria-label="Buscar piezas" />
    </div>
    <ul class="lista-filas lista-filas--compacta lista-filas--elegir" data-combina-lista></ul>
    <Fragment slot="pie">
      <span class="izquierda t-mini" data-combina-cuenta></span>
      <button class="boton" type="button" data-cierra-modal>Cancelar</button>
      <button class="boton boton--primario" type="button" data-combina-usar>Usar estas piezas</button>
    </Fragment>
  </Modal>

  <Modal id="modal-salir" titulo="Tienes cambios sin guardar" texto="Si sales ahora se pierden.">
    <Fragment slot="pie">
      <button class="boton boton--texto" type="button" data-salir-sin-guardar>Salir sin guardar</button>
      <button class="boton boton--primario" type="button" data-cierra-modal>Seguir editando</button>
    </Fragment>
  </Modal>
</Admin>

<script>
  import { obtener, listar, guardar } from "../../scripts/api.js";
  import { medio } from "../../scripts/medios.js";
  import { validarPieza, revisarTexto, revisarMedida, proponerSlug, limpiarSlug, acabadosDe } from "../../scripts/validar.js";
  import {
    piezaVacia, OBLIGATORIOS, MEDIDAS, MAX_COMBINA,
  } from "../../scripts/esquemas/pieza.js";
  import { opciones, nombreOpcion as nombreDe, listasDeChips, obligatoriasDe, medidasDe, partesDe, medida as medidaDe, esConteo, esObligatoria, CONTROL_PROPIO } from "../../scripts/listas.js";
  import { abrirModal, cerrarModal, avisar, escapar, fechaRelativa, ICONO_BASURA } from "../../scripts/ui.js";

  const base = import.meta.env.BASE_URL;
  const SITIO = (import.meta.env.PUBLIC_STG || "http://localhost:4321").replace(/\/+$/, "");
  const $ = (s, el = document) => el.querySelector(s);
  const $$ = (s, el = document) => [...el.querySelectorAll(s)];
  const form = $("[data-form]");
  const sinAcentos = (s) => (s || "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

  const slugInicial = new URLSearchParams(location.search).get("slug");
  let pieza = piezaVacia();
  let original = null; // el slug con el que se cargó, para renombrar
  let listas, categorias, todas = [];
  let hayCambios = false;
  let guardando = false;
  let verTodasMedidas = false;
  let verTodaConstruccion = false;

  const nombreOpcion = (id, valor) => nombreDe(listas, id, valor);
  const nombreCat = (slug) => categorias.find((c) => c.slug === slug)?.name || "";
  const X = '<svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="m5 5 10 10M15 5 5 15"/></svg>';

  /* ============================================
     Carga
     ============================================ */
  async function cargar() {
    [listas, categorias, todas] = await Promise.all([listar("listas"), listar("categorias"), listar("piezas")]);
    llenarSelectores();
    if (slugInicial) {
      try {
        pieza = { ...piezaVacia(), ...(await obtener("piezas", slugInicial)) };
        pieza.ficha = { ...piezaVacia().ficha, ...(pieza.ficha || {}) };
        original = pieza.slug;
      } catch {
        avisar("No existe esa pieza", { tipo: "error" });
        location.replace(`${base}piezas/`);
        return;
      }
    }
    pieza.acabados = acabadosDe(pieza).map((a) => ({ ...a }));
    pieza.alts = pieza.alts || [];
    pieza.combina = pieza.combina || [];
    pintar();
    cablear();
  }

  function llenarSelectores() {
    for (const c of categorias) $("#cat").insertAdjacentHTML("beforeend", `<option value="${escapar(c.slug)}">${escapar(c.name)}</option>`);
    for (const m of opciones(listas, "material")) $("#material").insertAdjacentHTML("beforeend", `<option value="${escapar(m.id)}">${escapar(m.nombre)}</option>`);
    for (const o of opciones(listas, "entrega")) $("#entrega").insertAdjacentHTML("beforeend", `<option value="${escapar(o.id)}">${escapar(o.nombre)}</option>`);
    $("[data-chips='espacios']").innerHTML = listas.espacios
      .map((e) => `<label class="chip"><input type="checkbox" name="espacios" value="${escapar(e.id)}" />${escapar(e.nombre)}</label>`)
      .join("");
  }

  /* ============================================
     Pintar el formulario con la pieza
     ============================================ */
  function pintar() {
    const nueva = !original;
    $("[data-cabecera-rotulo]").textContent = nueva ? "Nueva pieza" : pieza.tipo || "Pieza";
    $("[data-cabecera-titulo]").textContent = nueva ? "Nueva pieza" : pieza.nombre;
    $("[data-cabecera-nota]").textContent = nueva
      ? "Se guarda como borrador hasta que tenga todo lo obligatorio."
      : `${pieza.estado === "publicada" ? "Publicada" : "Borrador"} · cambiada ${fechaRelativa(pieza.actualizado)}`;
    $("[data-miga-actual]").textContent = nueva ? "Nueva pieza" : pieza.nombre;
    document.title = `${nueva ? "Nueva pieza" : pieza.nombre} · Administrador de Neucast`;
    const ver = $("[data-ver-pruebas]");
    ver.hidden = nueva || pieza.estado !== "publicada";
    ver.href = `${SITIO}/muebles/${pieza.cat}/${pieza.slug}/`;
    const pdf = $("[data-ficha-pdf]");
    pdf.hidden = nueva;
    pdf.href = `${SITIO}/fichas/neucast-${pieza.slug}.pdf`;

    form.nombre.value = pieza.nombre || "";
    form.tipo.value = pieza.tipo || "";
    form.cat.value = pieza.cat || "";
    form.slug.value = pieza.slug || "";
    form.alt.value = pieza.alt || "";
    form.material.value = pieza.material || "";
    form.material.dispatchEvent(new Event("change"));
    form.entrega.value = pieza.entrega || "";
    form.nuevo.checked = !!pieza.nuevo;
    form.destacada.checked = !!pieza.destacada;
    // un video subido en otra sesión de la simulación ya no existe
    if (pieza.video?.src?.startsWith("blob:")) pieza.video = null;
    $$("input[name='espacios']").forEach((i) => (i.checked = (pieza.espacios || []).includes(i.value)));
    $$("input[name='estado']").forEach((i) => (i.checked = i.value === (pieza.estado || "borrador")));
    form.resumen.value = pieza.ficha?.resumen || "";
    form.mecanismo.value = pieza.ficha?.mecanismo?.nombre || "";
    pintarFrases("destacados", pieza.ficha?.destacados || [], 3, ["Ej. Cabecera regulable en altura e inclinación", "Ej. Mecanismo synchro con cinco posiciones", "Ej. Soporte lumbar ajustable"]);
    pintarFrases("ajustes", pieza.ficha?.mecanismo?.ajustes || [], 8, ["Ej. Altura de asiento por pistón de gas", "Ej. Inclinación con bloqueo en cinco posiciones", "Ej. Tensión graduable por peso"]);
    pintarFrases("cuidados", pieza.ficha?.cuidados || [], 6, ["Ej. Aspirar la malla cada dos semanas", "Ej. Limpiar manchas con paño húmedo y jabón neutro", "Ej. Revisar el apriete de la base cada seis meses"]);
    pintarGaleria();
    pintarAcabados();
    pintarCategoria();
    pintarCombina();
    actualizarTodo();
  }

  /* ---------- Todo lo que depende de la categoría ---------- */
  function pintarCategoria() {
    pintarFiltrosCategoria();
    pintarMedidas();
    pintarConstruccion();
    pintarSugerenciasTipo();
    const silla = /sillas|cafeterias/.test(form.cat.value);
    $("[data-bloque-mecanismo]").hidden = !!form.cat.value && !silla && !form.mecanismo.value;
  }

  // Los tipos que ya existen, como atajos debajo del campo. No es un
  // desplegable: se puede escribir uno nuevo.
  function pintarSugerenciasTipo() {
    const caja = $("[data-sugerencias-tipo]");
    const cat = form.cat.value;
    const fuente = cat ? todas.filter((p) => p.cat === cat) : todas;
    const actual = form.tipo.value.trim();
    const tipos = [...new Set(fuente.map((p) => p.tipo).filter(Boolean))]
      .filter((t) => t !== actual && (!actual || sinAcentos(t).includes(sinAcentos(actual))))
      .sort((a, b) => a.localeCompare(b, "es"))
      .slice(0, 6);
    caja.hidden = !tipos.length;
    caja.innerHTML = `<span class="sugerencias-rotulo">${cat ? `Usados en ${escapar(nombreCat(cat))}` : "Usados en el catálogo"}</span>`
      + tipos.map((t) => `<button type="button" class="sugerencia" data-tipo="${escapar(t)}">${escapar(t)}</button>`).join("");
    $$("[data-tipo]", caja).forEach((b) =>
      b.addEventListener("click", () => {
        form.tipo.value = b.dataset.tipo;
        form.tipo.dispatchEvent(new Event("input", { bubbles: true }));
      })
    );
  }

  // Las listas de la categoría que se eligen con chips, en su orden: una
  // opción (radio) o varias (casillas), obligatorias o no, según sus datos.
  function pintarFiltrosCategoria() {
    const cat = form.cat.value;
    const caja = $("[data-filtros-categoria]");
    $("[data-nota-categoria]").hidden = !!cat;
    if (!cat) { caja.innerHTML = ""; return; }
    caja.innerHTML = `<div class="filtros-categoria">${listasDeChips(listas, cat)
      .map((l) => {
        const oblig = esObligatoria(l, cat);
        const multiple = l.seleccion === "varias";
        const valor = pieza[l.id];
        const chips = l.opciones
          .map((o) => {
            const marcado = multiple ? (valor || []).includes(o.id) : String(valor ?? "") === o.id;
            return `<label class="chip"><input type="${multiple ? "checkbox" : "radio"}" name="${escapar(l.id)}" value="${escapar(o.id)}" data-lista="${escapar(l.id)}" ${marcado ? "checked" : ""} />${escapar(o.nombre)}</label>`;
          })
          .join("");
        return `<div class="campo" data-campo="${escapar(l.id)}">
          <div class="campo-etiqueta"><span class="etiqueta">${escapar(l.nombre)}${oblig ? '<span class="obligatorio">*</span>' : ""}</span>${multiple ? '<span class="etiqueta-nota">las que apliquen</span>' : ""}<span class="etiqueta-acciones">${!multiple && !oblig ? `<button class="enlace-chico" type="button" data-quitar-radio="${escapar(l.id)}">Ninguno</button>` : ""}</span></div>
          <div class="chips">${chips || '<span class="t-mini">Esta lista todavía no tiene opciones.</span>'}</div>
          <p class="campo-error" data-error></p>
        </div>`;
      })
      .join("")}</div>`;
    $$("[data-quitar-radio]", caja).forEach((b) =>
      b.addEventListener("click", () => {
        $$(`input[name='${b.dataset.quitarRadio}']`, caja).forEach((i) => (i.checked = false));
        marcarCambio();
      })
    );
  }

  /* ---------- Las listas se administran en Listas ----------
     Si se cambian en otra pestaña, al volver a esta se releen. */
  document.addEventListener("visibilitychange", async () => {
    if (document.visibilityState !== "visible" || !listas) return;
    try {
      const nuevas = await listar("listas");
      if (JSON.stringify(nuevas) === JSON.stringify(listas)) return;
      pieza = { ...pieza, ...leer() };
      listas = nuevas;
      const mat = form.material.value, ent = form.entrega.value;
      $("#material").innerHTML = '<option value="" hidden>Elige el material principal</option>' + opciones(listas, "material").map((m) => `<option value="${escapar(m.id)}">${escapar(m.nombre)}</option>`).join("");
      $("#entrega").innerHTML = '<option value="" hidden>Elige en cuánto se entrega</option>' + opciones(listas, "entrega").map((o) => `<option value="${escapar(o.id)}">${escapar(o.nombre)}</option>`).join("");
      form.material.value = mat;
      form.entrega.value = ent;
      pintarAcabados();
      pintarCategoria();
      avisar("Las listas se actualizaron");
    } catch {}
  });

  /* ---------- Medidas en grupos ----------
     Qué medidas pide cada categoría, su unidad y su grupo vienen de las
     listas. Las de otras categorías quedan detrás de "Más medidas"; una
     medida con dato capturado se enseña siempre. */
  function pintarMedidas() {
    const caja = $("[data-medidas]");
    const actuales = { ...(pieza.ficha?.medidas || {}), ...leerPares("medida") };
    const propias = new Set(medidasDe(listas, form.cat.value).map((m) => m.id));
    const visibles = listas.medidas.filter((m) => verTodasMedidas || propias.has(m.id) || actuales[m.id]);
    caja.innerHTML = listas.gruposMedida
      .map((g) => ({ g, ms: visibles.filter((m) => m.grupo === g.id) }))
      .filter(({ ms }) => ms.length)
      .map(({ g, ms }) => `
        <div class="grupo-medidas">
          <span class="grupo-rotulo">${escapar(g.nombre)}</span>
          <div class="grupo-lista grupo-lista--dos">${ms
            .map((m) => `<label class="fila-lista"><span class="fila-lista-etiqueta">${escapar(m.nombre)}</span><input class="fila-lista-control fila-lista-control--numero" data-medida="${escapar(m.id)}" type="text" value="${escapar(aCampo(m.id, actuales[m.id]))}" placeholder="${escapar(m.ejemplo || "")}" inputmode="${esConteo(m) ? "numeric" : "decimal"}" autocomplete="off" />${m.unidad ? `<span class="fila-lista-unidad">${escapar(m.unidad)}</span>` : ""}</label>`)
            .join("")}</div>
        </div>`)
      .join("");
    const ocultas = listas.medidas.length - visibles.length;
    const mas = $("[data-mas-medidas]");
    mas.hidden = !ocultas && !verTodasMedidas;
    mas.textContent = verTodasMedidas ? "Solo las de esta categoría" : `Más medidas (${ocultas})`;
  }

  // Lo guardado ("45 a 55 cm") se edita como "45-55"; al guardar regresa
  // a su forma con la unidad.
  function aCampo(k, valor) {
    if (!valor) return "";
    const u = medidaDe(listas, k)?.unidad;
    const sinUnidad = u ? String(valor).replace(new RegExp("\\s*" + u + "\\.?\\s*$", "i"), "") : String(valor);
    return sinUnidad.replace(/\s+a\s+/g, "-").trim();
  }
  function aDato(k, campo) {
    const v = (campo || "").trim().replace(/-+$/, "").replace(/^-+/, "");
    if (!v) return "";
    const partes = v.split("-").map((x) => x.trim()).filter(Boolean);
    const u = medidaDe(listas, k)?.unidad;
    const unidad = u ? ` ${u}` : "";
    return `${partes.join(" a ")}${unidad}`;
  }
  // Solo números: enteros en los conteos; decimales y un guion de rango en
  // lo demás. Lo que no cabe ahí ni siquiera se escribe.
  function filtrarMedida(inp) {
    const k = inp.dataset.medida;
    let v = inp.value;
    const m = medidaDe(listas, k);
    if (esConteo(m) && !m?.rango) v = v.replace(/\D/g, "");
    else if (!m?.rango) v = v.replace(/,/g, ".").replace(/[^\d.]/g, "").replace(/(\..*)\./g, "$1");
    else {
      v = esConteo(m) ? v.replace(/[^\d\-]/g, "") : v.replace(/,/g, ".").replace(/[^\d.\-]/g, "");
      const [a, ...resto] = v.split("-");
      v = resto.length ? `${a}-${resto.join("").replace(/-/g, "")}` : a;
      v = v.split("-").map((n) => n.replace(/(\..*)\./g, "$1")).join("-");
    }
    if (v !== inp.value) inp.value = v;
  }

  function pintarConstruccion() {
    const caja = $("[data-partes]");
    const actuales = { ...(pieza.ficha?.construccion || {}), ...leerPares("construccion") };
    const propias = new Set(partesDe(listas, form.cat.value).map((p) => p.id));
    const visibles = listas.partes.filter((p) => verTodaConstruccion || propias.has(p.id) || actuales[p.id]);
    caja.innerHTML = visibles
      .map((p) => `<label class="fila-lista"><span class="fila-lista-etiqueta fila-lista-etiqueta--fija">${escapar(p.nombre)}</span><input class="fila-lista-control fila-lista-control--izq" data-construccion="${escapar(p.id)}" type="text" value="${escapar(actuales[p.id] || "")}" placeholder="${p.ejemplo ? `Ej. ${escapar(p.ejemplo)}` : ""}" /></label>`)
      .join("");
    const ocultas = listas.partes.length - visibles.length;
    const mas = $("[data-mas-construccion]");
    mas.hidden = !ocultas && !verTodaConstruccion;
    mas.textContent = verTodaConstruccion ? "Solo las de esta categoría" : `Más partes (${ocultas})`;
  }

  /* ---------- Acabados: nombre comercial y grupo de color ---------- */
  function pintarAcabados() {
    const caja = $("[data-acabados]");
    const filas = pieza.acabados.length ? pieza.acabados : [{ nombre: "", grupo: "" }];
    caja.innerHTML = filas
      .map((a, i) => `<div class="acabado" data-i="${i}">
          <div class="acabado-cabeza">
            <input class="fila-lista-control fila-lista-control--izq" type="text" data-acabado-nombre value="${escapar(a.nombre || "")}" placeholder="Nombre comercial, ej. Plumbago" aria-label="Nombre comercial del acabado ${i + 1}" />
            <button class="fila-lista-quitar" type="button" data-quitar-acabado aria-label="Quitar este acabado">${X}</button>
          </div>
          <div class="acabado-grupos" role="radiogroup" aria-label="Grupo de color del acabado ${i + 1}">
            ${opciones(listas, "colores").map((g) => `<label class="color" title="${escapar(g.nombre)}">
              <input type="radio" name="grupo-${i}" value="${escapar(g.id)}" data-acabado-grupo ${g.id === a.grupo ? "checked" : ""} aria-label="${escapar(g.nombre)}" />
              <span class="color-muestra" style="background:${escapar(g.hex)}"></span>
            </label>`).join("")}
            <span class="acabado-grupo-nombre" data-grupo-nombre>${escapar(opciones(listas, "colores").find((g) => g.id === a.grupo)?.nombre || "Elige su color")}</span>
          </div>
        </div>`)
      .join("");
    $$(".acabado", caja).forEach((fila) => {
      const i = +fila.dataset.i;
      $$("[data-acabado-grupo]", fila).forEach((r) =>
        r.addEventListener("change", () => {
          $("[data-grupo-nombre]", fila).textContent = opciones(listas, "colores").find((g) => g.id === r.value)?.nombre || "";
        })
      );
      $("[data-quitar-acabado]", fila).addEventListener("click", () => {
        pieza.acabados = leerAcabados().filter((_, j) => j !== i);
        pintarAcabados();
        marcarCambio();
      });
    });
  }
  const leerAcabados = () =>
    $$(".acabado")
      .map((f) => ({ nombre: $("[data-acabado-nombre]", f).value.trim(), grupo: $("[data-acabado-grupo]:checked", f)?.value || "" }))
      .filter((a) => a.nombre || a.grupo);

  /* ---------- Piezas que combinan ---------- */
  function pintarCombina() {
    const caja = $("[data-combina]");
    const elegidas = pieza.combina.map((s) => todas.find((p) => p.slug === s)).filter(Boolean);
    caja.innerHTML = elegidas
      .map((p, i) => `<div class="combina-pieza">
        <span class="miniatura">${p.img?.[0] ? `<img src="${escapar(medio(p.img[0]))}" alt="" loading="lazy" />` : ""}</span>
        <span class="renglon-texto"><strong>${escapar(p.nombre)}</strong><small>${escapar(p.tipo)}</small></span>
        <button class="boton boton--chico boton--icono boton--texto" type="button" data-quitar-combina="${i}" aria-label="Quitar ${escapar(p.nombre)}">${X}</button>
      </div>`)
      .join("");
    $("[data-contador-combina]").textContent = elegidas.length ? `${elegidas.length} de ${MAX_COMBINA}` : "automáticas";
    $("[data-combina-nota]").hidden = elegidas.length > 0;
    $("[data-abre-combina] span").textContent = elegidas.length ? "Cambiar las piezas" : "Elegir piezas";
    $$("[data-quitar-combina]", caja).forEach((b) =>
      b.addEventListener("click", () => {
        pieza.combina.splice(+b.dataset.quitarCombina, 1);
        pintarCombina();
        marcarCambio();
      })
    );
  }

  let seleccion = [];
  function pintarListaCombina() {
    const t = sinAcentos($("[data-combina-buscar]").value.trim());
    const propia = original || form.slug.value;
    const candidatas = todas
      .filter((p) => p.slug !== propia)
      .filter((p) => !t || sinAcentos(`${p.nombre} ${p.tipo} ${nombreCat(p.cat)}`).includes(t))
      .sort((a, b) => Number(b.cat === form.cat.value) - Number(a.cat === form.cat.value));
    $("[data-combina-lista]").innerHTML = candidatas
      .map((p) => {
        const n = seleccion.indexOf(p.slug);
        return `<li><label class="renglon renglon--elegir">
          <input type="checkbox" value="${escapar(p.slug)}" ${n >= 0 ? "checked" : ""} />
          <span class="elegir-marca" aria-hidden="true">${n >= 0 ? n + 1 : ""}</span>
          <span class="miniatura">${p.img?.[0] ? `<img src="${escapar(medio(p.img[0]))}" alt="" loading="lazy" />` : ""}</span>
          <span class="renglon-texto"><strong>${escapar(p.nombre)}</strong><small>${escapar(p.tipo)} · ${escapar(nombreCat(p.cat))}</small></span>
        </label></li>`;
      })
      .join("") || `<li class="renglon-mas">Ninguna pieza coincide.</li>`;
    $("[data-combina-cuenta]").textContent = `${seleccion.length} de ${MAX_COMBINA} elegidas`;
    $$("[data-combina-lista] input").forEach((inp) =>
      inp.addEventListener("change", () => {
        if (inp.checked) {
          if (seleccion.length >= MAX_COMBINA) {
            inp.checked = false;
            return avisar(`Caben ${MAX_COMBINA} como máximo`, { tipo: "alerta" });
          }
          seleccion.push(inp.value);
        } else {
          seleccion = seleccion.filter((s) => s !== inp.value);
        }
        pintarListaCombina();
      })
    );
  }

  /* ---------- Listas de frases ---------- */
  function pintarFrases(nombre, valores, max, ejemplos = []) {
    const caja = $(`[data-frases='${nombre}']`);
    const filas = [...valores];
    if (filas.length < max) filas.push("");
    caja.innerHTML = filas
      .map((v, i) => `<label class="fila-lista fila-lista--frase">
        <span class="fila-lista-n">${i + 1}</span>
        <input class="fila-lista-control fila-lista-control--izq" type="text" data-frase="${nombre}" value="${escapar(v)}" placeholder="${escapar(ejemplos[i] || "Ej. Otra frase corta")}" />
        <button class="fila-lista-quitar" type="button" data-quitar-frase aria-label="Quitar" ${v ? "" : "hidden"}>${X}</button>
      </label>`)
      .join("");
    $$("[data-quitar-frase]", caja).forEach((b, i) =>
      b.addEventListener("click", (e) => {
        e.preventDefault();
        pintarFrases(nombre, leerFrases(nombre).filter((_, j) => j !== i), max, ejemplos);
        marcarCambio();
      })
    );
    $$("[data-frase]", caja).forEach((inp) =>
      inp.addEventListener("input", () => {
        // al escribir en la última fila libre aparece otra, hasta el máximo
        const inputs = $$("[data-frase]", caja);
        if (inp === inputs[inputs.length - 1] && inp.value && inputs.length < max) {
          const actuales = leerFrases(nombre);
          pintarFrases(nombre, actuales, max, ejemplos);
          const el = $$("[data-frase]", caja)[actuales.length - 1];
          el?.focus();
          el?.setSelectionRange(el.value.length, el.value.length);
        }
      })
    );
  }
  const leerFrases = (nombre) => $$(`[data-frase='${nombre}']`).map((i) => i.value.trim()).filter(Boolean);
  const leerPares = (attr) =>
    Object.fromEntries(
      $$(`[data-${attr}]`)
        .map((i) => [i.dataset[attr], attr === "medida" ? aDato(i.dataset.medida, i.value) : i.value.trim()])
        .filter(([, v]) => v)
    );

  /* ---------- Galería ----------
     La principal va grande; las demás, en miniaturas que caben de a muchas
     (una pieza puede traer veinte). Cada foto se abre en un modal para su
     texto alternativo, hacerla principal o quitarla. */
  const sinTransparencia = (ruta) => /\.jpe?g($|\?)/i.test(ruta) || /^data:image\/jpe?g/i.test(ruta);
  const ESTRELLA = '<svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="m10 2.5 2.3 4.9 5.2.6-3.9 3.6 1.1 5.2L10 14.1l-4.7 2.7 1.1-5.2L2.5 8l5.2-.6L10 2.5Z"/></svg>';
  function pintarGaleria() {
    const caja = $("[data-galeria]");
    const fotos = pieza.img || [];
    const conAlt = (i) => (i === 0 ? !!form.alt.value.trim() : !!(pieza.alts?.[i] || "").trim());
    caja.innerHTML =
      fotos
        .map((ruta, i) => `
      <button type="button" class="foto${i === 0 ? " foto--principal" : ""}" draggable="true" data-i="${i}" aria-label="${i === 0 ? "Foto principal" : `Foto ${i + 1}`}: abrir">
        <span class="foto-marco">${ruta ? `<img src="${escapar(medio(ruta))}" alt="" draggable="false" loading="lazy" />` : ""}</span>
        <span class="foto-etiqueta">${i === 0 ? `${ESTRELLA}Principal` : i + 1}</span>
        ${i === 0 && sinTransparencia(ruta) ? '<span class="foto-aviso">Sin fondo transparente</span>' : ""}
        ${i > 0 && !conAlt(i) ? '<span class="foto-falta" title="Sin texto alternativo">Sin descripción</span>' : ""}
      </button>`)
        .join("") +
      `<button class="foto-agregar${fotos.length ? "" : " foto-agregar--primera"}" type="button" data-abrir-foto>
        <span class="foto-agregar-icono"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 4v12M4 10h12"/></svg></span>
        <b>${fotos.length ? "Agregar" : "Agregar la foto principal"}</b>
        ${fotos.length ? "" : '<span class="t-mini">Un recorte con fondo transparente</span>'}
      </button>`;
    $("[data-fotos-cuenta]").textContent = fotos.length ? `${fotos.length} ${fotos.length === 1 ? "foto" : "fotos"}` : "";
    pintarAmbiente();
    pintarVideo();

    $$(".foto", caja).forEach((el) => el.addEventListener("click", () => abrirFoto(+el.dataset.i)));
    $("[data-abrir-foto]", caja).addEventListener("click", () => {
      $("#ruta-foto").value = "";
      abrirModal("modal-foto");
    });

    // arrastrar para ordenar
    let desde = null;
    $$(".foto", caja).forEach((el) => {
      el.addEventListener("dragstart", (e) => {
        desde = +el.dataset.i;
        el.classList.add("arrastrando");
        e.dataTransfer.effectAllowed = "move";
      });
      el.addEventListener("dragend", () => {
        el.classList.remove("arrastrando");
        $$(".foto.destino", caja).forEach((f) => f.classList.remove("destino"));
      });
      el.addEventListener("dragover", (e) => { e.preventDefault(); el.classList.add("destino"); });
      el.addEventListener("dragleave", () => el.classList.remove("destino"));
      el.addEventListener("drop", (e) => {
        e.preventDefault();
        const hasta = +el.dataset.i;
        if (desde != null && desde !== hasta) mover(desde, hasta);
      });
    });
  }

  // El modal de una foto: vista grande, su texto alternativo y sus acciones.
  let fotoAbierta = null;
  function abrirFoto(i) {
    fotoAbierta = i;
    const ruta = pieza.img[i];
    const principal = i === 0;
    $("[data-detalle-img]").src = medio(ruta);
    $("[data-detalle-img]").classList.toggle("recorte", principal);
    $("#modal-foto-detalle [data-titulo]").textContent = principal ? "Foto principal" : `Foto ${i + 1} de ${pieza.img.length}`;
    const alt = $("[data-detalle-alt]");
    alt.value = principal ? form.alt.value : pieza.alts?.[i] || "";
    alt.placeholder = principal ? "Ej. Silla operativa Órbita negra con respaldo de malla" : `Ej. ${pieza.nombre || "La silla"} en una sala de juntas`;
    $("[data-detalle-principal]").hidden = principal;
    $("[data-detalle-aviso]").hidden = !(principal && sinTransparencia(ruta));
    abrirModal("modal-foto-detalle");
  }
  function guardarAltAbierta() {
    if (fotoAbierta == null) return;
    const v = $("[data-detalle-alt]").value;
    if (fotoAbierta === 0) {
      if (form.alt.value !== v) { form.alt.value = v; marcarCambio(); }
    } else if ((pieza.alts[fotoAbierta] || "") !== v) {
      pieza.alts[fotoAbierta] = v;
      marcarCambio();
    }
  }
  $("[data-detalle-listo]").addEventListener("click", () => {
    guardarAltAbierta();
    cerrarModal("modal-foto-detalle");
    pintarGaleria();
  });
  $("#modal-foto-detalle").addEventListener("close", () => { guardarAltAbierta(); pintarGaleria(); fotoAbierta = null; });
  $("[data-detalle-principal]").addEventListener("click", () => {
    guardarAltAbierta();
    const i = fotoAbierta;
    cerrarModal("modal-foto-detalle");
    fotoAbierta = null;
    mover(i, 0);
    avisar("Ahora es la foto principal. Revisa su texto alternativo.");
  });
  $("[data-detalle-quitar]").addEventListener("click", () => {
    const i = fotoAbierta;
    fotoAbierta = null;
    cerrarModal("modal-foto-detalle");
    pieza.img.splice(i, 1);
    pieza.alts.splice(i, 1);
    pintarGaleria();
    marcarCambio();
  });

  function mover(desde, hasta) {
    const [f] = pieza.img.splice(desde, 1);
    pieza.img.splice(hasta, 0, f);
    const [a] = pieza.alts.splice(desde, 1);
    pieza.alts.splice(hasta, 0, a);
    pintarGaleria();
    marcarCambio();
  }

  /* ---------- Foto de ambiente ----------
     Se elige de la galería (menos la principal, que es un recorte). Si no se
     elige, el sitio usa la segunda foto; si no hay, la de la categoría. */
  function pintarAmbiente() {
    const caja = $("[data-ambiente]");
    const opciones = (pieza.img || []).map((ruta, i) => ({ ruta, i })).filter(({ i }) => i > 0);
    const elegida = pieza.ambiente && pieza.img.includes(pieza.ambiente) ? pieza.ambiente : opciones[0]?.ruta;
    caja.innerHTML = opciones
      .map(({ ruta, i }) => `<button type="button" class="ambiente-foto${ruta === elegida ? " activa" : ""}" role="radio" aria-checked="${ruta === elegida}" data-ruta="${escapar(ruta)}" aria-label="Foto ${i + 1}">
        <img src="${escapar(medio(ruta))}" alt="" loading="lazy" draggable="false" />
        <span class="ambiente-marca" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m4.5 10.5 3.5 3.5 7.5-8"/></svg></span>
      </button>`)
      .join("");
    $("[data-ambiente-nota]").textContent = opciones.length
      ? "Elige la que mejor enseña la pieza en un espacio real. Va de orilla a orilla: que sea horizontal y con buena luz."
      : "Agrega a la galería una foto de la pieza en un espacio. Mientras no haya, sale la foto de la categoría.";
    $$(".ambiente-foto", caja).forEach((b) => b.addEventListener("click", () => {
      pieza.ambiente = b.dataset.ruta;
      pintarAmbiente();
      marcarCambio();
    }));
  }

  /* ---------- Video ----------
     En la simulación un archivo se queda en esta sesión (no cabe en el
     localStorage); con la API real se sube como las fotos. */
  function pintarVideo() {
    const caja = $("[data-video]");
    const v = pieza.video;
    caja.innerHTML = v?.src
      ? `<div class="video-pieza-ficha">
          <video src="${escapar(medio(v.src))}" muted loop playsinline autoplay preload="metadata"></video>
          <div class="video-pieza-datos"><b>${escapar(v.nombre || v.src.split("/").pop())}</b><span class="t-mini">Va después de las fotos</span></div>
          <button class="boton boton--texto-peligro boton--chico" type="button" data-quitar-video>${ICONO_BASURA(15)}Eliminar</button>
        </div>`
      : `<button class="boton boton--suave boton--agregar" type="button" data-agregar-video><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="2.5" y="5" width="11" height="10" rx="2"/><path d="m13.5 9 4-2.5v7l-4-2.5Z"/></svg><span>Agregar video</span></button>`;
    $("[data-agregar-video]", caja)?.addEventListener("click", () => {
      $("#ruta-video").value = "";
      abrirModal("modal-video");
    });
    $("[data-quitar-video]", caja)?.addEventListener("click", () => {
      pieza.video = null;
      pintarVideo();
      marcarCambio();
    });
  }
  const archivoVideo = $("[data-archivo-video]");
  const zonaVideo = $("[data-zona-video]");
  const usarVideo = (video) => {
    pieza.video = video;
    cerrarModal("modal-video");
    pintarVideo();
    marcarCambio();
    avisar("Video agregado");
  };
  const videoDeArchivo = (f) => {
    if (!f || !f.type.startsWith("video/")) return avisar("Ese archivo no es un video", { tipo: "error" });
    usarVideo({ src: URL.createObjectURL(f), nombre: f.name });
  };
  zonaVideo.addEventListener("click", () => archivoVideo.click());
  zonaVideo.addEventListener("dragover", (e) => { e.preventDefault(); zonaVideo.classList.add("sobre"); });
  zonaVideo.addEventListener("dragleave", () => zonaVideo.classList.remove("sobre"));
  zonaVideo.addEventListener("drop", (e) => { e.preventDefault(); zonaVideo.classList.remove("sobre"); videoDeArchivo(e.dataTransfer.files[0]); });
  archivoVideo.addEventListener("change", () => { videoDeArchivo(archivoVideo.files[0]); archivoVideo.value = ""; });
  $("[data-video-ruta]").addEventListener("click", () => {
    const ruta = $("#ruta-video").value.trim();
    if (!ruta) return $("#ruta-video").focus();
    usarVideo({ src: ruta.startsWith("/") || /^https?:/.test(ruta) ? ruta : `/${ruta}` });
  });

  // Subir archivos: en la simulación se guardan achicados como data URL para
  // no llenar el localStorage; la API real los recibe como archivo.
  const archivo = $("[data-archivo]");
  const zona = $("[data-zona-archivo]");
  zona.addEventListener("click", () => archivo.click());
  zona.addEventListener("dragover", (e) => { e.preventDefault(); zona.classList.add("sobre"); });
  zona.addEventListener("dragleave", () => zona.classList.remove("sobre"));
  zona.addEventListener("drop", (e) => {
    e.preventDefault();
    zona.classList.remove("sobre");
    agregarArchivos(e.dataTransfer.files);
  });
  archivo.addEventListener("change", () => { agregarArchivos(archivo.files); archivo.value = ""; });

  async function agregarArchivos(archivos) {
    let n = 0;
    for (const f of archivos) {
      if (!f.type.startsWith("image/")) continue;
      try {
        pieza.img.push(await achicar(f));
        n++;
      } catch {
        avisar(`No se pudo leer ${f.name}`, { tipo: "error" });
      }
    }
    cerrarModal("modal-foto");
    pintarGaleria();
    marcarCambio();
    if (n) avisar(n === 1 ? "Foto agregada" : `${n} fotos agregadas`);
  }
  function achicar(f) {
    return new Promise((ok, mal) => {
      const img = new Image();
      const url = URL.createObjectURL(f);
      img.onload = () => {
        const k = Math.min(1, 1000 / Math.max(img.width, img.height));
        const c = document.createElement("canvas");
        c.width = Math.round(img.width * k);
        c.height = Math.round(img.height * k);
        c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
        URL.revokeObjectURL(url);
        ok(c.toDataURL(f.type === "image/jpeg" ? "image/jpeg" : "image/png", 0.82));
      };
      img.onerror = mal;
      img.src = url;
    });
  }
  $("[data-agregar-ruta]").addEventListener("click", () => {
    const ruta = $("#ruta-foto").value.trim();
    if (!ruta) return $("#ruta-foto").focus();
    pieza.img.push(ruta.startsWith("/") || /^https?:/.test(ruta) ? ruta : `/${ruta}`);
    cerrarModal("modal-foto");
    pintarGaleria();
    marcarCambio();
  });
  $("#ruta-foto").addEventListener("keydown", (e) => e.key === "Enter" && (e.preventDefault(), $("[data-agregar-ruta]").click()));

  /* ============================================
     Leer el formulario a la pieza
     ============================================ */
  function leer() {
    const radio = (n) => form.querySelector(`input[name='${n}']:checked`)?.value ?? null;
    const marcados = (n) => $$(`input[name='${n}']:checked`).map((i) => i.value);
    const ajustes = leerFrases("ajustes");
    const mecNombre = form.mecanismo.value.trim();
    const acabados = leerAcabados();
    return {
      ...pieza,
      nombre: form.nombre.value.trim(),
      tipo: form.tipo.value.trim(),
      cat: form.cat.value,
      slug: limpiarSlug(form.slug.value),
      alt: form.alt.value.trim(),
      material: form.material.value,
      entrega: form.entrega.value,
      acabados,
      colores: [...new Set(acabados.map((a) => a.grupo).filter(Boolean))],
      espacios: marcados("espacios"),
      nuevo: form.nuevo.checked,
      destacada: form.destacada.checked,
      ambiente: pieza.ambiente && pieza.img.includes(pieza.ambiente) ? pieza.ambiente : "",
      video: pieza.video || null,
      // cada lista de chips con su id; las que no aplican a la categoría se vacían
      ...Object.fromEntries(
        listas.listas
          .filter((l) => !CONTROL_PROPIO.has(l.id))
          .map((l) => [l.id, l.seleccion === "varias" ? marcados(l.id) : radio(l.id) || (l.id === "uso" ? "" : null)])
      ),
      estado: radio("estado") || "borrador",
      ficha: {
        ...pieza.ficha,
        resumen: form.resumen.value.trim(),
        destacados: leerFrases("destacados"),
        medidas: { ...pieza.ficha?.medidas, ...Object.fromEntries($$("[data-medida]").map((i) => [i.dataset.medida, aDato(i.dataset.medida, i.value)])) },
        construccion: { ...pieza.ficha?.construccion, ...Object.fromEntries($$("[data-construccion]").map((i) => [i.dataset.construccion, i.value.trim()])) },
        mecanismo: mecNombre || ajustes.length ? { nombre: mecNombre, ajustes } : null,
        cuidados: leerFrases("cuidados"),
      },
    };
  }
  // quita las claves vacías de medidas y construcción antes de guardar
  const limpiarFicha = (f) => ({
    ...f,
    medidas: Object.fromEntries(Object.entries(f.medidas || {}).filter(([, v]) => v)),
    construccion: Object.fromEntries(Object.entries(f.construccion || {}).filter(([, v]) => v)),
  });

  /* ============================================
     Validación, avance y vista en Google
     ============================================ */
  function ponerError(campo, mensaje) {
    const caja = $(`[data-campo='${campo}']`);
    if (!caja) return;
    if (mensaje) {
      caja.dataset.error = "1";
      const e = caja.querySelector("[data-error]");
      if (e) e.textContent = mensaje;
    } else {
      delete caja.dataset.error;
    }
  }
  const limpiarErrores = () => $$("[data-campo]").forEach((c) => delete c.dataset.error);
  function mostrarErrores(errores) {
    limpiarErrores();
    for (const [campo, msg] of Object.entries(errores)) ponerError(campo, msg);
    actualizarIndice(errores);
    const primero = $("[data-campo][data-error]");
    if (primero) {
      primero.scrollIntoView({ behavior: "smooth", block: "center" });
      primero.querySelector("input,select,textarea")?.focus({ preventScroll: true });
    }
  }
  const SECCION_DE = {
    nombre: "identidad", tipo: "identidad", cat: "identidad", slug: "identidad",
    img: "fotos", alt: "fotos",
    acabados: "clasificacion",
    resumen: "ficha",
  };
  // todo lo que no está arriba es una lista: va en Clasificación
  const seccionDe = (k) => SECCION_DE[k] || "clasificacion";
  const CON_OBLIGATORIOS = new Set([...Object.values(SECCION_DE), "clasificacion"]);
  function actualizarIndice(erroresMostrados) {
    const datos = leer();
    const todos = validarPieza(datos, listas);
    const conError = new Set(Object.keys(erroresMostrados || {}).map(seccionDe));
    const incompletas = new Set(Object.keys(todos).map(seccionDe));
    $$("[data-indice]").forEach((a) => {
      const id = a.dataset.indice;
      a.classList.toggle("con-error", conError.has(id));
      a.classList.toggle("completa", CON_OBLIGATORIOS.has(id) && !conError.has(id) && !incompletas.has(id));
    });

    // el avance: cuántos obligatorios (de todas y de la categoría) ya están
    const requeridos = [...OBLIGATORIOS, ...obligatoriasDe(listas, datos.cat).filter((id) => id !== "colores")];
    const faltan = requeridos.filter((k) => todos[k]);
    const hechos = requeridos.length - faltan.length;
    $("[data-avance-cuenta]").textContent = `${hechos} de ${requeridos.length}`;
    $("[data-avance-barra]").style.width = `${(hechos / requeridos.length) * 100}%`;
    $("[data-avance]").classList.toggle("avance--lista", !faltan.length);
    $("[data-avance-nota]").textContent = faltan.length
      ? `Falta${faltan.length === 1 ? " un dato" : `n ${faltan.length} datos`}. Mientras, se puede guardar como borrador.`
      : "Tiene todo lo obligatorio. Ya se puede publicar.";
  }

  function actualizarContadores() {
    for (const campo of Object.keys(MEDIDAS)) {
      const el = $(`[data-contador='${campo}']`);
      const inp = form[campo];
      if (!el || !inp) continue;
      const n = inp.value.trim().length;
      const m = MEDIDAS[campo];
      el.textContent = n ? `${n} / ${m.max}` : `${m.min} a ${m.max}`;
      el.classList.toggle("fuera", n > 0 && (n < m.min || n > m.max));
    }
    const a = leerAcabados().filter((x) => x.grupo).length;
    $("[data-contador-acabados]").textContent = a ? `${a} ${a === 1 ? "acabado" : "acabados"}` : "al menos uno";
  }

  // Lo mismo que arma la ficha del sitio (sitio/src/pages/muebles/[categoria]/[pieza].astro).
  function actualizarGoogle() {
    const d = leer();
    const tipo = d.tipo || "Tipo";
    const nombre = d.nombre || "Nombre";
    const titulo = `${tipo} ${nombre} | ${nombreCat(d.cat) || "Categoría"} | Neucast`;
    const desc = [
      `${tipo} ${nombre}.`,
      d.ficha.destacados[0] ? `${d.ficha.destacados[0]}.` : "",
      d.entrega ? `${nombreOpcion("entrega", d.entrega)}.` : "",
      "Envío e instalación en todo México.",
    ].filter(Boolean).join(" ");
    $("[data-google-url]").textContent = `neucast.com.mx › muebles › ${d.cat || "…"} › ${d.slug || "…"}`;
    $("[data-google-titulo]").textContent = titulo;
    $("[data-google-desc]").textContent = desc;
    const avisos = [];
    if (titulo.length > 65) avisos.push(`el título mide ${titulo.length} caracteres y Google lo corta cerca de 65`);
    if (desc.length > 160) avisos.push(`la descripción mide ${desc.length} y Google la corta cerca de 160`);
    if (desc.length < 70) avisos.push(`la descripción es corta (${desc.length}); un primer destacado la completa`);
    const nota = $("[data-google-nota]");
    nota.classList.toggle("campo-ayuda--alerta", avisos.length > 0);
    nota.textContent = avisos.length
      ? `Ojo: ${avisos.join("; ")}.`
      : "El título y la descripción salen de una fórmula con el tipo, el nombre, la categoría, el primer destacado y la disponibilidad. Así todo el catálogo queda parejo.";
  }

  function actualizarTodo() {
    actualizarContadores();
    actualizarIndice();
    actualizarGoogle();
    $("[data-prefijo-slug]").textContent = `neucast.com.mx/muebles/${form.cat.value || "…"}/${limpiarSlug(form.slug.value) || "…"}/`;
  }

  /* ============================================
     Cambios y guardado
     ============================================ */
  function marcarCambio() {
    hayCambios = true;
    $("[data-pie-estado]").textContent = "Cambios sin guardar";
    $("[data-guardar-barra]").classList.add("guardar--pendiente");
    actualizarTodo();
  }

  function cablear() {
    form.addEventListener("input", (e) => {
      marcarCambio();
      const campo = e.target.name || e.target.closest("[data-campo]")?.dataset.campo;
      if (campo && $(`[data-campo='${campo}']`)?.dataset.error) ponerError(campo, null);
    });
    form.addEventListener("change", marcarCambio);
    form.addEventListener("input", (e) => { if (e.target.matches("[data-medida]")) filtrarMedida(e.target); }, true);

    // la dirección se propone sola mientras la pieza es nueva y nadie la tocó
    let slugTocado = !!original;
    form.slug.addEventListener("input", () => (slugTocado = true));
    // "Usar el nombre" solo aparece cuando la dirección ya no es la que sale
    // del tipo y el nombre (la cambiaste a mano, o es una pieza que ya existe
    // y le cambiaste el nombre).
    const botonProponer = $("[data-proponer-slug]");
    const revisarProponer = () => {
      const propuesta = proponerSlug(form.tipo.value, form.nombre.value);
      botonProponer.hidden = !propuesta || limpiarSlug(form.slug.value) === propuesta;
      botonProponer.title = propuesta ? `Cambia la dirección a ${propuesta}` : "";
    };
    const proponer = () => {
      if (!slugTocado) form.slug.value = proponerSlug(form.tipo.value, form.nombre.value);
      revisarProponer();
    };
    form.nombre.addEventListener("input", proponer);
    form.tipo.addEventListener("input", proponer);
    form.slug.addEventListener("input", revisarProponer);
    revisarProponer();
    form.tipo.addEventListener("input", pintarSugerenciasTipo);
    botonProponer.addEventListener("click", () => {
      form.slug.value = proponerSlug(form.tipo.value, form.nombre.value);
      slugTocado = !!original; // en una pieza nueva vuelve a seguir al nombre
      revisarProponer();
      actualizarTodo();
      marcarCambio();
    });
    form.slug.addEventListener("blur", () => { form.slug.value = limpiarSlug(form.slug.value); actualizarTodo(); });
    if (original) $("[data-ayuda-slug]").textContent = "Cambiarla rompe la dirección publicada: hay que redirigir la anterior.";

    form.cat.addEventListener("change", () => {
      pieza = { ...pieza, ...leer() };
      pintarCategoria();
    });

    // validación suave al salir de un campo de texto
    for (const campo of ["nombre", "tipo", "alt", "resumen"]) {
      form[campo].addEventListener("blur", () => {
        const v = form[campo].value;
        ponerError(campo, v ? revisarTexto(v) || revisarMedida(campo, v) : null);
      });
    }

    $("[data-agregar-acabado]").addEventListener("click", () => {
      pieza.acabados = [...leerAcabados(), { nombre: "", grupo: "" }];
      pintarAcabados();
      $$("[data-acabado-nombre]").at(-1)?.focus();
    });
    $("[data-mas-medidas]").addEventListener("click", () => {
      pieza.ficha.medidas = { ...pieza.ficha.medidas, ...leerPares("medida") };
      verTodasMedidas = !verTodasMedidas;
      pintarMedidas();
    });
    $("[data-mas-construccion]").addEventListener("click", () => {
      pieza.ficha.construccion = { ...pieza.ficha.construccion, ...leerPares("construccion") };
      verTodaConstruccion = !verTodaConstruccion;
      pintarConstruccion();
    });

    // piezas que combinan
    $("[data-abre-combina]").addEventListener("click", () => {
      seleccion = [...pieza.combina];
      $("[data-combina-buscar]").value = "";
      pintarListaCombina();
      abrirModal("modal-combina");
    });
    $("[data-combina-buscar]").addEventListener("input", pintarListaCombina);
    $("[data-combina-usar]").addEventListener("click", () => {
      pieza.combina = [...seleccion];
      pintarCombina();
      marcarCambio();
      cerrarModal("modal-combina");
    });

    $("[data-guardar-borrador]").addEventListener("click", () => enviar("borrador"));
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      enviar();
    });

    // salir con cambios
    const cancelar = $("[data-cancelar]");
    let destino = cancelar.href;
    const preguntar = (e, href) => {
      if (!hayCambios) return;
      e.preventDefault();
      destino = href;
      abrirModal("modal-salir");
    };
    cancelar.addEventListener("click", (e) => preguntar(e, cancelar.href));
    $$(".bl-nav a, .barra-migas a, .barra-marca, .bl-marca, [data-sale]").forEach((a) => a.addEventListener("click", (e) => preguntar(e, a.href)));
    $("[data-salir-sin-guardar]").addEventListener("click", () => {
      hayCambios = false;
      location.href = destino;
    });
    addEventListener("beforeunload", (e) => {
      if (hayCambios && !guardando) e.preventDefault();
    });

    // el índice sigue a la sección visible: la última cuyo inicio ya pasó
    // del primer tercio de la pantalla (con secciones largas, la proporción
    // visible no sirve: la de la ficha nunca pasa del 30 por ciento)
    const secciones = $$(".seccion");
    const seguir = () => {
      const corte = innerHeight * 0.34;
      let actual = secciones[0];
      for (const sec of secciones) if (sec.getBoundingClientRect().top <= corte) actual = sec;
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) actual = secciones.at(-1);
      const indice = $(".pasos-lista");
      $$("[data-indice]").forEach((a) => {
        const es = a.dataset.indice === actual.id;
        if (es && !a.classList.contains("activo") && indice.scrollWidth > indice.clientWidth) {
          // en teléfono las pastillas se deslizan para que la activa se vea
          indice.scrollTo({ left: a.offsetLeft - 16, behavior: "smooth" });
        }
        a.classList.toggle("activo", es);
      });
    };
    addEventListener("scroll", seguir, { passive: true });
    seguir();
    $$("[data-indice]").forEach((a) =>
      a.addEventListener("click", (e) => {
        e.preventDefault();
        document.getElementById(a.dataset.indice)?.scrollIntoView({ behavior: "smooth", block: "start" });
      })
    );

    // Cmd/Ctrl + S guarda
    addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "s") {
        e.preventDefault();
        enviar();
      }
    });
  }

  async function enviar(forzarEstado) {
    if (guardando) return;
    const datos = leer();
    datos.ficha = limpiarFicha(datos.ficha);
    if (forzarEstado) datos.estado = forzarEstado;
    if (datos.estado !== "borrador") {
      const errores = validarPieza(datos, listas);
      if (Object.keys(errores).length) {
        mostrarErrores(errores);
        const n = Object.keys(errores).length;
        avisar(`Faltan ${n} ${n === 1 ? "dato" : "datos"} para publicar. Puedes guardarla como borrador.`, { tipo: "alerta" });
        return;
      }
    }
    if (!datos.nombre) {
      mostrarErrores({ nombre: "Ponle un nombre, aunque sea provisional" });
      return;
    }
    if (!datos.slug) datos.slug = proponerSlug(datos.tipo, datos.nombre) || `pieza-${Date.now()}`;

    guardando = true;
    const botones = [$("[data-guardar]"), $("[data-guardar-borrador]")];
    botones.forEach((b) => b.setAttribute("aria-busy", "true"));
    try {
      const guardada = await guardar("piezas", { ...datos, _original: original });
      pieza = { ...piezaVacia(), ...guardada };
      pieza.ficha = { ...piezaVacia().ficha, ...(pieza.ficha || {}) };
      pieza.acabados = acabadosDe(pieza);
      hayCambios = false;
      limpiarErrores();
      $("[data-guardar-barra]").classList.remove("guardar--pendiente");
      $("[data-pie-estado]").textContent = pieza.estado === "publicada" ? "Guardada · ya está en pruebas" : "Guardada como borrador";
      avisar(pieza.estado === "publicada" ? `${pieza.nombre} se guardó y ya está en pruebas` : `${pieza.nombre} se guardó como borrador`);
      dispatchEvent(new CustomEvent("neucast:guardado"));
      if (original !== pieza.slug) {
        original = pieza.slug;
        history.replaceState(null, "", `${base}piezas/editar/?slug=${encodeURIComponent(pieza.slug)}`);
      }
      todas = await listar("piezas");
      pintar();
    } catch (err) {
      if (err.campos && Object.keys(err.campos).length) mostrarErrores(err.campos);
      avisar(err.message || "No se pudo guardar", { tipo: "error" });
    } finally {
      guardando = false;
      botones.forEach((b) => b.removeAttribute("aria-busy"));
    }
  }

  cargar().catch((e) => {
    console.error(e);
    avisar(e.message || "No se pudo cargar la pieza", { tipo: "error" });
  });
</script>
