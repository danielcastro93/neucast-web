---
// El molde de todas las pantallas del administrador (menos la de entrar).
//
// Pone la barra lateral (la misma pieza que Capital Trip: grupos plegables,
// orillas difuminadas, la bolita para hacerla angosta, globos con el nombre
// y la cuenta abajo), la barra superior con el estado de publicación, los
// dos modales que existen en todas las pantallas (confirmar y publicar) y
// exige sesión antes de pintar nada.
import "@neucast/compartido/styles/global.css";
import "../styles/admin.css";
import "../styles/barra-lateral.css";
import "../styles/componentes.css";
import Logo from "@neucast/compartido/components/Logo.astro";
import IconoAdmin from "../components/IconoAdmin.astro";
import Modal from "../components/Modal.astro";

// publicarAbajo: en el teléfono, el botón de publicar va en una barra al pie.
// Las pantallas que ya tienen su propio pie fijo (editar una pieza) lo apagan.
const { titulo, seccion = "", migas = [], angosto = false, publicarAbajo = true } = Astro.props;
const base = import.meta.env.BASE_URL;

// Inicio va suelto arriba; lo demás, en grupos que se pliegan.
const inicio = { id: "inicio", nombre: "Inicio", icono: "inicio", ruta: "inicio/" };
const grupos = [
  {
    rotulo: "Contenido",
    items: [
      { id: "piezas", nombre: "Piezas", icono: "piezas", ruta: "piezas/", punto: "borradores" },
      { id: "categorias", nombre: "Categorías", icono: "categorias", ruta: "categorias/" },
      { id: "proyectos", nombre: "Proyectos", icono: "proyectos", ruta: "proyectos/" },
      { id: "home-office", nombre: "Home office", icono: "casa", ruta: "home-office/" },
    ],
  },
  {
    rotulo: "Sitio",
    items: [
      { id: "paginas", nombre: "Páginas", icono: "paginas", ruta: "paginas/" },
      { id: "legales", nombre: "Legales", icono: "legal", ruta: "legales/" },
      { id: "listas", nombre: "Listas", icono: "listas", ruta: "listas/" },
    ],
  },
  {
    rotulo: "Seguimiento",
    items: [
      { id: "metricas", nombre: "Métricas", icono: "metricas", ruta: "metricas/" },
      { id: "reportes", nombre: "Reportes", icono: "descargar", ruta: "reportes/" },
    ],
  },
  {
    rotulo: "Sistema",
    items: [
      { id: "ajustes", nombre: "Ajustes", icono: "ajustes", ruta: "ajustes/" },
      { id: "usuarios", nombre: "Usuarios", icono: "usuarios", ruta: "usuarios/" },
    ],
  },
];

// El símbolo de la marca (el arco y el punto), para la barra angosta y la
// cabecera de la barra. Mismo trazo que Logo.astro.
const simbolo = "M625.9,655.2c-3.1,3.1-6.5,5.5-10.2,7.4-3.8,1.9-7.8,2.8-12.3,2.8s-8.7-1.4-11.8-4.1c-3.1-2.7-5.5-7.5-7.2-14.2l-9.2-35.1c-5.8-22.4-14.4-39.6-25.8-51.7-11.4-12-26.4-18.1-44.8-18.1s-30.5,5.9-42.2,17.6-17.7,29.9-17.7,54.7,2.1,27.2,6.4,41c4.3,13.7,9.8,24.7,16.6,32.8-2.7,3.7-6,6.6-9.7,8.7-3.7,2-7.8,3.1-12.3,3.1-9.9,0-18.6-8.1-26.1-24.4-7.5-16.3-11.3-37.1-11.3-62.6s4.1-42.1,12.3-59c8.2-17,19.4-30.2,33.8-39.7,14.3-9.5,30.9-14.3,49.6-14.3,28.7,0,51.9,8.7,69.6,26.2,17.7,17.5,31.1,43.9,39.9,79.1l12.3,49.9ZM676.3,660.8c-8.2,0-15.1-2.6-20.7-7.9-5.6-5.3-8.4-12.1-8.4-20.6s2.8-15.9,8.4-21.1c5.6-5.3,12.5-7.9,20.7-7.9s15,2.6,20.5,7.9c5.5,5.3,8.2,12.3,8.2,21.1s-2.7,15.4-8.2,20.6c-5.5,5.3-12.3,7.9-20.5,7.9Z";
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Administrador de Neucast</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <!-- Antes de pintar: el estado de la barra lateral, para que no parpadee. -->
    <script is:inline>
      try {
        if (localStorage.getItem("neucast-admin:sb") === "plegada") document.documentElement.dataset.sb = "plegada";
        if (localStorage.getItem("neucast-admin:bl") === "oscura") document.documentElement.dataset.bl = "oscura";
        // Sin sesión no se pinta nada: a entrar, y de regreso a esta pantalla.
        if (!sessionStorage.getItem("neucast-admin:sesion")) {
          location.replace("/?a=" + encodeURIComponent(location.pathname + location.search));
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="app">
      <div class="bl-fondo" data-cierra-cajon></div>
      <aside class="bl" id="barra-lateral" aria-label="Navegación del administrador">
        <a class="bl-marca" href={`${base}inicio/`} aria-label="Neucast · Panel de administración">
          <span class="bl-simbolo" aria-hidden="true">
            <svg viewBox="380 500 330 205" fill="var(--olive)"><path d={simbolo} /></svg>
          </span>
          <span class="bl-marca-txt">
            <strong>Neucast</strong>
            <small>Panel de administración</small>
          </span>
        </a>

        <nav class="bl-nav" aria-label="Secciones del administrador" data-nav>
          <div class="bl-grupo">
            <div class="bl-items"><div class="bl-items-in">
              <a href={`${base}${inicio.ruta}`} aria-current={seccion === inicio.id ? "page" : undefined} data-globo={inicio.nombre} data-globo-solo="angosta">
                <IconoAdmin name={inicio.icono} /><span class="et">{inicio.nombre}</span>
              </a>
            </div></div>
          </div>
          {grupos.map((g, i) => (
            <div class="bl-grupo">
              <button class="bl-grupo-h" type="button" data-grupo={g.rotulo} aria-expanded="true" aria-controls={`grupo-${i}`}>
                <span>{g.rotulo}</span>
                <IconoAdmin name="chevronAbajo" size={16} />
              </button>
              <div class="bl-items" id={`grupo-${i}`} data-tiene-activa={g.items.some((x) => x.id === seccion) ? "1" : undefined}><div class="bl-items-in">
                {g.items.map((it) => (
                  <a href={`${base}${it.ruta}`} aria-current={it.id === seccion ? "page" : undefined} data-globo={it.nombre} data-globo-solo="angosta">
                    <IconoAdmin name={it.icono} /><span class="et">{it.nombre}</span>
                    {it.punto && <span class="bl-punto" data-punto={it.punto} hidden></span>}
                  </a>
                ))}
              </div></div>
            </div>
          ))}
        </nav>

        <div class="bl-pie" data-pie>
          <button class="bl-usuario" type="button" data-cuenta aria-haspopup="menu" aria-expanded="false" aria-controls="ventana-cuenta" data-globo="Tu cuenta" data-globo-solo="angosta">
            <span class="avatar" aria-hidden="true" data-avatar></span>
            <span class="bl-usuario-txt">
              <strong data-cuenta-nombre></strong>
              <small data-cuenta-correo></small>
            </span>
          </button>
          <div class="bl-cuenta" id="ventana-cuenta" role="menu" data-ventana-cuenta hidden>
            <div class="bl-cuenta-cabeza">
              <span class="bl-cuenta-quien">
                <strong data-cuenta-nombre></strong>
                <small data-cuenta-correo></small>
              </span>
              <button class="bl-salir" type="button" data-salir aria-label="Cerrar sesión" data-globo="Cerrar sesión" data-globo-lado="arriba">
                <IconoAdmin name="salir" size={19} />
              </button>
            </div>
            <div class="bl-cuenta-menu">
              <a role="menuitem" href={`${base}ajustes/`}><IconoAdmin name="ajustes" size={19} /><span>Ajustes</span></a>
              <button role="menuitem" type="button" data-ver-stg><IconoAdmin name="externo" size={19} /><span>Ver el sitio de pruebas</span></button>
              <button role="menuitem" type="button" data-tema-barra><IconoAdmin name="tema" size={19} /><span data-tema-barra-texto>Barra oscura</span></button>
              <button role="menuitem" type="button" data-restablecer hidden><IconoAdmin name="refrescar" size={19} /><span>Restablecer la simulación</span></button>
            </div>
          </div>
        </div>

        <button class="bl-colapsar" type="button" data-colapsar>
          <IconoAdmin name="chevronIzq" size={15} />
        </button>
      </aside>

      <div class="principal">
        <header class="barra" data-barra>
          <button class="boton boton--icono boton--texto barra-menu" type="button" data-abre-cajon aria-label="Abrir el menú" aria-expanded="false" aria-controls="barra-lateral">
            <IconoAdmin name="menu" />
          </button>
          <span class="barra-linea" aria-hidden="true"></span>
          <a class="barra-marca" href={`${base}inicio/`} aria-label="Ir al inicio"><Logo height={22} /></a>
          <nav class="barra-migas" aria-label="Ubicación">
            {migas.map((m) => (
              <>
                <a href={`${base}${m.ruta}`}>{m.nombre}</a>
                <IconoAdmin name="chevron" size={14} />
              </>
            ))}
            <strong data-miga-actual>{titulo}</strong>
          </nav>
          <div class="barra-derecha">
            <div class="publicacion" data-publicacion data-estado="aldia">
              <span class="publicacion-punto"></span>
              <span class="publicacion-texto" data-publicacion-texto>Todo publicado</span>
              <button class="boton boton--primario" type="button" data-abre-modal="modal-publicar">Publicar</button>
            </div>
          </div>
        </header>

        <main class:list={["contenido", { "contenido--angosto": angosto }]}>
          <slot />
        </main>
        {publicarAbajo && (
          <div class="publicar-movil" data-publicar-movil hidden>
            <span class="publicar-movil-estado"><span class="pulso"></span><span data-publicar-movil-texto></span></span>
            <button class="boton boton--primario boton--grande" type="button" data-abre-modal="modal-publicar">Publicar</button>
          </div>
        )}
      </div>
    </div>

    <Modal id="modal-confirmar" titulo="¿Seguro?" texto="">
      <Fragment slot="pie">
        <button class="boton" type="button" data-cierra-modal>Cancelar</button>
        <button class="boton boton--primario" type="button" data-confirma>Confirmar</button>
      </Fragment>
    </Modal>

    <Modal id="modal-publicar" titulo="Publicar en neucast.com.mx">
      <Fragment slot="texto">Lo que está en pruebas pasa al sitio público. Si la revisión encuentra un problema, no se publica nada.</Fragment>
      <div class="publicar-cuerpo" data-publicar-cuerpo>
        <ul class="lista-filas lista-filas--compacta" data-publicar-lista></ul>
        <p class="t-mini" data-publicar-nota></p>
      </div>
      <ol class="pasos" data-pasos hidden>
        {["Compilando el sitio", "Generando fichas y catálogos en PDF", "Revisando enlaces, textos y mapa del sitio", "Subiendo a neucast.com.mx"].map((p) => (
          <li class="paso"><span class="paso-marca"><span class="paso-giro"></span><IconoAdmin name="check" size={14} /></span><span>{p}</span></li>
        ))}
      </ol>
      <div class="publicado" data-publicado hidden>
        <span class="publicado-marca"><IconoAdmin name="check" size={28} /></span>
        <strong>Publicado</strong>
        <span class="t-apoyo">neucast.com.mx ya tiene los cambios.</span>
      </div>
      <Fragment slot="pie">
        <span class="izquierda t-mini" data-publicar-ultima></span>
        <button class="boton" type="button" data-cierra-modal data-publicar-cancelar>Todavía no</button>
        <button class="boton boton--primario" type="button" data-publicar-ahora>
          <IconoAdmin name="cohete" size={16} />Publicar ahora
        </button>
      </Fragment>
    </Modal>

    <script>
      import { exigirSesion, cerrarSesion } from "../scripts/sesion.js";
      import { listar, esSimulada } from "../scripts/api.js";
      import { restablecer } from "../scripts/api-simulada.js";
      import { estado, filaCambio, correrPublicacion } from "../scripts/publicacion.js";
      import { vigilarDesplegables } from "../scripts/desplegable.js";
      import { cablearModales, cerrarModal, confirmar, avisar, fechaRelativa, escapar, activarGlobos, ocultarGlobo, ESCRITORIO } from "../scripts/ui.js";

      const sesion = exigirSesion();
      const base = import.meta.env.BASE_URL;
      const html = document.documentElement;
      const $ = (s) => document.querySelector(s);

      /* ---------- Cuenta ---------- */
      if (sesion) {
        $("[data-avatar]").textContent = (sesion.nombre || "?").trim()[0].toUpperCase();
        document.querySelectorAll("[data-cuenta-nombre]").forEach((e) => (e.textContent = sesion.nombre));
        document.querySelectorAll("[data-cuenta-correo]").forEach((e) => {
          e.textContent = sesion.correo;
          e.title = sesion.correo;
        });
      }

      // La ventana de la cuenta: anclada al botón, no un modal. Cierra con
      // otro clic, fuera de ella o con Escape.
      const botonCuenta = $("[data-cuenta]");
      const ventana = $("[data-ventana-cuenta]");
      const abrirCuenta = () => {
        ventana.hidden = false;
        botonCuenta.setAttribute("aria-expanded", "true");
        requestAnimationFrame(() => ventana.classList.add("visible"));
      };
      const cerrarCuenta = () => {
        if (ventana.hidden) return;
        ventana.classList.remove("visible");
        botonCuenta.setAttribute("aria-expanded", "false");
        setTimeout(() => { if (!ventana.classList.contains("visible")) ventana.hidden = true; }, 170);
      };
      botonCuenta.addEventListener("click", (e) => {
        e.stopPropagation();
        ventana.hidden ? abrirCuenta() : cerrarCuenta();
      });
      ventana.addEventListener("click", (e) => e.stopPropagation());
      document.addEventListener("click", cerrarCuenta);
      $("[data-salir]").addEventListener("click", () => {
        cerrarSesion();
        location.href = base;
      });
      $("[data-ver-stg]").addEventListener("click", () => {
        cerrarCuenta();
        window.open(import.meta.env.PUBLIC_STG || "http://localhost:4321/", "_blank", "noopener");
      });

      /* ---------- Tema de la barra: clara u oscura ---------- */
      const temaBtn = $("[data-tema-barra]");
      const rotularTema = () => {
        $("[data-tema-barra-texto]").textContent = html.dataset.bl === "oscura" ? "Barra clara" : "Barra oscura";
      };
      rotularTema();
      temaBtn.addEventListener("click", () => {
        const oscura = html.dataset.bl !== "oscura";
        if (oscura) html.dataset.bl = "oscura";
        else delete html.dataset.bl;
        try { localStorage.setItem("neucast-admin:bl", oscura ? "oscura" : "clara"); } catch {}
        rotularTema();
      });

      /* ---------- Ancha o angosta ----------
         Lo decide quien la usa y se recuerda. El estado ya lo puso el script
         de la cabeza antes de pintar, para que no parpadee. */
      const colapsar = $("[data-colapsar]");
      const rotularColapsar = () => {
        const angosta = html.dataset.sb === "plegada";
        colapsar.dataset.globo = angosta ? "Expandir la barra" : "Colapsar la barra";
        colapsar.setAttribute("aria-label", colapsar.dataset.globo);
        colapsar.setAttribute("aria-expanded", String(!angosta));
      };
      rotularColapsar();
      colapsar.addEventListener("click", () => {
        const angosta = html.dataset.sb !== "plegada";
        if (angosta) html.dataset.sb = "plegada";
        else delete html.dataset.sb;
        try { localStorage.setItem("neucast-admin:sb", angosta ? "plegada" : "ancha"); } catch {}
        rotularColapsar();
        ocultarGlobo();
        cerrarCuenta();
      });

      /* ---------- Grupos que se pliegan ----------
         Se recuerda cuáles dejó cerrados. El de la sección abierta se fuerza
         abierto: si no, entras a Listas y no ves dónde estás parado. */
      let cerrados = new Set();
      try { cerrados = new Set(JSON.parse(localStorage.getItem("neucast-admin:grupos") || "[]")); } catch {}
      document.querySelectorAll("[data-grupo]").forEach((b) => {
        const caja = document.getElementById(b.getAttribute("aria-controls"));
        const abierto = !!caja.dataset.tieneActiva || !cerrados.has(b.dataset.grupo);
        b.setAttribute("aria-expanded", String(abierto));
        caja.classList.toggle("plegado", !abierto);
        b.addEventListener("click", () => {
          const estaba = b.getAttribute("aria-expanded") === "true";
          b.setAttribute("aria-expanded", String(!estaba));
          caja.classList.toggle("plegado", estaba);
          estaba ? cerrados.add(b.dataset.grupo) : cerrados.delete(b.dataset.grupo);
          try { localStorage.setItem("neucast-admin:grupos", JSON.stringify([...cerrados])); } catch {}
        });
      });

      /* ---------- Orillas difuminadas ----------
         Sustituyen a la barra de desplazamiento: el menú se desvanece del
         lado donde todavía queda algo por ver. */
      const nav = $("[data-nav]");
      const revisarOrillas = () => {
        const sobra = nav.scrollHeight - nav.clientHeight;
        nav.classList.toggle("hay-arriba", nav.scrollTop > 4);
        nav.classList.toggle("hay-abajo", sobra > 4 && nav.scrollTop < sobra - 4);
      };
      nav.addEventListener("scroll", revisarOrillas, { passive: true });
      new ResizeObserver(revisarOrillas).observe(nav);
      new MutationObserver(revisarOrillas).observe(nav, { subtree: true, attributes: true, attributeFilter: ["class", "hidden"] });
      revisarOrillas();
      // si la sección activa quedó fuera de la vista, se trae
      const activa = nav.querySelector('[aria-current="page"]');
      if (activa) requestAnimationFrame(() => activa.scrollIntoView({ block: "nearest" }));

      /* ---------- El cajón (tableta y teléfono) ---------- */
      const abreCajon = $("[data-abre-cajon]");
      const abrirCajon = () => {
        html.dataset.cajon = "abierto";
        abreCajon.setAttribute("aria-expanded", "true");
        $(".bl a, .bl button")?.focus({ preventScroll: true });
      };
      const cerrarCajon = () => {
        if (html.dataset.cajon !== "abierto") return;
        delete html.dataset.cajon;
        abreCajon.setAttribute("aria-expanded", "false");
      };
      abreCajon.addEventListener("click", abrirCajon);
      $("[data-cierra-cajon]").addEventListener("click", cerrarCajon);
      nav.querySelectorAll("a").forEach((a) => a.addEventListener("click", cerrarCajon));
      matchMedia(ESCRITORIO).addEventListener("change", cerrarCajon);
      addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        cerrarCuenta();
        cerrarCajon();
      });

      activarGlobos(document);
      vigilarDesplegables();

      /* ---------- Desplegables de las pantallas (menús de fila) ---------- */
      document.querySelectorAll("[data-desplegable]").forEach((d) => {
        const b = d.querySelector("[data-desplegable-boton]");
        if (!b || d.dataset.listo) return;
        d.dataset.listo = "1";
        const alternar = (abrir) => {
          d.classList.toggle("abierto", abrir);
          b.setAttribute("aria-expanded", String(abrir));
        };
        b.addEventListener("click", (e) => {
          e.stopPropagation();
          alternar(!d.classList.contains("abierto"));
        });
        document.addEventListener("click", (e) => {
          if (!d.contains(e.target)) alternar(false);
        });
        addEventListener("keydown", (e) => e.key === "Escape" && alternar(false));
      });

      /* ---------- La línea de la barra superior aparece con el scroll ---------- */
      const barra = $("[data-barra]");
      const marcarScroll = () => barra.classList.toggle("con-scroll", scrollY > 8);
      addEventListener("scroll", marcarScroll, { passive: true });
      marcarScroll();

      /* ---------- Pendientes en la barra ----------
         Solo cuenta lo que pide una acción: los borradores por terminar. */
      async function pintarPuntos() {
        try {
          const piezas = await listar("piezas");
          const n = piezas.filter((p) => p.estado !== "publicada").length;
          document.querySelectorAll('[data-punto="borradores"]').forEach((el) => {
            el.textContent = n;
            el.hidden = !n;
          });
        } catch {}
      }
      pintarPuntos();
      addEventListener("neucast:guardado", pintarPuntos);

      /* ---------- Estado de publicación ---------- */
      cablearModales();
      const chip = $("[data-publicacion]");
      const texto = $("[data-publicacion-texto]");
      const lista = $("[data-publicar-lista]");
      const nota = $("[data-publicar-nota]");
      const ultima = $("[data-publicar-ultima]");
      const btnPublicar = $("[data-publicar-ahora]");
      const cancelar = $("[data-publicar-cancelar]");
      const cuerpoPublicar = $("[data-publicar-cuerpo]");
      const pasos = $("[data-pasos]");
      const publicado = $("[data-publicado]");
      const movil = $("[data-publicar-movil]");
      const movilTexto = $("[data-publicar-movil-texto]");
      const modalPublicar = $("#modal-publicar");
      let publicando = false;

      async function pintarPublicacion() {
        try {
          const p = await estado();
          const n = p.pendientes.length;
          const cambios = `${n} ${n === 1 ? "cambio" : "cambios"}`;
          chip.dataset.estado = n ? "pendiente" : "aldia";
          texto.innerHTML = n ? `<b>${cambios}</b> en pruebas` : `Publicado ${escapar(fechaRelativa(p.produccion?.fecha))}`;
          ultima.textContent = `Última publicación ${fechaRelativa(p.produccion?.fecha)}`;
          lista.innerHTML = p.pendientes.map((c) => filaCambio(c, p.porSlug)).join("");
          nota.textContent = n ? "" : "No hay cambios pendientes: producción ya tiene lo mismo que pruebas.";
          nota.hidden = !!n;
          btnPublicar.disabled = !n;
          if (movil) {
            movil.hidden = !n;
            movilTexto.textContent = `${cambios} en pruebas`;
            document.body.classList.toggle("con-publicar-movil", !!n);
          }
        } catch {
          /* sin estado: la barra se queda como está */
        }
      }
      pintarPublicacion();
      addEventListener("neucast:guardado", pintarPublicacion);

      // Al abrir, siempre la vista de lista; los pasos son solo mientras publica.
      const vistaLista = () => {
        cuerpoPublicar.hidden = false;
        pasos.hidden = true;
        publicado.hidden = true;
        btnPublicar.hidden = false;
        cancelar.hidden = false;
        ultima.hidden = false;
        pasos.querySelectorAll(".paso").forEach((li) => li.removeAttribute("data-estado"));
      };
      modalPublicar.addEventListener("close", () => { if (!publicando) vistaLista(); });

      btnPublicar.addEventListener("click", async () => {
        publicando = true;
        cuerpoPublicar.hidden = true;
        pasos.hidden = false;
        btnPublicar.hidden = true;
        cancelar.hidden = true;
        ultima.hidden = true;
        const items = [...pasos.querySelectorAll(".paso")];
        try {
          await correrPublicacion((i) => {
            items.forEach((li, j) => (li.dataset.estado = j < i ? "hecho" : j === i ? "corriendo" : ""));
          });
          pasos.hidden = true;
          publicado.hidden = false;
          await pintarPublicacion();
          setTimeout(() => {
            publicando = false;
            cerrarModal("modal-publicar");
            avisar("Publicado en neucast.com.mx");
          }, 1300);
        } catch (e) {
          publicando = false;
          vistaLista();
          avisar(e.message || "No se pudo publicar", { tipo: "error" });
        }
      });

      /* ---------- La simulación ---------- */
      if (esSimulada) {
        const restablecerBtn = $("[data-restablecer]");
        restablecerBtn.hidden = false;
        restablecerBtn.addEventListener("click", async () => {
          cerrarCuenta();
          const ok = await confirmar({
            titulo: "Restablecer la simulación",
            texto: "Se borra lo que capturaste en este navegador y vuelven los datos del prototipo. El sitio no se toca.",
            accion: "Restablecer",
            peligro: true,
          });
          if (!ok) return;
          restablecer();
          avisar("La simulación volvió a los datos del prototipo");
          setTimeout(() => location.reload(), 500);
        });
      }
    </script>
  </body>
</html>
